{
  "buildCommand": "NODE_OPTIONS='--max-old-space-size=4096' npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "functions": {
    "pages/api/*": {
      "maxDuration": 10
    }
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  }
}