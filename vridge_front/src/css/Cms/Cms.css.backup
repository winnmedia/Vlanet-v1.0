}
.cms_wrap main .content.calendar .filter .date .move span.prev::before {
  content: "";
  width: 0;
  height: 0;
  border-top: calc($spacing-xs + 2px) solid transparent;
  border-bottom: calc($spacing-xs + 2px) solid transparent;
  border-right: $spacing-sm solid #495057;
