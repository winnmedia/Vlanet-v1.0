// Source: FeedbackPage.scss
.feedback-input-section {
  border-top: $spacing-2xs solid $color-gray-300;
  padding: $spacing-lg - $spacing-xs;
  background: $color-white;
  
  .feedback-input-wrapper {
    display: flex;
    gap: $spacing-md - $spacing-2xs;
    align-items: flex-end;
    
    .input-group {
      flex: 1;
      
      .time-input {
        display: flex;
        align-items: center;
        gap: $spacing-sm + $spacing-2xs;
        margin-bottom: $spacing-sm + $spacing-2xs;
        
        label {
          font-size: $font-size-sm;
          color: $color-gray-600;
        }
        
        input {
          width: $spacing-6xl + $spacing-xs;
          padding: $spacing-xs $spacing-sm + $spacing-2xs;
          border: $spacing-2xs solid $color-gray-300;
          border-radius: $border-radius-sm;
          font-size: $font-size-sm;
        }
        
        button {
          padding: $spacing-xs $spacing-sm + $spacing-2xs;
          background: $color-gray-200;
          border: $spacing-2xs solid $color-gray-300;
          border-radius: $border-radius-sm;
          cursor: pointer;
          font-size: $font-size-xs;
          
          &:hover {
            background: $color-gray-300;
          }
        }
      }
      
      textarea {
        width: 100%;
        min-height: $spacing-4xl - $spacing-xs;
        padding: $spacing-sm + $spacing-2xs;
        border: $spacing-2xs solid $color-gray-300;
        border-radius: $border-radius-sm;
        resize: vertical;
        font-family: inherit;
        font-size: $font-size-sm;
        
        &:focus {
          outline: none;
          border-color: $color-primary;
        }
      }
    }
    
    .submit-button {
      padding: $spacing-sm + $spacing-2xs $spacing-lg - $spacing-xs;
      background: linear-gradient(to bottom, $color-primary, $color-primary-dark);
      color: $color-white;
      border: none;
      border-radius: $border-radius-sm;
      cursor: pointer;
      font-weight: 500;
      $color-white-space: nowrap;
      
      &:hover {
        transform: translateY(-$spacing-2xs);
        box-shadow: $shadow-sm;
      }
      
      &:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
    }
  }
}

