# VideoPlanet 프론트엔드 환경변수 설정
# 이 파일을 .env.local로 복사하여 사용하세요

# ===== 필수 설정 =====
# API 설정
NEXT_PUBLIC_API_URL=https://videoplanet.up.railway.app
NEXT_PUBLIC_WS_URL=wss://videoplanet.up.railway.app
NEXT_PUBLIC_FRONTEND_URL=https://www.vlanet.net

# 앱 정보
NEXT_PUBLIC_APP_NAME=VideoPlanet
NEXT_PUBLIC_APP_VERSION=1.0.16
NEXT_PUBLIC_ENVIRONMENT=production

# ===== OAuth 설정 (선택사항) =====
# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Kakao OAuth
NEXT_PUBLIC_KAKAO_CLIENT_ID=your_kakao_client_id_here

# ===== 기능 플래그 =====
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_FEATURE_FLAGS_ENABLED=false

# ===== 모니터링 (선택사항) =====
# Sentry
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=videoplanet-frontend
SENTRY_ENVIRONMENT=production

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# Monitoring
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=your_datadog_token
NEXT_PUBLIC_DATADOG_APPLICATION_ID=your_datadog_app_id

# ===== CI/CD 설정 (GitHub Actions용) =====
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_org_id_here
VERCEL_PROJECT_ID=your_project_id_here

# ===== 개발 환경 설정 =====
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1