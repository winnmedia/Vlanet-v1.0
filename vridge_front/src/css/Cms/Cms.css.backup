  font-size: 22px;
}
.cms_wrap main .content.home .part ul.schedule li span {
  font-weight: bold;
  font-size: 50px;
}
.cms_wrap main .content.home .part ul.schedule li:first-child {
  background: #0131ff;
}
.cms_wrap main .content.home .part ul.oc {
  display: grid;
  $spacing-0dcalc($spacing-md + $spacing-xs)acing-0:calc($spacing-md + $spacing-xs) 20px;
  grid-template-columns: repeat(3, 1fr);
}
.cms_wrap main .content.home .part ul.oc li {
  height: 340px;
  calc($spacing-lg + 6px)ing: 30px;
  color: $color-white;
  font-size: calc($spacing-lg + 6px);
  background: $color-gray-400;
  border-radius: 25px;
  font-weight: bold;
}
.cms_wrap main .content.home .part ul.oc li span {
  font-weight: normal;
  display: block;
  font-size: calc($spacing-md + 2px);
  margicalc($spacing-sm + 2px)p: 10px;
}
.cms_wrap main .content.calendar .title {
  font-size: calc($spacing-md + $spacing-xs);
  font-weight: 700;
  color: #212529;
  margin-b$spacing-lgm: 24px;
  display: flex;
  align-items: center;
  calc($spacing-sm + $spacing-xs) 12px;
}
.cms_wrap main .content.calendar .title .collapse-btn {
  width: $spacing-lg;
  height: $spacing-lg;
  background: #f8f9fa;
  border: $border-width-thin solid #dee2e6;
  border-radius: $border-radius-sm;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
}
.cms_wrap main .content.calendar .title .collapse-btn::after {
  content: "";
  width: 0;
  height: 0;
  border-left: calc($spacing-xs + 1px) solid transparent;
  border-right: calc($spacing-xs + 1px) solid transparent;
  border-top: calc($spacing-xs + 2px) solid #495057;
  transition: transform 0.3s ease;
}
.cms_wrap main .content.calendar .title .collapse-btn:hover {
  background: #e9ecef;
  border-color: #adb5bd;
}
.cms_wrap main .content.calendar .title .collapse-btn.collapsed::after {
  transform: rotate(180deg);
}
.cms_wrap main .content.calendar .filter {
  background: $color-white;
  calc($spacing-md + $spacing-xs)ing: 20px;
  border-radius: $border-radius-lg;
  box-shadow: 0 1px 3px rgba($color-black, $1);
  border: $border-width-thin solid #e9ecef;
  margin-b$spacing-lgm: 24px;
}
.cms_wrap main .content.calendar .filter.flex {
