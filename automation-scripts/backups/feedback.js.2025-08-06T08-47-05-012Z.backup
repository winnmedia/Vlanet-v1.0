  });
}

// 피드백 생성
export function CreateFeedback(data, projectId) {
  console.log('CreateFeedback API called with:', {
    method: 'POST',
    url: `/api/projects/${projectId}/feedbacks/`,
    data: data
  });
  
  return axiosCredentials(
    'post',
    `/api/projects/${projectId}/feedbacks/`,
    data,
  ).then(response => {
    console.log('CreateFeedback API success:', response);
    return response;
  }).catch(error => {
    console.error('CreateFeedback API error:', error);
    handleApiError(error, {
      400: '필수 필드가 누락되었습니다.',
      403: '피드백을 생성할 권한이 없습니다.',
      404: '프로젝트를 찾을 수 없습니다.'
    });
    throw error;
  });
}

// 피드백 수정
