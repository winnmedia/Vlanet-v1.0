# VideoPlanet 배포 환경 변수

# Vercel
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# Railway
RAILWAY_TOKEN_PRODUCTION=your_railway_production_token
RAILWAY_TOKEN_STAGING=your_railway_staging_token

# Sentry
SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=videoplanet

# Monitoring & Alerting
SLACK_WEBHOOK_URL=your_slack_webhook_url
DISCORD_WEBHOOK_URL=your_discord_webhook_url
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# Database
DATABASE_URL=postgresql://user:pass@host:5432/videoplanet

# Admin Token (for API calls)
ADMIN_TOKEN=your_admin_api_token

# Feature Flags
SPLIT_API_KEY=your_split_api_key
LAUNCHDARKLY_SDK_KEY=your_launchdarkly_key

# Analytics
GA_MEASUREMENT_ID=your_ga_measurement_id
MIXPANEL_TOKEN=your_mixpanel_token

# SMS Alerts (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=VideoPlanet Monitoring <monitoring@vlanet.net>