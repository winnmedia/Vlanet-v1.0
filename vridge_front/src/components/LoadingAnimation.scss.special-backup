@import '../styles/design-tokens';

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes dot-flashing {
  0% {
    background-color: #cbd5e1;
    transform: scale(0.8);
  }
  50%,
  100% {
    background-color: #3b82f6;
    transform: scale(1);
  }
}

@keyframes dot-middle {
  0%,
  100% {
    background-color: #cbd5e1;
    transform: scale(0.8);
  }
  50% {
    background-color: #3b82f6;
    transform: scale(1);
  }
}

@keyframes dot-last {
  0% {
    background-color: #cbd5e1;
    transform: scale(0.8);
  }
  25% {
    background-color: #cbd5e1;
    transform: scale(0.8);
  }
  75%,
  100% {
    background-color: #3b82f6;
    transform: scale(1);
  }
}

@keyframes messageChange {
  0%, 90% {
    opacity: 1;
  }
  95%, 100% {
    opacity: 0;
  }
}

.loading-overlay {
  position: fixed;
  top: $spacing-0;
  left: $spacing-0;
  right: $spacing-0;
  bottom: $spacing-0;
  background: rgba(248, 250, 252, 0.8);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9$color-gray-500;
  animation: fadeIn 0.3s ease-out;
}

.loading-box {
  background: white;
  border-radius: $border-radius-xl;
  padding: $spacing-xl 48px;
  box-shadow: 
    $shadow-md,
    0 2px 4px -1px rgba($color-black, 0.06),
    0 0 0 1px rgba($color-black, 0.05);
  min-width: 320px;
  text-align: center;
}

.loading-dots-container {
  margin-bottom: $spacing-lg;
}

.loading-dots {
  display: inline-flex;
  gap: $spacing-sm;
  
  .dot {
    width: $spacing-sm + 2px;
    height: $spacing-sm + 2px;
    border-radius: $border-radius-full;
    background-color: #cbd5e1;
    animation: dot-flashing 1.4s infinite linear;
    
    &:nth-child(2) {
      animation: dot-middle 1.4s infinite linear;
      animation-delay: 0.2s;
    }
    
    &:nth-child(3) {
      animation: dot-last 1.4s infinite linear;
      animation-delay: 0.4s;
    }
  }
}

.loading-text {
  margin-bottom: $spacing-lg - $spacing-xs;
}

.humorous-message {
  font-size: $font-size-sm;
  color: #64748b;
  font-weight: 400;
  margin-bottom: $spacing-sm;
  height: $spacing-lg - $spacing-xs;
  display: flex;
  align-items: center;
  justify-content: center;
  font-style: italic;
  transition: all 0.3s ease;
}

.loading-message {
  font-size: $font-size-base;
  color: #1e293b;
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1.5;
}

.loading-progress {
  width: 100%;
  max-width: 240px;
  margin: $spacing-0 auto;
  
  .progress-track {
    height: 3px;
    background: $color-gray-300;
    border-radius: 100px;
    overflow: hidden;
    position: relative;
  }
  
  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%);
    transition: width $duration-slower cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 100px;
    position: relative;
    
    &::after {
      content: '';
      position: absolute;
      top: -1px;
      right: -1px;
      width: $spacing-xs;
      height: $spacing-xs;
      background: #2563eb;
      border-radius: $border-radius-full;
      box-shadow: 0 0 6px rgba(37, 99, 235, 0.6);
    }
  }
}