// Source: FeedbackPlayer.scss
.tooltip {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: rgba($color-gray-900, 0.95);
  color: $color-white;
  padding: $spacing-sm - $spacing-2xs $spacing-sm + $spacing-xs;
  border-radius: $border-radius-md - $border-radius-sm / 2;
  font-size: $font-size-xs;
  $color-white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s, transform 0.2s;
  margin-bottom: $spacing-sm;
  backdrop-filter: blur($font-size-xs);
  border: $spacing-2xs solid rgba($color-white, 0.1);
  
  &::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: $spacing-sm solid transparent;
    border-top-color: rgba($color-gray-900, 0.95);
  }
}

// Source: FeedbackButtons.scss
.upload-guide-button {
  padding: $spacing-md $spacing-xl;
  background: linear-gradient(135deg, $color-gray-600 0%, $color-gray-600 100%);
  color: $color-white;
  border: none;
  border-radius: $border-radius-lg - $border-radius-sm / 2;
  font-size: $font-size-base;
  font-weight: 600;
  cursor: pointer;
  transition: $transition-base;
  box-shadow: $shadow;
  
  &:hover {
    transform: translateY(-$spacing-2xs);
    box-shadow: 0 $spacing-sm $font-size-3xl rgba($color-gray-600, 0.4);
  }
}

// Source: FeedbackInput.module.scss
.userTypeSelector {
  background: $color-background-secondary;
  border-radius: $border-radius-lg;
  padding: $spacing-md;
  
  .guestInfo {
    display: flex;
    align-items: center;
    justify-content: center;
    color: $color-gray-600;
    font-size: $font-size-sm;
    font-weight: 600;
  }
  
  .feedbackModeOptions {
    display: flex;
    gap: $spacing-sm + $spacing-xs;
    justify-content: center;
    
    label {
      position: relative;
      display: flex;
      align-items: center;
      padding: $spacing-sm + $spacing-2xs $spacing-lg - $spacing-xs;
      border: $spacing-2xs solid $color-vp-gray-light-2;
      border-radius: $spacing-lg + $spacing-2xs;
      background: $color-white;
      cursor: pointer;
      transition: $transition-base;
      
      &:hover {
        border-color: $color-primary;
        transform: translateY(-$spacing-2xs);
        box-shadow: $shadow;
      }
      
      &.active {
        background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
        border-color: transparent;
        
        .radioLabel {
          color: $color-white;
          
          svg {
            stroke: $color-white;
          }
        }
      }
      
      input[type="radio"] {
        position: absolute;
        opacity: 0;
        width: $spacing-0;
        height: $spacing-0;
      }
      
      .radioLabel {
        display: flex;
        align-items: center;
        gap: $spacing-sm;
        font-size: $font-size-sm;
        font-weight: 600;
        color: $color-gray-700;
        transition: $transition-base;
        
        svg {
          width: $spacing-md + $spacing-2xs;
          height: $spacing-md + $spacing-2xs;
          stroke: $color-gray-600;
          transition: $transition-base;
        }
      }
    }
  }
  
  .nicknameInput {
    margin-top: $spacing-md;
    
    input {
      width: 100%;
      padding: $spacing-sm + $spacing-xs $spacing-md;
      border: $spacing-2xs solid $color-vp-gray-light-2;
      border-radius: $border-radius-md;
      font-size: $font-size-sm;
      background: $color-white;
      transition: $transition-base;
      
      &:focus {
        outline: none;
        border-color: $color-primary;
        box-shadow: 0 0 0 $spacing-xs rgba($color-primary, 0.1);
      }
      
      &::placeholder {
        color: $color-gray-500;
      }
    }
  }
}

// Source: FeedbackPlayer.scss
    .video-container {
      border-radius: $border-radius-lg $border-radius-lg 0 0;
    }

// Source: FeedbackPage.scss
.video-section {
  flex: 1;
  background: $color-black;
  position: relative;
  overflow: hidden;
  
  .video-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    
    video {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
    }
  }
  
  /* 비디오 컨트롤 */
  .video-controls {
    position: absolute;
    bottom: $spacing-0;
    left: $spacing-0;
    right: $spacing-0;
    background: rgba($color-black, 0.7);
    padding: $spacing-sm + $spacing-2xs $spacing-lg - $spacing-xs;
    display: flex;
    align-items: center;
    gap: $spacing-md - $spacing-2xs;
    
    button {
      background: none;
      border: none;
      color: $color-white;
      cursor: pointer;
      padding: $spacing-xs $spacing-sm + $spacing-2xs;
      font-size: $font-size-base;
      
      &:hover {
        background: rgba($color-white, 0.1);
        border-radius: $border-radius-sm;
      }
    }
    
    .time-display {
      color: $color-white;
      font-size: $font-size-sm;
      margin-left: auto;
    }
  }
}

// Source: FeedbackButtons.scss
.visually-hidden {
  position: absolute;
  width: $spacing-2xs;
  height: $spacing-2xs;
  padding: $spacing-0;
  margin: -$spacing-2xs;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  $color-white-space: nowrap;
  border-width: $spacing-0;
}



/* Enhanced Responsive Design */
@media (max-width: 768px) {
  .feedbackButtons {
    flex-wrap: wrap;
    gap: $spacing-xs;
    
    button {
      flex: 1 1 45%;
      min-width: 120px;
      font-size: $font-size-sm;
      padding: $spacing-xs $spacing-sm;
    }
  }
  
  .videoContainer {
    height: auto;
    aspect-ratio: 16/9;
  }
}

@media (max-width: 480px) {
  .feedbackButtons button {
    flex: 1 1 100%;
  }
  
  .feedbackList {
    padding: $spacing-xs;
  }
  
  .feedbackItem {
    padding: $spacing-sm;
    font-size: $font-size-sm;
  }
}