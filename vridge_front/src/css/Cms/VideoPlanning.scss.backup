// 주인공 설정 섹션 스타일
.character-settings {
  margin-top: 32px;
  background: #ffffff;
  border-radius: 12px;
  padding: 24px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  border: 1px solid #e9ecef;
  
  .section-title {
    font-size: 18px;
    font-weight: 600;
    color: #1a1f36;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e9ecef;
  }
  
  .character-settings-content {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    
    @media (max-width: 768px) {
      flex-direction: column;
    }
  }
  
  .character-input-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    
    .character-name-input,
    .character-description-input {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid #dee2e6;
      border-radius: 8px;
      font-size: 14px;
      transition: all 0.2s ease;
      background: #f8f9fa;
      
      &:focus {
        outline: none;
        border-color: #1631F8;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(22, 49, 248, 0.1);
      }
      
      &::placeholder {
        color: #adb5bd;
      }
    }
    
    .character-description-input {
      resize: vertical;
      min-height: 80px;
      font-family: inherit;
      line-height: 1.5;
    }
  }
  
  .character-image-upload {
    flex-shrink: 0;
    
    .image-upload-label {
      display: block;
      cursor: pointer;
      
      input[type="file"] {
        display: none;
      }
    }
    
    .upload-button {
      width: 140px;
      height: 140px;
      border: 2px dashed #dee2e6;
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      background: #f8f9fa;
      position: relative;
      overflow: hidden;
      
      &:hover {
        border-color: #1631F8;
        background: #f0f4ff;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(22, 49, 248, 0.15);
      }
      
      svg {
        width: 32px;
        height: 32px;
        color: #6c757d;
        margin-bottom: 8px;
      }
      
      .upload-text {
        font-size: 13px;
        color: #6c757d;
        text-align: center;
        line-height: 1.4;
        font-weight: 500;
      }
      
      .image-preview {
        width: 100%;
        height: 100%;
        position: relative;
        
        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          border-radius: 10px;
        }
        
        .change-image {
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          background: rgba(22, 49, 248, 0.9);
          color: white;
          padding: 8px;
          text-align: center;
          font-size: 12px;
          font-weight: 500;
          opacity: 0;
          transition: opacity 0.2s ease;
        }
        
        &:hover .change-image {
          opacity: 1;
        }
      }
    }
    
    .remove-image-btn {
      margin-top: 12px;
      width: 140px;
      padding: 8px;
      background: #dc3545;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      
      &:hover {
        background: #c82333;
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(220, 53, 69, 0.2);
      }
    }
  }
}

// 캐릭터 보이스톤 스타일 추가
.voice-tone-section {
  margin-top: 24px;
  
  .voice-tone-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    
    label {
      font-size: 14px;
      font-weight: 500;
      color: #495057;
    }
  }
  
  .voice-tone-input,
  .custom-tone-input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    font-size: 14px;
    transition: all 0.2s ease;
    background: #f8f9fa;
    
    &:focus {
      outline: none;
      border-color: #1631F8;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(22, 49, 248, 0.1);
    }
    
    &::placeholder {
      color: #adb5bd;
    }
  }
}