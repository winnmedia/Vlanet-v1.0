  #header {
    position: absolute;
    left: $spacing-0;
    top: $spacing-0;
    width: 100%;
    .inner {
      max-width: 1200px;
      width: 96%;
      margin: $spacing-0 auto;
      padding: $spacing-lg - $spacing-xs 0 0;
      position: Relative;
      &:before {
        content: '';
        display: block;
        width: 123px;
        height: 172px;
        background: url('../images/Home/new/visual-img02.png') no-repeat;
        background-size: cover;
        position: absolute;
        left: -180px;
        top: 150px;
      }
      .logo {
        img {
          width: 140px;
          margin-top: $spacing-xs;
        }
      }
      .etc {
        display: flex;
        justify-content: start;
        align-items: center;
        ul {
          li {
            display: inline-block;
            margin-left: $spacing-md - 1px;
            width: $spacing-2xl;
            height: $spacing-2xl;
            border-radius: 100%;
            text-indent: -9$color-gray-500px;
            cursor: pointer;
            &:nth-child(1) {
              background: url('../images/Common/yt_icon02.svg') no-repeat;
              background-size: cover;
              background-position: center;
            }
            &:nth-child(2) {
              background: url('../images/Common/insta_icon02.svg') no-repeat;
              background-size: cover;
              background-position: center;
            }
            a {
              display: block;
            }
          }
        }
        button.submit {
          width: 90px;
          height: 45px;
          margin-left: $spacing-2xl;
          background: #0059db;
          color: $color-white;
          border: none;
          border-radius: $border-radius-md;
          font-size: $font-size-base;
          font-weight: 600;
          cursor: pointer;
          transition: all 0.3s ease;
          white-space: nowrap;
          &:hover {
            background: #0047b3;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,89,219,0.3);
          }
        }
      }
    }
  }
  #container {
    .visual {
      background: url('../images/Home/new/visual-bg.png') no-repeat;
      background-size: cover;
      padding: 180px 0 100px;
      .inner {
        display: flex;
        justify-content: center;
        align-items: center;
        max-width: 1300px;
        width: 96%;
        margin: $spacing-0 auto;
        gap: 100px;
        .txt {
          color: $color-white;
          font-size: $font-size-6xl;
          font-weight: 600;
          line-height: 1.3;
          width: 410px;
          span {
            display: inline-block;
            background: #006ae8;
            margin-top: $spacing-sm + 2px;
            word-break: keep-all;
          }
          p {
            font-size: $font-size-2xl;
            font-weight: 400;
            color: rgba($color-white, 0.8);
            margin-top: $spacing-lg + 6px;
            line-height: 1.5;
          }
        }
        .img {
          width: calc(100% - 510px);
        }
      }
    }

    .textbox {
      background: #ece$color-white;
      text-align: center;
      padding: 150px 0;
      img {
        width: 420px;
      }
      div {
        font-weight: bold;
        line-height: 1.4;
        font-size: 40px;
        margin-top: $spacing-lg + 6px;
        word-break: keep-all;
      }
      p {
        margin-top: $spacing-lg + 6px;
        font-size: $font-size-3xl;
        span {
          font-weight: bold;
          color: #0031ff;
          display: inline-block;
        }
      }
    }

    .function {
      background: url('../images/Home/w_bg.png') no-repeat;
      background-size: cover;
      background-position: center;
      padding: 150px 0 0;
      .inner {
        max-width: 1300px;
        width: 96%;
        margin: $spacing-0 auto;
        h2 {
          span {
            color: #0059db;
            font-family: 'psb';
            font-size: 38px;
            position: relative;
            &:after {
              content: '*';
              display: block;
              color: #0059db;
              font-size: 40px;
              position: absolute;
              left: -20px;
              top: -20px;
              font-family: 'pl';
            }
          }
        }
        .content {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-top: $spacing-3xl + 2px;
          gap: 100px;
          .img {
            width: calc(100% - 500px);
          }
          .txt {
            width: 400px;
            div {
              font-size: 40px;
              color: $color-black;
              font-weight: 600;
              padding-top: $spacing-4xl - $spacing-xs;
              position: Relative;
              span {
                color: #0059db;
                font-size: 23px;
                font-weight: 400;
                display: block;
              }
            }
            p {
              color: $color-black;
              font-size: $font-size-lg;
              margin-top: $spacing-lg - $spacing-xs;
              word-break: keep-all;
            }
            .submit {
              margin-top: $spacing-lg + 6px;
              width: 130px;
              height: $spacing-3xl + 2px;
              color: $color-white;
              background: #25282f;
            }
          }
        }
      }
      &.feedback {
        .inner {
          .content {
            .txt {
              div {
                &:before {
                  content: '';
                  display: block;
                  width: $spacing-3xl + 2px;
                  height: $spacing-3xl + 2px;
                  background: url('../images/Home/new/feedback-img02.png')
                    no-repeat;
                  background-size: cover;
                  position: absolute;
                  left: $spacing-0;
                  top: $spacing-0;
                }
              }
            }
          }
        }
      }
      &.project {
        .inner {
          .content {
            flex-direction: row-reverse;
            .txt {
              div {
                &:before {
                  content: '';
                  display: block;
                  width: $spacing-3xl + 2px;
                  height: $spacing-3xl + 2px;
                  background: url('../images/Home/new/project-img02.png')
                    no-repeat;
                  background-size: cover;
                  position: absolute;
                  left: $spacing-0;
                  top: $spacing-0;
                }
              }
            }
          }
        }
      }
      &.comment {
        .inner {
          .content {
            .txt {
              div {
                &:before {
                  content: '';
                  display: block;
                  width: $spacing-3xl + 2px;
                  height: $spacing-3xl + 2px;
                  background: url('../images/Home/new/comment-img02.png')
                    no-repeat;
                  background-size: cover;
                  position: absolute;
                  left: $spacing-0;
                  top: $spacing-0;
                }
              }
            }
          }
        }
      }
      &.contents {
        padding: 150px 0;
        .inner {
          .content {
            flex-direction: row-reverse;
            .list {
              width: calc(100% - 500px);
              ul {
                width: 100%;
                display: grid;
                grid-gap: $spacing-lg - $spacing-xs;
                grid-template-columns: repeat(3, 1fr);
                li {
                  height: 220px;
                  padding: $spacing-md - 1px;
                  border-radius: 25px;
                  position: Relative;
                  overflow: hidden;
                  &:nth-child(1) {
                    background: url('../images/Home/img02.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  &:nth-child(2) {
                    background: url('../images/Home/img03.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  &:nth-child(3) {
                    background: url('../images/Home/img05.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  &:nth-child(4) {
                    background: url('../images/Home/img04.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  &:nth-child(5) {
                    background: url('../images/Home/img06.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  &:nth-child(6) {
                    background: url('../images/Home/img07.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  .mask {
                    position: absolute;
                    left: $spacing-0;
                    top: $spacing-0;
                    width: 100%;
                    height: 100%;
                    background: rgba($color-black, 0.6);
                  }
                  .text {
                    color: $color-white;
                    font-size: $font-size-xl;
                    position: relative;
                    z-index: 1;
                    font-weight: 600;
                  }
                }
              }
            }
            .txt {
              div {
                &:before {
                  content: '';
                  display: block;
                  width: $spacing-3xl + 2px;
                  height: $spacing-3xl + 2px;
                  /* background: url('../images/Home/new/contents-img.png')
                    no-repeat;
                  background-size: cover; */
                  position: absolute;
                  left: $spacing-0;
                  top: $spacing-0;
                }
              }
            }
          }
        }
      }
    }

    .identity {
      background: #f4f7fe;
      padding: 150px 0;
      .inner {
        max-width: 1200px;
        width: 96%;
        margin: $spacing-0 auto;
        h2 {
          span {
            font-family: 'psb';
            font-size: 38px;
            color: $color-black;
            position: relative;
            &:after {
              content: '*';
              display: block;
              color: $color-black;
              font-size: 40px;
              position: absolute;
              right: -20px;
              top: -20px;
              font-family: 'pl';
            }
          }
        }
        ul {
          margin-top: 70px;
          display: grid;
          grid-gap: $spacing-lg - $spacing-xs;
          grid-template-columns: repeat(4, 1fr);
          width: 100%;
          li {
            .img {
              width: 240px;
              height: 200px;
              border-radius: 20px;
              margin: $spacing-0 auto;
              box-shadow: 16px 10px 16px rgba($color-black, 0.2);
              background: #0059d5;
              display: flex;
              justify-content: center;
              align-items: center;
              img {
                width: 120px;
              }
            }
            .txt {
              color: #2b2f38;
              font-size: $font-size-2xl;
              font-weight: 600;
              line-height: 1.2;
              margin-top: $spacing-xl;
              text-align: center;
            }
          }
        }
      }
    }

    .background {
      background: url('../images/Home/w_bg.png') no-repeat;
      background-size: cover;
      background-position: center;
      padding: 150px 0;
      .inner {
        max-width: 1200px;
        width: 96%;
        margin: $spacing-0 auto;
        h2 {
          span {
            font-family: 'psb';
            font-size: 38px;
            position: relative;
            &:after {
              content: '*';
              display: block;
              color: $color-black;
              font-size: 40px;
              position: absolute;
              right: -20px;
              top: -20px;
              font-family: 'pl';
            }
          }
        }
        .group {
          justify-content: space-between;
          display: flex;
          margin-top: 100px;
          .txt_box {
            font-size: $font-size-3xl;
            line-height: 1.4;
            word-break: keep-all;
            span {
              display: block;
              font-family: 'psb';
              font-size: $font-size-xl;
              word-break: keep-all;
              margin-bottom: $spacing-sm + 2px;
            }
            b {
              font-weight: bold;
              color: #0059db;
              display: block;
              word-break: keep-all;
              margin-top: $spacing-sm + 2px;
            }
          }
          .ex {
            .part {
              .img {
                position: relative;
                width: 110px;
                height: 110px;
                &:before {
                  content: '';
                  display: block;
                  width: 110px;
                  height: 110px;
                  border-radius: 100%;
                  position: absolute;
                  left: $spacing-0;
                  top: $spacing-0;
                  background: #0059db;
                }
                img {
                  height: 130px;
                  position: absolute;
                  left: 50%;
                  transform: translateX(-50%);
                  top: -24px;
                  max-width: initial;
                  &.img01 {
                    height: 120px;
                  }
                  &.img02 {
                    height: 120px;
                  }
                }
              }
              .text {
                background: $color-white;
                padding: $spacing-lg + 6px;
                box-shadow: 5px 5px 10px #e8e8e8;
                margin-top: -20px;
                width: calc(100% - 150px);
                div {
                  span {
                    background: #0059db;
                    display: inline-block;
                    border-radius: $border-radius-lg - 2px;
                    padding: $spacing-xs 8px;
                    font-size: $font-size-sm;
                    color: $color-white;
                    img {
                      height: $spacing-md - 2px;
                      vertical-align: middle;
                      margin: -2px 4px 0 0;
                    }
                  }
                }
                p {
                  font-size: $font-size-xl;
                  margin-top: $spacing-sm + 2px;
                }
              }
              &:nth-child(1) {
                .text {
                  border-radius: 20px 20px 20px 0;
                  margin-left: $spacing-2xl;
                }
              }
              &:nth-child(2) {
                .text {
                  border-radius: 20px 20px 0 20px;
                  margin-right: $spacing-2xl;
                }
              }
            }
          }
        }
      }
    }

    .video {
      background: #142868;
      padding: 100px 0;
      .inner {
        max-width: 1200px;
        width: 96%;
        margin: $spacing-0 auto;
        h2 {
          margin-bottom: $spacing-3xl + 2px;
          span {
            font-family: 'psb';
            font-size: 38px;
            position: relative;
            color: $color-white;
            display: inline-block;
            &:after {
              content: '*';
              display: block;
              color: $color-white;
              font-size: 40px;
              position: absolute;
              left: -6px;
              top: -20px;
              font-family: 'pl';
            }
            br {
              display: none;
            }
          }
        }
        .video-wrap {
          position: relative;
          padding-bottom: 56.25%;
          iframe {
            position: absolute;
            top: $spacing-0;
            left: $spacing-0;
            right: $spacing-0;
            bottom: $spacing-0;
            width: 100%;
            height: 100%;
          }
        }
      }
    }

    .end {
      background: url('../images/Home/new/end-bg.png') no-repeat;
      background-size: cover;
      padding: $spacing-5xl 0 30px;
      .inner {
        display: flex;
        justify-content: center;
        align-items: center;
        .txt {
          color: $color-white;
          font-size: $font-size-6xl;
          font-weight: 600;
          line-height: 1.3;
          margin-right: 100px;
          span {
            display: inline-block;
            background: #006ae8;
            margin-top: $spacing-sm + 2px;
          }
        }
      }
      .ment {
        color: $color-white;
        font-size: 22px;
        font-family: 'pr';
        text-align: center;
        margin-top: $spacing-5xl;
        img {
          width: $spacing-lg;
          vertical-align: middle;
          margin: -2px 10px 0 0;
        }
      }
    }

