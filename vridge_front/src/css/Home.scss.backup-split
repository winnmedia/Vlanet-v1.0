      .last {
        background: url('../images/Home/bg07.png'),
          url('../images/Home/bg08.png');
        background-size: $spacing-6xl * 4.17, cover;
        background-position: left 0 bottom 0, $spacing-0 $spacing-0;
        background-repeat: no-repeat;
        height: 540px;
        position: relative;
        padding: $spacing-3xl + $spacing-2xs $spacing-sm + $spacing-2xs 0;
        div {
          position: initial;
          top: initial;
          right: initial;
          font-size: $font-size-3xl;
          font-weight: bold;
          text-align: center;
          color: $color-white;
          line-height: $line-height-tight;
          span {
            display: block;
            color: $color-primary;
            text-align: center;
          }
        }
        p {
          position: initial;
          bottom: initial;
          right: initial;
          color: $color-white;
          font-size: $font-size-sm;
          line-height: $line-height-relaxed;
          margin-top: $spacing-lg + $spacing-xs + $spacing-2xs;
          text-align: center;
        }
      }
    }
    #footer {
      background: $color-gray-900;
      padding: $spacing-3xl + $spacing-2xs $spacing-lg - $spacing-xs;
      .inner {
        max-width: $breakpoint-xl;
        margin: $spacing-0 auto;
        display: block;
        > div {
          .logo {
            color: $color-primary;
            font-size: $spacing-lg - $spacing-2xs;
            font-weight: bold;
            margin-top: $spacing-0;
          }
          ul {
            margin-top: $spacing-lg + $spacing-xs + $spacing-2xs;
            li {
              color: $color-white;
              margin-top: $spacing-sm - $spacing-2xs;
              font-size: $spacing-md - $spacing-xs;
            }
          }
          div {
            margin-top: $spacing-lg + $spacing-xs + $spacing-2xs;
            span {
              display: inline-block;
              background: $color-white;
              padding: $spacing-xs $spacing-sm;
              margin-right: $spacing-sm + $spacing-2xs;
              border-radius: $border-radius-lg - $border-radius-sm / 2;
              font-size: $font-size-sm;
            }
          }
        }
        > ul {
          margin-top: $spacing-lg + $spacing-xs + $spacing-2xs;
          li {
            display: inline-block;
            margin-left: $spacing-0;
            margin-right: $spacing-sm + $spacing-2xs;
            width: $spacing-2xl;
            height: $spacing-2xl;
            border-radius: 100%;
            text-indent: -9$color-gray-500px;
            cursor: pointer;
            &:nth-child(1) {
              background: $color-white url('../images/Common/yt_icon.svg') no-repeat;
              background-size: $font-size-2xl;
              background-position: center;
            }
            &:nth-child(2) {
              background: $color-white url('../images/Common/insta_icon.svg') no-repeat;
              background-size: $font-size-xl;
              background-position: center;
            }
          }
        }
      }
    }
  }
  
  // 반응형 스타일
  @media (min-width: 769px) and (max-width: $breakpoint-lg) { #header { .inner { .etc { button.submit { display: block !important;
          }
        }
      }
    }
  }
  
  @media (max-width: $breakpoint-md) { #header { .inner { padding: $spacing-md - $spacing-2xs $spacing-lg - $spacing-xs;
        
        .logo {
          img {
            width: $spacing-6xl + $spacing-xs;
          }
        }
        
        .etc {
          display: flex !important;
          align-items: center;
          
          ul {
            li {
              width: $spacing-xl + $spacing-xs;
              height: $spacing-xl + $spacing-xs;
              margin-left: $spacing-sm + $spacing-2xs;
            }
          }
          
          button.submit {
            display: block !important;
            width: $spacing-4xl + $spacing-xs + $spacing-2xs;
            height: $spacing-2xl;
            margin-left: $spacing-md - $spacing-2xs;
            font-size: $font-size-sm;
            flex-shrink: 0;
          }
        }
      }
    }
  }
  
  @media (max-width: $spacing-6xl * 5) { #header { .inner { .etc { ul { display: none; // 작은 화면에서는 SNS 아이콘 숨김
          }
          
          button.submit {
            display: block !important;
            margin-left: $spacing-0;
          }
        }
      }
    }
  }
}
