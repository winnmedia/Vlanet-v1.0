@import '../styles/design-tokens';

/* 공통 */
// PageTitleUnified.scss 삭제됨 - 필요한 스타일은 아래에 통합
// FeedbackGridLayout.scss는 이제 CSS Module로 사용됨

.ant-modal-body {
  padding: $spacing-0 !important;
}

/* 직접입력 관련 스타일 */
.custom-select-wrapper {
  position: relative;
  
  select {
    optgroup {
      font-weight: bold;
      font-style: normal;
      background: $color-gray-100;
      color: $color-gray-800;
    }
    
    option {
      padding: $spacing-xs 8px;
      
      &[value="직접입력"] {
        background-color: #f0f7ff;
        color: #1976d2;
        font-weight: 600;
      }
    }
  }
  
  .custom-input-wrapper {
    display: flex;
    gap: $spacing-sm + 2px;
    align-items: center;
    margin-top: $spacing-sm + 2px;
    
    input {
      flex: 1;
      padding: $spacing-sm + $spacing-xs 16px;
      font-size: 15px;
      border: 2px solid #4a90e2;
      border-radius: $border-radius-md - 2px;
      background: #f8fbff;
      transition: all 0.2s ease;
      
      &:focus {
        outline: none;
        border-color: #012$color-white;
        background: white;
        box-shadow: 0 0 0 3px rgba(1, 47, 255, 0.1);
      }
      
      &::placeholder {
        color: #888;
        font-size: $font-size-sm;
      }
    }
    
    .cancel-custom-btn {
      padding: $spacing-sm + $spacing-xs 20px;
      background: #f0f0f0;
      border: 1px solid $color-gray-300;
      border-radius: $border-radius-md - 2px;
      cursor: pointer;
      font-size: $font-size-sm;
      white-space: nowrap;
      transition: all 0.2s ease;
      
      &:hover {
        background: #e0e0e0;
        border-color: $color-gray-400;
      }
    }
  }
}

.cms_wrap {
  display: flex;
  justify-content: space-between;
  height: calc(100vh - 120px);
  height: calc((var(--vh, 1vh) * 100) - 120px);
  margin-top: $spacing-2xl;
  position: Relative;
  main {
    width: calc(100% - 300px);
    margin-left: auto;
    padding: $spacing-0 30px 0 80px;
    overflow-y: scroll;
    // -ms-overflow-style: none;
    position: relative;
    // &::-webkit-scrollbar {
    //   display: none;
    // }
    .title {
      font-size: 34px;
      font-weight: bold;
      span {
        display: block;
        font-size: 22px;
        font-weight: normal;
      }
    }
    .content {
      margin: $spacing-lg + 6px 0;
      background: white;
      padding: $spacing-lg;
      border-radius: $border-radius-lg;
      box-shadow: 0 1px 3px rgba($color-black, 0.05);
      border: 1px solid #e9ecef;
      
      &.calendar {
        background: transparent;
        padding: $spacing-0;
        box-shadow: $shadow-none;
        border: none;
      }
      &.home {
        margin: $spacing-0 0 50px;
        .today {
          font-size: 160px;
          letter-spacing: 8px;
          line-height: 1.3;
          font-family: 'psb';
          
          .clock {
            display: flex;
            align-items: baseline;
          }
          
          @keyframes blink {
            0% {
              opacity: 1;
            }
            90% {
              opacity: 1;
            }
            // 50% {
            //   opacity: 0;
            // }
            100% {
              opacity: 0;
            }
          }
          small {
            color: rgba($color-black, 0.6);
            display: inline-block;
            font-size: 28px;
            letter-spacing: 0.5px;
            font-weight: 600;
            font-family: 'suit';
            vertical-align: baseline;
            margin-left: $spacing-lg + 6px;
          }
        }
        .menu_box {
          margin-top: $spacing-5xl;
          ul {
            li {
              cursor: pointer;
              display: inline-block;
              margin-right: $spacing-4xl - $spacing-xs;
              width: 150px;
              .img {
                border-radius: 35px;
                height: 150px;
                width: 150px;
              }
              span {
                color: #bac4d1;
                display: block;
                font-size: $font-size-base;
                margin-top: $spacing-lg - $spacing-xs;
                text-align: center;
              }
              &:nth-child(1) {
                .img {
                  background: #0131ff url('../../images/Cms/c_p.svg') no-repeat;
                  background-size: 76px;
                  background-position: center;
                }
              }
              &:nth-child(2) {
                .img {
                  background: #889cb1 url('../../images/Cms/p_p.svg') no-repeat;
                  background-size: 76px;
                  background-position: center;
                }
              }
              &:nth-child(3) {
                .img {
                  background: #889cb1 url('../../images/Cms/f_p.svg') no-repeat;
                  background-size: 76px;
                  background-position: center;
                }
              }
              &:nth-child(4) {
                .img {
                  background: #889cb1 url('../../images/Cms/oc_p.svg') no-repeat;
                  background-size: 76px;
                  background-position: center;
                }
              }
            }
          }
        }
        .part {
          margin-top: $spacing-3xl + 2px;
          &:first-child {
            margin-top: $spacing-0;
          }
          .s_title {
            font-size: $font-size-2xl;
            span {
              display: inline-block;
              width: $spacing-lg + $spacing-xs;
              height: $spacing-lg + $spacing-xs;
              background: #0131ff url('../../images/Cms/wr_arrow_icon.png')
                no-repeat;
              background-size: 9px;
              background-position: center left 11px;
              border-radius: 100%;
              margin-left: $spacing-sm + 2px;
              margin-top: 3px;
              cursor: pointer;
            }
          }
          ul {
            margin-top: $spacing-lg - $spacing-xs;
            &.schedule {
              display: grid;
              grid-gap: $spacing-0 20px;
              grid-template-columns: repeat(4, 1fr);
              li {
                background: #25282f;
                border-radius: 25px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                height: 140px;
                padding: $spacing-0 30px;
                color: $color-white;
                font-size: 22px;
                span {
                  font-weight: bold;
                  font-size: 50px;
                }
                &:first-child {
                  background: #0131ff;
                }
              }
            }
            &.oc {
              display: grid;
              grid-gap: $spacing-0 20px;
              grid-template-columns: repeat(3, 1fr);
              li {
                height: 340px;
                padding: $spacing-lg + 6px;
                color: $color-white;
                font-size: $font-size-3xl;
                background: $color-gray-400;
                border-radius: 25px;
                font-weight: bold;
                span {
                  font-weight: normal;
                  display: block;
                  font-size: $font-size-lg;
                  margin-top: $spacing-sm + 2px;
                }
              }
            }
          }
        }
      }
      &.calendar {
        .title {
          font-size: $font-size-xl;
          font-weight: 700;
          color: #212529;
          margin-bottom: $spacing-lg;
          display: flex;
          align-items: center;
          gap: $spacing-sm + $spacing-xs;
          
          .collapse-btn {
            width: $spacing-lg;
            height: $spacing-lg;
            background: $color-background-secondary;
            border: 1px solid #dee2e6;
            border-radius: $border-radius-sm;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            position: relative;
            
            &::after {
              content: '';
              width: $spacing-0;
              height: $spacing-0;
              border-left: $spacing-xs solid transparent;
              border-right: $spacing-xs solid transparent;
              border-top: 6px solid #495057;
              transition: transform 0.3s ease;
            }
            
            &:hover {
              background: #e9ecef;
              border-color: #adb5bd;
            }
            
            &.collapsed::after {
              transform: rotate(180deg);
            }
          }
        }
        
        .filter {
          background: white;
          padding: $spacing-lg - $spacing-xs;
          border-radius: $border-radius-lg;
          box-shadow: 0 1px 3px rgba($color-black, 0.05);
          border: 1px solid #e9ecef;
          margin-bottom: $spacing-lg;
          
          &.flex {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: $spacing-lg - $spacing-xs;
            
            @media (max-width: $breakpoint-md) {
              flex-direction: column;
              align-items: stretch;
            }
          }
          
          .date {
            font-size: 28px;
            font-weight: 700;
            color: #212529;
            display: flex;
            align-items: center;
            gap: $spacing-lg - $spacing-xs;
            
            .move {
              display: flex;
              gap: $spacing-sm;
              
              span {
                display: flex;
                align-items: center;
                justify-content: center;
                width: $spacing-xl + $spacing-xs;
                height: $spacing-xl + $spacing-xs;
                border-radius: $border-radius-md;
                cursor: pointer;
                background: $color-background-secondary;
                border: 1px solid #dee2e6;
                transition: all 0.2s ease;
                
                &:hover {
                  background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
                  border-color: transparent;
                  transform: translateY(-1px);
                  box-shadow: 0 2px 8px rgba($color-primary, 0.2);
                  
                  &.prev::before {
                    border-right-color: white;
                  }
                  &.next::before {
                    border-left-color: white;
                  }
                }
                
                &.prev::before {
                  content: '';
                  width: $spacing-0;
                  height: $spacing-0;
                  border-top: 6px solid transparent;
                  border-bottom: 6px solid transparent;
                  border-right: $spacing-sm solid #495057;
                  margin-right: 2px;
                }
                
                &.next::before {
                  content: '';
                  width: $spacing-0;
                  height: $spacing-0;
                  border-top: 6px solid transparent;
                  border-bottom: 6px solid transparent;
                  border-left: $spacing-sm solid #495057;
                  margin-left: 2px;
                }
              }
            }
          }
          
          .type {
            display: flex;
            align-items: center;
            gap: $spacing-sm + $spacing-xs;
            
            .ant-select {
              .ant-select-selector {
                border-radius: $border-radius-md;
                border-color: #dee2e6;
                height: $spacing-2xl;
                display: flex;
                align-items: center;
                
                &:hover {
                  border-color: $color-primary;
                }
              }
              
              &.ant-select-focused .ant-select-selector {
                border-color: $color-primary;
                box-shadow: 0 0 0 2px rgba($color-primary, 0.1);
              }
            }
            justify-content: start;
            .ant-select {
              > div {
                height: 54px;
                > span {
                  height: 54px;
                  line-height: 54px;
                }
              }
            }
            .submit {
              padding: $spacing-sm + $spacing-xs 24px;
              background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
              color: white;
              border: none;
              border-radius: $border-radius-md;
              font-size: 15px;
              font-weight: 600;
              cursor: pointer;
              transition: all 0.3s ease;
              box-shadow: 0 2px 4px rgba($color-primary, 0.2);
              white-space: nowrap;
              
              &:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba($color-primary, 0.3);
              }
              
              &:active {
                transform: translateY(0);
              }
              
              &:disabled {
                opacity: 0.6;
                cursor: not-allowed;
                transform: none;
              }
            }
            // .ant-space {
            //   gap: $spacing-sm + 2px !important;
            //   font-family: 'sr' !important;
            // }
            // .ant-select-selector {
            //   height: $spacing-3xl + 2px;
            //   line-height: $spacing-3xl + 2px;
            //   border: none;
            //   background: $color-gray-100;
            //   outline: none !important;
            //   border: 1px solid $color-gray-100 !important;
            // }
            // .ant-select-selection-search-input {
            //   height: $spacing-3xl + 2px;
            // }
            // .ant-select-selection-item {
            //   line-height: $spacing-3xl + 2px;
            //   font-family: 'sr';
            //   font-size: 15px;
            // }
          }
        }
        .part {
          ul {
            &.schedule {
              display: grid;
              grid-gap: $spacing-0 20px;
              grid-template-columns: repeat(4, 1fr);
              li {
                background: #25282f;
                border-radius: 25px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                height: 140px;
                padding: $spacing-0 30px;
                color: $color-white;
                font-size: 22px;
                span {
                  font-weight: bold;
                  font-size: 50px;
                }
                &:first-child {
                  background: #0131ff;
                }
              }
            }
          }
        }
        .caldendar_box {
          margin-top: $spacing-lg - $spacing-xs;
          .th {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            div {
              padding: 6px;
              background: #23262d;
              color: $color-white;
              font-size: $font-size-base;
              &.holiday {
                background: #707175;
              }
            }
          }
          .td {
            .week {
              display: grid;
              grid-template-columns: repeat(7, 1fr);
              > div {
                padding: 6px;
                color: $color-black;
                font-size: $font-size-base;
                border: 1px solid #efefef;
                min-height: 100px;
                p {
                  cursor: pointer;
                }
                .Modal {
                  position: absolute;
                  display: block !important;
                  background: $color-black;
                  z-index: 10;
                  padding: $spacing-sm + 2px;
                  color: $color-white;
                  border-radius: $border-radius-sm + 1px;
                }
                .today {
                  color: $color-white;
                  font-size: $font-size-base;
                  font-weight: bold;
                  width: $spacing-lg;
                  height: $spacing-lg;
                  display: inline-block;
                  line-height: $spacing-lg;
                  background: #012$color-white;
                  text-align: center;
                  border-radius: 100%;
                }
                span {
                  display: block;
                  height: $spacing-xs;
                  width: calc(100% + 20px);
                  margin-left: -10px;
                  margin-top: $spacing-sm + 2px;
                  &:first-child {
                    margin-top: $spacing-md - 1px;
                  }
                  &.start {
                    border-radius: $border-radius-md - 2px 0 0 6px;
                  }
                  &.end {
                    border-radius: $border-radius-none 6px 6px 0;
                  }
                  &.start {
                    &.end {
                      border-radius: $border-radius-md - 2px;
                    }
                  }
                  &.first {
                    background: #55a1f5;
                  }
                  &.second {
                    background: #0d45ac;
                  }
                  &.third {
                    background: #8a88e9;
                  }
                  &.fourth {
                    background: #774bf0;
                  }
                  &.fifth {
                    background: #57e4ed;
                  }
                  &.sixth {
                    background: #5d888b;
                  }
                  &.seven {
                    background: $color-black;
                  }
                  &.eighth {
                    background: #d93a3a;
                  }
                  &.memo {
                    width: 100%;
                    margin-left: $spacing-0;
                    margin-top: $spacing-0;
                    height: initial;
                    font-size: $font-size-sm;
                    margin-top: $spacing-xs;
                    word-break: break-all;
                  }
                }
                &:first-child {
                  background: #f8f8f8;
                }
                &:last-child {
                  background: #f8f8f8;
                }
              }
            }
          }
          &.day {
            .th {
              display: grid;
              grid-template-columns: repeat(1, 1fr);
            }
            .td {
              .week {
                display: grid;
                grid-template-columns: repeat(1, 1fr);
              }
            }
          }
        }
        .list_box {
          .process {
            margin-top: $spacing-lg + 6px;
            &:first-child {
              margin-top: $spacing-0;
            }
            .s_title {
              width: 150px;
              height: 150px;
              padding: $spacing-lg - $spacing-xs;
              color: $color-white;
              font-size: $font-size-xl;
              background: #0131ff url('../../images/Cms/h_l_w.svg') no-repeat;
              background-size: 34px;
              background-position: right 20px bottom 20px;
              line-height: 1.3;
              border-radius: 20px;
            }
            &:nth-child(1) {
              .s_title {
                background: #0131ff url('../../images/Cms/pc_icon01.svg')
                  no-repeat;
                background-size: 24px;
                background-position: right 20px bottom 20px;
              }
            }
            &:nth-child(2) {
              .s_title {
                background: #0131ff url('../../images/Cms/pc_icon02.svg')
                  no-repeat;
                background-size: 24px;
                background-position: right 20px bottom 20px;
              }
            }
            &:nth-child(3) {
              .s_title {
                background: #0131ff url('../../images/Cms/pc_icon03.svg')
                  no-repeat;
                background-size: 26px;
                background-position: right 20px bottom 20px;
              }
            }
            &:nth-child(4) {
              .s_title {
                background: #0131ff url('../../images/Cms/pc_icon04.svg')
                  no-repeat;
                background-size: 26px;
                background-position: right 20px bottom 20px;
              }
            }
            &:nth-child(5) {
              .s_title {
                background: #0131ff url('../../images/Cms/pc_icon05.svg')
                  no-repeat;
                background-size: 24px;
                background-position: right 20px bottom 20px;
              }
            }
            &:nth-child(6) {
              .s_title {
                background: #0131ff url('../../images/Cms/pc_icon06.svg')
                  no-repeat;
                background-size: 24px;
                background-position: right 20px bottom 20px;
              }
            }
            &:nth-child(7) {
              .s_title {
                background: #0131ff url('../../images/Cms/pc_icon07.svg')
                  no-repeat;
                background-size: 26px;
                background-position: right 20px bottom 20px;
              }
            }
            &:nth-child(8) {
              .s_title {
                background: #0131ff url('../../images/Cms/pc_icon08.svg')
                  no-repeat;
                background-size: 24px;
                background-position: right 20px bottom 20px;
              }
            }
            .swiper {
              width: calc(100% - 180px);
              box-shadow: 16px 10px 16px rgba($color-black, 0.06);
              border-radius: 20px 20px 0 0;
              height: 150px;
              position: relative;
              .swiper-slide {
                border-right: 1px dashed #e9e9e9;
                text-align: center;
                display: table;
                .inner03 {
                  display: table-cell;
                  vertical-align: middle;
                  width: 100%;
                  padding: $spacing-0 14px;
                  .name {
                    font-weight: bold;
                    font-size: 17px;
                    overflow: hidden;
                    display: -webkit-box;
                    -webkit-line-clamp: 1; /* 원하는 줄 수 설정 */
                    -webkit-box-orient: vertical;
                    text-overflow: ellipsis;
                  }
                  .day {
                    margin-top: $spacing-sm + 2px;
                    span {
                      display: block;
                    }
                  }
                }
              }
              .swiper-scrollbar {
                width: 100%;
                position: absolute;
                right: $spacing-0;
                bottom: $spacing-0;
                z-index: 9$color-gray-500;
                .swiper-scrollbar-drag {
                  height: $spacing-xs;
                  background: $color-gray-300$color-gray-300;
                  border-radius: 20px;
                }
              }
            }
            // ul {
            //   width: calc(100% - 180px);
            //   box-shadow: 16px 10px 16px rgba($color-black, 0.06);
            //   border-radius: 20px;
            //   height: 160px;
            //   display: grid;
            //   grid-gap: $spacing-0 0px;
            //   grid-template-columns: repeat(5, 1fr);
            //   li {
            //     border-right: 1px dashed #e9e9e9;
            //     padding: $spacing-lg + 6px 10px;
            //     text-align: center;
            //     .name {
            //       font-weight: bold;
            //       font-size: $font-size-lg;
            //     }
            //     .day {
            //       margin-top: $spacing-lg - $spacing-xs;
            //       span {
            //         display: block;
            //       }
            //     }
            //   }
            // }
          }
        }
        .list_mark {
          margin-top: $spacing-lg;
          background: white;
          padding: $spacing-md 20px;
          border-radius: $border-radius-lg;
          box-shadow: 0 1px 3px rgba($color-black, 0.05);
          border: 1px solid #e9ecef;
          
          ul {
            margin: $spacing-0;
            padding: $spacing-0;
            list-style: none;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: $spacing-lg - $spacing-xs;
            
            @media (max-width: $breakpoint-md) {
              gap: $spacing-sm + $spacing-xs;
              justify-content: flex-start;
            }
            
            li {
              display: flex;
              align-items: center;
              font-size: $font-size-sm;
              color: #495057;
              font-weight: 500;
              
              span {
                display: inline-block;
                width: $spacing-md;
                height: $spacing-md;
                border-radius: $border-radius-full;
                margin-right: $spacing-sm;
                box-shadow: 0 1px 3px rgba($color-black, 0.1);
                
                &.first {
                  background: linear-gradient(135deg, #55a1f5 0%, #4691e5 100%);
                }
                &.second {
                  background: linear-gradient(135deg, #0d45ac 0%, #0a3a91 100%);
                }
                &.third {
                  background: linear-gradient(135deg, #8a88e9 0%, #7a78d9 100%);
                }
                &.fourth {
                  background: linear-gradient(135deg, #774bf0 0%, #673be0 100%);
                }
                &.fifth {
                  background: linear-gradient(135deg, #57e4ed 0%, #47d4dd 100%);
                }
                &.sixth {
                  background: linear-gradient(135deg, #5d888b 0%, #4d787b 100%);
                }
                &.seven {
                  background: linear-gradient(135deg, #212529 0%, $color-black 100%);
                }
                &.eighth {
                  background: linear-gradient(135deg, $color-danger 0%, #c82$color-gray-800 100%);
                }
              }
            }
          }
        }
      }
      // 피드백 페이지 레이아웃
      &.feedback {
        margin: $spacing-0 0 50px;
        background: transparent;
        padding: $spacing-0;
        box-shadow: $shadow-none;
        border: none;
        .flex {
          display: flex;
          gap: $spacing-lg + 6px;
          align-items: flex-start;
          
          // 데스크톱 (1200px+)
          @media (min-width: 1200px) {
            gap: $spacing-lg + 6px;
          }
          
          // 태블릿 (768-1199px)
          @media (max-width: 1199px) {
            gap: $spacing-lg - $spacing-xs;
            
            .video_box {
              flex: 1.5;
            }
            
            .sidebox {
