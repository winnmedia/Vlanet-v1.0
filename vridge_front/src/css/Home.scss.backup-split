  }
  #footer {
    background: $color-gray-900;
    padding: $spacing-4xl + $spacing-xs + $spacing-2xs;
    .inner {
      max-width: $breakpoint-xl;
      margin: $spacing-0 auto;
      > div {
        .logo {
          color: $color-primary;
          font-size: $spacing-xl + $spacing-2xs;
          font-weight: bold;
          margin-top: $spacing-0;
        }
        ul {
          margin-top: $spacing-lg + $spacing-xs + $spacing-2xs;
          li {
            color: $color-white;
            margin-top: $spacing-sm + $spacing-2xs;
          }
        }
        div {
          margin-top: $spacing-lg + $spacing-xs + $spacing-2xs;
          span {
            cursor: pointer;
            display: inline-block;
            background: $color-white;
            padding: $spacing-xs $spacing-sm;
            margin-right: $spacing-sm + $spacing-2xs;
            border-radius: $border-radius-lg - $border-radius-sm / 2;
          }
        }
      }
      > ul {
        li {
          display: inline-block;
          margin-left: $spacing-md - $spacing-2xs;
          width: $spacing-3xl + $spacing-2xs;
          height: $spacing-3xl + $spacing-2xs;
          border-radius: 100%;
          text-indent: -9$color-gray-500px;
          cursor: pointer;
          &:nth-child(1) {
            background: $color-white url('../images/Common/yt_icon.svg') no-repeat;
            background-size: $font-size-3xl;
            background-position: center;
          }
          &:nth-child(2) {
            background: $color-white url('../images/Common/insta_icon.svg') no-repeat;
            background-size: $font-size-3xl;
            background-position: center;
          }
          a {
            display: block;
          }
        }
      }
    }
  }
}

@media screen and (max-width: 1260px) { } @media screen and (max-width: $spacing-8xl * 15.6) { // #Home { // #container { // .visual { // background-position: right -$spacing-6xl + $spacing-4xl center;
  //     }
  //   }
  // }
}
@media screen and (max-width: 1220px) { // #Home { // #container { // .visual { // background-position: right -280px center;
  //     }
