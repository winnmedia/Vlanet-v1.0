    });
    throw error;
  });
}

// 그리기 데이터 저장
export function SaveDrawingData(projectId, feedbackId, drawingData) {
  return axiosInstance.post(`/api/projects/${projectId}/feedback/${feedbackId}/drawings/`, {
    drawing_data: drawingData
  }).catch(error => {
    // 404 오류는 API가 아직 구현되지 않은 것으로 처리
    if (error.response && error.response.status === 404) {
      console.log('그리기 저장 API가 아직 구현되지 않았습니다. 로컬 저장만 사용합니다.');
      // 성공적으로 처리된 것처럼 반환 (로컬 저장을 위해)
      return { data: { success: true, local_only: true } };
    }
    
    handleApiError(error, {
      400: '그리기 데이터 저장 실패',
      401: '인증이 필요합니다.',
      500: '서버 오류가 발생했습니다.'
    });
    throw error;
  });
}

// 그리기 데이터 목록 조회
export function GetDrawingsList(projectId, feedbackId) {
  return axiosInstance.get(`/api/projects/${projectId}/feedback/${feedbackId}/drawings/`)
    .catch(error => {
      // 404 오류는 단순히 데이터가 없는 것으로 처리
      if (error.response && error.response.status === 404) {
        console.log('그리기 데이터가 없습니다.');
        return { data: { drawings: [] } };
      }
      
      handleApiError(error, {
        401: '인증이 필요합니다.',
        500: '서버 오류가 발생했습니다.'
      });
      throw error;
    });
}