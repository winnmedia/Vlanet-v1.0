{
  "buildCommand": "npm install && npm run build:vercel",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "functions": {
    "pages/api/*": {
      "maxDuration": 10
    }
  },
  "env": {
    "DISABLE_POSTCSS_PURGE": "@disable_postcss_purge"
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  }
}