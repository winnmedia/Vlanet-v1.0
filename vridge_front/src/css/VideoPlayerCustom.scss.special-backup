@import '../styles/design-tokens';

// Video.js 마커 커스텀 스타일
.video-js {
  // 마커 기본 스타일
  .vjs-marker {
    position: absolute;
    left: $spacing-0;
    bottom: $spacing-0;
    opacity: 1;
    height: 100%;
    transition: opacity 0.2s;
    cursor: pointer;
    
    &:hover {
      opacity: 1 !important;
    }
    
    // 피드백 마커 스타일
    &.feedback-marker {
      background-color: $color-primary !important;
      
      &.important {
        background-color: $color-danger !important;
      }
    }
    
    // 커스텀 마커 스타일
    &.custom-marker {
      background-color: $color-warning !important;
    }
  }
  
  // 마커 툴팁
  .vjs-tip {
    visibility: hidden;
    position: absolute;
    z-index: 100$color-black;
    bottom: $spacing-lg + 6px;
    margin-left: -23px;
    min-width: 100px;
    max-width: 200px;
    
    .vjs-tip-arrow {
      visibility: hidden;
      position: absolute;
      width: $spacing-0;
      height: $spacing-0;
      border-left: $spacing-xs solid transparent;
      border-right: $spacing-xs solid transparent;
      border-top: $spacing-xs solid rgba($color-black, 0.9);
      bottom: -5px;
      left: 50%;
      margin-left: -5px;
    }
    
    .vjs-tip-inner {
      visibility: visible;
      border-radius: $border-radius-sm - 1px;
      padding: $spacing-xs 8px 4px 8px;
      background-color: rgba($color-black, 0.9);
      color: white;
      font-size: $font-size-xs;
      word-wrap: break-word;
    }
  }
  
  // 마커에 hover 시 툴팁 표시
  .vjs-marker:hover .vjs-tip {
    visibility: visible;
    
    .vjs-tip-arrow {
      visibility: visible;
    }
  }
  
  // 프로그레스바에서 마커 표시
  .vjs-progress-holder {
    .vjs-marker {
      height: 100%;
      top: $spacing-0;
    }
  }
}

// 단축키 가이드 모달 스타일 (향후 사용)
.shortcut-guide-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: white;
  border-radius: $border-radius-lg;
  padding: $spacing-lg;
  box-shadow: 0 4px 20px rgba($color-black, 0.15);
  z-index: 10$color-black;
  max-width: 500px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  
  h3 {
    margin: $spacing-0 0 16px 0;
    font-size: $font-size-xl;
    color: $color-gray-800;
  }
  
  .shortcut-section {
    margin-bottom: $spacing-lg - $spacing-xs;
    
    h4 {
      margin: $spacing-0 0 8px 0;
      font-size: $font-size-base;
      color: $color-gray-600;
    }
    
    .shortcut-item {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      font-size: $font-size-sm;
      
      .key {
        font-family: monospace;
        background: #f0f0f0;
        padding: 2px 6px;
        border-radius: $border-radius-sm;
        border: 1px solid $color-gray-300;
      }
      
      .description {
        color: $color-gray-600;
      }
    }
  }
}