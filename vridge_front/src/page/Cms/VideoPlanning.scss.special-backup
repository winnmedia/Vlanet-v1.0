            align-items: center;
            gap: $spacing-sm + $spacing-xs;
            padding: $spacing-sm + 2px 14px;
            background: #f0f4ff;
            border-radius: $border-radius-md;
            margin-bottom: $spacing-sm + 2px;
            border: 1px solid #e0e8ff;

            .story-stage-badge {
              font-size: $font-size-sm;
              font-weight: 700;
              color: $color-primary;
              background: white;
              padding: 6px 12px;
              border-radius: $border-radius-md - 2px;
              min-width: $spacing-2xl;
              text-align: center;
              box-shadow: 0 2px 4px rgba($color-primary, 0.1);
