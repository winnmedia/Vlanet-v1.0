// VideoPlanet 디자인 토큰 시스템
// 모든 토큰을 하나로 통합

// 순서가 중요합니다!
// 1. 색상 (다른 토큰에서 참조)
@import 'colors';

// 2. 간격
@import 'spacing';

// 3. 타이포그래피
@import 'typography';

// 4. 브레이크포인트
@import 'breakpoints';

// 5. 효과 (색상과 간격 참조)
@import 'effects';

// ========== 추가 토큰 ==========

// 터치 타겟 크기 (접근성)
$touch-target-min: 44px;
$touch-target-recommended: 48px;

// 아이콘 크기
$icon-size-xs: 12px;
$icon-size-sm: 16px;
$icon-size-md: 20px;
$icon-size-lg: 24px;
$icon-size-xl: 32px;

// 최대 너비
$max-width-xs: 320px;
$max-width-sm: 480px;
$max-width-md: 640px;
$max-width-lg: 800px;
$max-width-xl: 960px;
$max-width-2xl: 1200px;
$max-width-full: 100%;

// 종횡비
$aspect-ratio-square: 1 / 1;
$aspect-ratio-video: 16 / 9;
$aspect-ratio-portrait: 3 / 4;
$aspect-ratio-landscape: 4 / 3;

// ========== CSS 변수 추가 ==========
:root {
  // 터치 타겟
  --touch-target-min: #{$touch-target-min};
  --touch-target-recommended: #{$touch-target-recommended};
  
  // 아이콘 크기
  --icon-size-xs: #{$icon-size-xs};
  --icon-size-sm: #{$icon-size-sm};
  --icon-size-md: #{$icon-size-md};
  --icon-size-lg: #{$icon-size-lg};
  --icon-size-xl: #{$icon-size-xl};
  
  // 최대 너비
  --max-width-xs: #{$max-width-xs};
  --max-width-sm: #{$max-width-sm};
  --max-width-md: #{$max-width-md};
  --max-width-lg: #{$max-width-lg};
  --max-width-xl: #{$max-width-xl};
  --max-width-2xl: #{$max-width-2xl};
  --max-width-full: #{$max-width-full};
}

// ========== 글로벌 스타일 리셋 ==========
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-family: $font-family-base;
  font-size: $font-size-base;
  line-height: $line-height-body;
  color: $color-text-primary;
  background-color: $color-background;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  margin: 0;
  padding: 0;
}

// 접근성: 포커스 스타일
:focus-visible {
  outline: 2px solid $color-primary;
  outline-offset: 2px;
}

// 스크롤바 스타일
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: $color-gray-100;
}

::-webkit-scrollbar-thumb {
  background: $color-gray-400;
  border-radius: $radius-sm;
  
  &:hover {
    background: $color-gray-500;
  }
}

// 선택 영역 스타일
::selection {
  background: $color-primary-light;
  color: $color-primary-dark;
}