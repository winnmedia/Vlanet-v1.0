## 7. Fix Feedback.jsx member_list undefined error
# In src/page/Cms/Feedback.jsx, update the is_admin useMemo:

const is_admin = useMemo(() => {
  if (!current_project || !user) {
    return false
  }
  
  // Check if user is owner
  if (user === current_project.owner_email) {
    return true
  }
  
  // Check if user is manager in member_list
  if (current_project.member_list && Array.isArray(current_project.member_list)) {
    return current_project.member_list.some(member => 
      member && member.email === user && member.rating === 'manager'
    )
  }
  
  return false
}, [current_project, user])

