@import '../styles/design-tokens';

.video-planning {
  padding: $spacing-lg - $spacing-xs 30px; // 상하 20px, 좌우 30px로 조정
  background: $color-background-secondary;
  min-height: calc(100vh - 120px);
  
  // 원형 토글 버튼 스타일
  .collapse-btn {
    width: $spacing-xl;
    height: $spacing-xl;
    min-width: $spacing-xl;
    border-radius: $border-radius-full;
    background: $color-gray-100;
    border: 2px solid #e9ecef;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    position: relative;
    padding: $spacing-0;
    
    // 플러스/마이너스 아이콘
    &::before,
    &::after {
      content: '';
      position: absolute;
      background: #6c757d;
      transition: all 0.3s ease;
    }
    
    // 가로선 (항상 표시)
    &::before {
      width: $spacing-md - 2px;
      height: 2px;
    }
    
    // 세로선 (접혔을 때만 표시)
    &::after {
      width: 2px;
      height: $spacing-md - 2px;
      opacity: 0;
      transform: rotate(90deg);
    }
    
    // 접힌 상태 (플러스 표시)
    &.collapsed {
      &::after {
        opacity: 1;
        transform: rotate(0deg);
      }
    }
    
    // 호버 효과
    &:hover {
      background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
      border-color: $color-primary;
      transform: scale(1.1);
      box-shadow: 0 4px 12px rgba($color-primary, $opacity-25);
      
      &::before,
      &::after {
        background: white;
      }
    }
    
    // 활성 상태
    &:active {
      transform: scale(0.95);
    }
    
    // 포커스 시 아웃라인 제거
    &:focus {
      outline: none;
    }
  }
  
  .step-content-with-sidebar {
    display: flex;
    gap: $spacing-lg;
    
    .step-content {
      flex: 1;
      min-width: $spacing-0; // flexbox 오버플로우 방지
    }
    
    .recent-plannings-sidebar {
      width: 260px; // 280px에서 260px로 추가 축소
      flex-shrink: 0; // 축소 방지
      background: white;
      border-radius: $border-radius-lg;
      padding: $spacing-md; // 20px에서 16px로 축소
      height: fit-content;
      box-shadow: 0 2px 8px rgba($color-black, 0.08);
      
      // 화면이 좁을 때 숨김
      @media (max-width: 1500px) {
        display: none;
      }
      
      h4 {
        font-size: $font-size-lg;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: $spacing-lg - $spacing-xs;
        padding-bottom: $spacing-sm + $spacing-xs;
        border-bottom: 2px solid #f0f0f0;
      }
      
      .recent-plannings-list {
        display: flex;
        flex-direction: column;
        gap: $spacing-md;
      }
      
      .recent-planning-item {
        display: flex;
        gap: $spacing-sm + $spacing-xs;
        padding: $spacing-md;
        background: $color-background-secondary;
        border-radius: $border-radius-md;
        transition: all 0.2s;
        position: relative;
        
        &:hover {
          background: #f0f2f5;
          
          .delete-planning-btn {
            opacity: 1;
          }
        }
        
        .planning-content {
          display: flex;
          gap: $spacing-sm + $spacing-xs;
          flex: 1;
          cursor: pointer;
          
          &:hover {
            transform: translateX(4px);
          }
        }
        
        .planning-number {
          width: $spacing-xl;
          height: $spacing-xl;
          background: linear-gradient(135deg, $color-primary, $color-primary-dark);
          color: white;
          border-radius: $border-radius-full;
          display: flex;
          align-items: center;
          justify-content: center;
          font-weight: 600;
          font-size: $font-size-sm;
          flex-shrink: 0;
        }
        
        .planning-info {
          flex: 1;
          
          .planning-title {
            font-size: $font-size-sm;
            font-weight: 600;
            color: #1a1a1a;
            margin-bottom: 6px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
          }
          
          .planning-meta {
            .planning-date {
              font-size: $font-size-xs;
              color: $color-gray-600;
              display: block;
              margin-bottom: $spacing-sm;
            }
            
            .planning-tags {
              display: flex;
              gap: 6px;
              flex-wrap: wrap;
              
              .tag {
                font-size: 11px;
                padding: 3px 8px;
                border-radius: $border-radius-lg;
                font-weight: 500;
                
                &.tone {
                  background: #e3f2fd;
                  color: #1976d2;
                }
                
                &.genre {
                  background: #f3e5f5;
                  color: #7b1fa2;
                }
                
                &.target {
                  background: #e8f5e9;
                  color: #388e3c;
                }
              }
            }
          }
          
          .planning-status {
            margin-top: $spacing-sm;
            
            .step-indicator {
              font-size: 11px;
              padding: $spacing-xs 10px;
              border-radius: $border-radius-md - 2px;
              font-weight: 600;
              display: inline-block;
              
              &.step-1 {
                background: #fff3e0;
                color: #e65100;
              }
              
              &.step-2 {
                background: #e8f5e9;
                color: #2e7d32;
              }
              
              &.step-3 {
                background: #e3f2fd;
                color: #1565c0;
              }
              
              &.step-4 {
                background: #f3e5f5;
                color: #6a1b9a;
              }
              
              &.step-5 {
                background: #e0f2f1;
                color: #00695c;
              }
            }
          }
        }
        
        .delete-planning-btn {
          position: absolute;
          top: $spacing-sm;
          right: $spacing-sm;
          width: $spacing-lg;
          height: $spacing-lg;
          border: none;
          background: $color-danger;
          color: white;
          border-radius: $border-radius-full;
          cursor: pointer;
          opacity: 0;
          transition: all 0.2s;
          font-size: $font-size-base;
          font-weight: bold;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: $spacing-0;
          
          &:hover {
            background: #c82$color-gray-800;
            transform: scale(1.1);
          }
        }
      }
      
      .no-recent-plannings {
        text-align: center;
        padding: $spacing-4xl - $spacing-xs 40px;
        background: linear-gradient(135deg, #f0f4ff 0%, #e8edff 100%);
        border: 2px dashed #c7d2fe;
        border-radius: $border-radius-xl;
        margin: $spacing-lg 0;
        position: relative;
        overflow: hidden;
        
        &::before {
          content: "🎬";
          position: absolute;
          top: -20px;
          right: -20px;
          font-size: 120px;
          opacity: 0.1;
          transform: rotate(-15deg);
        }
        
        p {
          color: #4b5563;
          margin-bottom: $spacing-sm + $spacing-xs;
          font-size: $font-size-lg;
          font-weight: 500;
          position: relative;
          z-index: 1;
          
          &.hint {
            color: #6b7280;
            font-size: $font-size-base;
            font-weight: 400;
            margin-top: $spacing-sm;
          }
        }
        
        &::after {
          content: "";
          position: absolute;
          bottom: $spacing-0;
          left: $spacing-0;
          right: $spacing-0;
          height: $spacing-xs;
          background: linear-gradient(90deg, $color-primary 0%, #4318FF 100%);
          opacity: 0.3;
        }
      }
    }
  }
  
  // 통일된 섹션 타이틀 스타일
  .section-title {
    font-size: $font-size-xl;
    font-weight: 700;
    color: $color-gray-900;
    margin-bottom: $spacing-lg;
    position: relative;
    padding-left: $spacing-md;
    
    &::before {
      content: '';
      position: absolute;
      left: $spacing-0;
      top: 50%;
      transform: translateY(-50%);
      width: $spacing-xs;
      height: $spacing-lg;
      background: linear-gradient(135deg, $color-primary 0%, #4318FF 100%);
      border-radius: $border-radius-sm / 2;
    }
  }

  .planning-content-section {
    margin-bottom: $spacing-xl;
    
    .planning-input {
      margin-top: -8px;
    }
  }

  .planning-header {
    text-align: center;
    margin-bottom: $spacing-2xl;
    padding: $spacing-2xl;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    border-radius: $border-radius-xl;
    box-shadow: 0 4px 12px rgba($color-black, 0.05);

    h2 {
      font-size: 28px;
      font-weight: 700;
      color: $color-gray-800;
      margin-bottom: $spacing-sm + $spacing-xs;
    }

    p {
      font-size: $font-size-base;
      color: $color-gray-600;
    }
  }

  // 최근 기획안 섹션
  .recent-plannings-section {
    background: $color-white;
    border: 1px solid #e5e7eb;
    border-radius: $border-radius-xl;
    padding: $spacing-lg;
    margin-bottom: $spacing-lg;
    box-shadow: 0 1px 3px rgba($color-black, 0.05);
    
    .recent-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: $spacing-lg - $spacing-xs;
      
      h3 {
        font-size: $font-size-xl;
        font-weight: 600;
        color: #1a1a1a;
        margin: $spacing-0;
        display: flex;
        align-items: center;
        gap: $spacing-sm;
      }
      
      .recent-count {
        font-size: $font-size-sm;
        color: #6b7280;
        background: #f3f4f6;
        padding: $spacing-xs 12px;
        border-radius: 20px;
      }
    }
    
    .recent-list {
      display: grid;
      gap: $spacing-md;
      
      .recent-item {
        display: flex;
        gap: $spacing-md;
        padding: $spacing-md;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: $border-radius-lg;
        transition: all 0.2s ease;
        position: relative;
        
        &:hover {
          background: #f3f4f6;
          border-color: #4318FF;
          box-shadow: 0 4px 12px rgba(67, 24, 255, 0.1);
          
          .delete-planning-btn {
            opacity: 1;
          }
        }
        
        .recent-content {
          display: flex;
          gap: $spacing-md;
          flex: 1;
          cursor: pointer;
          
          &:hover {
            transform: translateY(-1px);
          }
        }
        
        .recent-number {
          width: $spacing-xl + $spacing-xs;
          height: $spacing-xl + $spacing-xs;
          background: linear-gradient(135deg, $color-primary, $color-primary-dark);
          color: white;
          border-radius: $border-radius-full;
          display: flex;
          align-items: center;
          justify-content: center;
          font-weight: 600;
          font-size: $font-size-base;
          flex-shrink: 0;
        }
        
        .recent-info {
          flex: 1;
          
          .recent-title {
            font-size: $font-size-base;
            font-weight: 600;
            color: #1a1a1a;
            margin-bottom: $spacing-sm;
            line-height: 1.4;
          }
          
          .recent-meta {
            .recent-date {
              font-size: 13px;
              color: #6b7280;
              margin-bottom: $spacing-sm;
              display: block;
            }
            
            .recent-tags {
              display: flex;
              gap: $spacing-sm;
              flex-wrap: wrap;
              
              .tag {
                font-size: $font-size-xs;
                padding: 3px 10px;
                border-radius: $border-radius-lg;
                font-weight: 500;
                
                &.tone {
                  background: #e0f2fe;
                  color: #0369a1;
                }
                
                &.genre {
                  background: #f3e8ff;
                  color: #7c3aed;
                }
                
                &.step {
                  background: #ecfccb;
                  color: #365314;
                  
                  &.step-1 {
                    background: #dbeafe;
                    color: #1e40af;
                  }
                  
                  &.step-2 {
                    background: #dcfce7;
                    color: #166534;
                  }
                  
                  &.step-3 {
                    background: #fed7aa;
                    color: #9a3412;
                  }
                  
                  &.step-4 {
                    background: #e9d5ff;
                    color: #6b21a8;
                  }
                  
                  &.step-5 {
                    background: #fecaca;
                    color: #991b1b;
                  }
                }
              }
            }
          }
        }
        
        .recent-actions {
          position: absolute;
          top: $spacing-sm + $spacing-xs;
          right: $spacing-sm + $spacing-xs;
          display: flex;
          gap: $spacing-sm;
          opacity: 0;
          transition: all 0.2s;
        }

        &:hover .recent-actions {
          opacity: 1;
        }

        .pdf-download-btn {
          border: none;
          background: $color-primary;
          color: white;
          border-radius: $border-radius-md - 2px;
          cursor: pointer;
          transition: all 0.2s;
          font-size: 13px;
          font-weight: 500;
          display: flex;
          align-items: center;
          gap: $spacing-xs;
          padding: 6px 12px;
          
          &:hover {
            background: $color-primary-dark;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba($color-primary, 0.3);
          }
        }

        .delete-planning-btn {
          width: $spacing-lg + $spacing-xs;
          height: $spacing-lg + $spacing-xs;
          border: none;
          background: $color-danger;
          color: white;
          border-radius: $border-radius-md - 2px;
          cursor: pointer;
          transition: all 0.2s;
          font-size: $font-size-base;
          font-weight: bold;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: $spacing-0;
          
          &:hover {
            background: #c82$color-gray-800;
            transform: scale(1.1);
          }
        }
      }
    }
  }

  .planning-history-section {
    background: $color-background-secondary;
    border-radius: $border-radius-lg;
    padding: $spacing-lg;
    margin-bottom: $spacing-xl;
    
    .history-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: $spacing-md;
      
      h3 {
        font-size: $font-size-lg;
        font-weight: 600;
        color: #1a1a1a;
        margin: $spacing-0;
      }
      
      .history-count {
        font-size: $font-size-sm;
        color: $color-gray-600;
        background: white;
        padding: $spacing-xs 12px;
        border-radius: 20px;
        font-weight: 500;
      }
    }
    
    .history-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: $spacing-sm + $spacing-xs;
      
      .history-item {
        background: white;
        padding: $spacing-md;
        border-radius: $border-radius-md;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid #e5e7eb;
        
        &:hover {
          border-color: #3b82f6;
          box-shadow: 0 2px 8px rgba(59, 130, 246, 0.1);
          transform: translateY(-1px);
        }
        
        .history-title {
          font-size: 15px;
          font-weight: 500;
          color: #1a1a1a;
          margin-bottom: $spacing-sm;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        
        .history-date {
          font-size: 13px;
          color: #9ca3af;
        }
      }
    }
  }

  .planning-navigation {
    display: flex;
    justify-content: center;
    margin-bottom: $spacing-2xl;
    background: $color-gray-100;
    border-radius: $border-radius-md;
    padding: $spacing-lg - $spacing-xs;

    .nav-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: $spacing-0 30px;
      cursor: pointer;
      transition: all 0.3s ease;

      .step-number {
        width: $spacing-3xl + 2px;
        height: $spacing-3xl + 2px;
        border-radius: $border-radius-full;
        background: #e0e0e0;
        color: $color-gray-500;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-bottom: $spacing-sm;
        transition: all 0.3s ease;
        font-size: $font-size-lg;
      }

      .step-name {
        font-size: $font-size-sm;
        color: $color-gray-500;
        transition: all 0.3s ease;
      }

      &.active {
        .step-number {
          background: #4a90e2;
          color: white;
        }

        .step-name {
          color: $color-gray-800;
          font-weight: 500;
        }
      }

      &.current {
        .step-number {
          background: #2c5aa0;
          color: white;
          box-shadow: 0 0 0 4px rgba(44, 90, 160, 0.2);
        }

        .step-name {
          color: #2c5aa0;
          font-weight: bold;
        }
      }

      &.disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }

      &:hover:not(.disabled) {
        transform: translateY(-2px);
      }
    }
  }

  .planning-steps {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: $spacing-3xl + 2px;
    padding: $spacing-0 20px;

    .step {
      display: flex;
      align-items: center;
      position: relative;
      opacity: 0.5;
      transition: opacity 0.3s ease;

      &.active {
        opacity: 1;
      }

      &:not(:last-child) {
        &::after {
          content: '';
          position: absolute;
          right: -60px;
          width: $spacing-3xl + 2px;
          height: 2px;
          background: #e0e0e0;
        }

        margin-right: 120px;
      }

      .step-number {
        width: $spacing-2xl;
        height: $spacing-2xl;
        border-radius: $border-radius-full;
        background: #e0e0e0;
        color: $color-gray-500;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        margin-right: $spacing-sm + $spacing-xs;
        transition: all 0.3s ease;
      }

      .step-name {
        font-size: $font-size-base;
        font-weight: 600;
        color: $color-gray-600;
        transition: color 0.3s ease;
      }

      &.active {
        .step-number {
          background: linear-gradient(135deg, $color-primary, $color-primary-dark);
          color: white;
        }

        .step-name {
          color: $color-gray-800;
        }
      }
    }
  }

  .step-content {
    max-width: 1400px; // 1200px에서 1400px로 확대
    margin: $spacing-0 auto;
    background: white;
    border-radius: $border-radius-lg;
    padding: $spacing-2xl;
    box-shadow: 0 2px 10px rgba($color-black, 0.08);
    
    // 사이드바가 없을 때는 더 넓게
    @media (max-width: 1600px) {
      max-width: 100%;
    }

    h3 {
      font-size: $font-size-2xl;
      font-weight: 700;
      color: $color-gray-800;
      margin-bottom: $spacing-sm + $spacing-xs;
    }

    .step-description {
      font-size: $font-size-base;
      color: $color-gray-600;
      margin-bottom: $spacing-lg + 6px;
      line-height: 1.6;
      background: #f0f4ff;
      padding: $spacing-lg - $spacing-xs;
      border-radius: $border-radius-lg;
      border-left: $spacing-xs solid $color-primary;
      box-shadow: 0 2px 4px rgba($color-black, 0.05);
    }

    .recent-scenarios {
      background: $color-background-secondary;
      border-radius: $border-radius-lg;
      padding: $spacing-lg - $spacing-xs;
      margin-bottom: $spacing-lg;

      h4 {
        font-size: $font-size-base;
        color: $color-gray-800;
        margin-bottom: $spacing-sm + $spacing-xs;
        font-weight: 600;
      }

      .recent-scenarios-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: $spacing-sm + $spacing-xs;

        .recent-scenario-item {
          background: white;
          border: 1px solid #e0e0e0;
          border-radius: $border-radius-md;
          padding: $spacing-sm + $spacing-xs 16px;
          cursor: pointer;
          transition: all 0.2s ease;

          &:hover {
            border-color: #4a90e2;
            box-shadow: 0 2px 8px rgba(74, 144, 226, 0.1);
          }

          .scenario-title {
            font-size: $font-size-sm;
            color: $color-gray-800;
            font-weight: 500;
            margin-bottom: $spacing-xs;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
          }

          .scenario-date {
            font-size: $font-size-xs;
            color: $color-gray-500;
          }
        }
      }
    }

    .planning-options {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: $spacing-lg - $spacing-xs;
      margin-bottom: $spacing-lg;
      padding: $spacing-lg - $spacing-xs;
      background: $color-background-secondary;
      border-radius: $border-radius-lg;
      
      // 화면 크기에 따른 반응형 그리드
      @media (max-width: 1200px) {
        grid-template-columns: repeat(2, 1fr);
      }
      
      @media (max-width: $breakpoint-md) {
        grid-template-columns: 1fr;
      }

      .option-group {
        display: flex;
        flex-direction: column;
        gap: $spacing-sm;

        label {
          font-size: $font-size-sm;
          font-weight: 600;
          color: $color-gray-800;
        }

        select {
          padding: $spacing-sm + 2px 12px;
          border: 2px solid #e0e0e0;
          border-radius: $border-radius-md;
          font-size: $font-size-sm;
          background: white;
          cursor: pointer;
          transition: all 0.2s ease;

          &:hover {
            border-color: #4a90e2;
          }

          &:focus {
            outline: none;
            border-color: #012$color-white;
            box-shadow: 0 0 0 3px rgba(1, 47, 255, 0.1);
          }
        }
      }
    }

    .planning-input {
      width: 100%;
      padding: $spacing-lg - $spacing-xs;
      border: 2px solid #e0e0e0;
      border-radius: $border-radius-md;
      font-size: $font-size-base;
      line-height: 1.6;
      resize: vertical;
      transition: border-color 0.3s ease;
      font-family: inherit;

      &:focus {
        outline: none;
        border-color: #012$color-white;
      }
    }
    
    .planning-actions {
      margin-top: $spacing-lg - $spacing-xs;
      
      .planning-title-input {
        width: 100%;
        padding: $spacing-sm + $spacing-xs 16px;
        margin-bottom: $spacing-md;
        margin-top: -8px;
        border: 2px solid #e0e0e0;
        border-radius: $border-radius-md;
        font-size: 15px;
        transition: border-color 0.3s ease;
        
        &:focus {
          outline: none;
          border-color: #012$color-white;
        }
      }
      
      .button-group {
        display: flex;
        gap: $spacing-sm + $spacing-xs;
        justify-content: center;
      }
    }

    .generate-btn, .save-btn {
      padding: $spacing-md - 2px 32px;
      background: linear-gradient(135deg, $color-primary, $color-primary-dark);
      color: white;
      border: none;
      border-radius: $border-radius-md;
      font-size: $font-size-base;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      min-width: 140px;
      height: $spacing-3xl;
      display: inline-flex;
      align-items: center;
      justify-content: center;

      &:hover:not(:disabled) {
        background: linear-gradient(135deg, $color-primary-dark, #0A1A99);
        transform: translateY(-1px);
      }

      &:disabled {
        background: $color-gray-400;
        cursor: not-allowed;
      }
    }
    
    .save-btn {
      background: linear-gradient(135deg, $color-primary, $color-primary-dark);
      
      &:hover:not(:disabled) {
        background: linear-gradient(135deg, $color-primary-dark, #0A1A99);
      }
    }
  }

  .result-box {
    background: $color-background-secondary;
    border-radius: $border-radius-md;
    padding: $spacing-lg + 6px;
    margin-bottom: $spacing-lg + 6px;

    h4 {
      font-size: $font-size-xl;
      font-weight: 700;
      color: $color-gray-800;
      margin-bottom: $spacing-lg - $spacing-xs;
    }

    .structure-content {
      h5 {
        font-size: $font-size-lg;
        font-weight: 600;
        color: #012$color-white;
        margin-bottom: $spacing-lg - $spacing-xs;
      }

      .sections {
        .section-item {
          background: white;
          padding: $spacing-lg - $spacing-xs;
          border-radius: $border-radius-md;
          margin-bottom: $spacing-md - 1px;
          border: 1px solid #e0e0e0;

          h6 {
            font-size: $font-size-base;
            font-weight: 600;
            color: $color-gray-800;
            margin-bottom: $spacing-sm + 2px;
          }

          p {
            font-size: 15px;
            color: $color-gray-600;
            line-height: 1.6;
            margin-bottom: $spacing-sm + 2px;
          }

          .duration {
            font-size: $font-size-sm;
            color: $color-gray-500;
            font-style: italic;
          }
        }
      }
    }

    .story-content {
      .story-text {
        background: white;
        padding: 25px;
        border-radius: $border-radius-md;
        font-size: $font-size-base;
        line-height: 1.8;
        color: #444;
        margin-bottom: $spacing-lg - $spacing-xs;
        white-space: pre-wrap;
      }

      .story-details {
        p {
          font-size: 15px;
          color: $color-gray-600;
          margin-bottom: $spacing-sm;

          strong {
            color: $color-gray-800;
            margin-right: $spacing-sm;
          }
        }
      }
    }

    .shots-content {
      .shots-list {
        .shot-item {
          background: white;
          padding: $spacing-lg - $spacing-xs;
          border-radius: $border-radius-md;
          margin-bottom: $spacing-md - 1px;
          border: 1px solid #e0e0e0;

          .shot-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: $spacing-sm + $spacing-xs;

            .shot-number {
              font-size: $font-size-sm;
              font-weight: 700;
              color: #012$color-white;
            }

            .shot-type {
              font-size: 13px;
              padding: $spacing-xs 12px;
              background: #e8f0ff;
              color: #012$color-white;
              border-radius: $border-radius-sm;
              font-weight: 600;
            }
          }

          .shot-description {
            font-size: 15px;
            color: #444;
            line-height: 1.6;
            margin-bottom: $spacing-sm + $spacing-xs;
          }

          .shot-details {
            display: flex;
            gap: $spacing-lg - $spacing-xs;

            span {
              font-size: $font-size-sm;
              color: $color-gray-600;
            }
          }
        }
      }
    }
  }

  .planning-summary-section {
    background: white;
    border-radius: $border-radius-lg;
    padding: $spacing-lg - $spacing-xs;
    margin-bottom: $spacing-lg;
    box-shadow: 0 2px 8px rgba($color-black, 0.08);

    .planning-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: $spacing-md;

      h4 {
        margin: $spacing-0;
        color: $color-gray-800;
        font-size: $font-size-lg;
      }

      .toggle-detail-btn {
        padding: 6px 16px;
        background: #f0f0f0;
        border: none;
        border-radius: $border-radius-md - 2px;
        cursor: pointer;
        font-size: $font-size-sm;
        transition: all 0.2s;

        &:hover {
          background: #e0e0e0;
        }
      }
    }

    .planning-content {
      transition: all 0.3s ease;

      &.collapsed {
        .planning-text {
          max-height: $spacing-4xl - $spacing-xs;
          overflow: hidden;
          position: relative;

          &::after {
            content: '';
            position: absolute;
            bottom: $spacing-0;
            left: $spacing-0;
            right: $spacing-0;
            height: $spacing-lg - $spacing-xs;
            background: linear-gradient(to bottom, transparent, white);
          }
        }
      }

      &.expanded {
        .planning-text {
          max-height: none;
        }
      }

      .planning-text {
        color: $color-gray-600;
        line-height: 1.6;
        white-space: pre-wrap;
        margin-bottom: $spacing-md;
      }

      .planning-options-detail {
        border-top: 1px solid $color-gray-200;
        padding-top: $spacing-md;

        h5 {
          margin: $spacing-0 0 12px;
          color: $color-gray-800;
          font-size: $font-size-base;
        }

        .options-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
          gap: $spacing-sm + $spacing-xs;

          .option-item {
            display: flex;
            align-items: center;
            gap: $spacing-sm;

            .option-label {
              font-weight: 600;
              color: #555;
            }

            .option-value {
              color: #4a90e2;
            }
          }
        }
      }
    }
  }

  .stories-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: $spacing-lg - $spacing-xs;
    margin-bottom: $spacing-lg + 6px;

    .story-card {
      background: $color-background-secondary;
      border: 2px solid #e0e0e0;
      border-radius: $border-radius-lg;
      padding: $spacing-lg - $spacing-xs;
      cursor: pointer;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;

      &:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba($color-black, 0.1);
        border-color: #4a90e2;
      }

      &.expanded {
        background: #e3f2fd;
        border-color: #4a90e2;
      }

      &.selected {
        border-color: #4a90e2;
        background: #e3f2fd;
      }

      .story-stage-badge {
        background: #2c5aa0;
        color: white;
        padding: $spacing-sm 16px;
        border-radius: $border-radius-md;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: $spacing-5xl;

        .stage-label {
          font-size: $font-size-2xl;
          font-weight: bold;
          line-height: 1;
        }

        .stage-name {
          font-size: $font-size-xs;
          margin-top: 2px;
        }
      }

      h4 {
        color: #4a90e2;
        margin-bottom: $spacing-sm + 2px;
      }

      .story-title {
        font-weight: bold;
        font-size: $font-size-lg;
        margin-bottom: $spacing-sm + $spacing-xs;
        margin-right: 100px;
        color: $color-gray-800;
      }

      .story-summary {
        color: $color-gray-600;
        line-height: 1.6;
        margin-bottom: $spacing-md;
      }

      .story-meta {
        margin-bottom: $spacing-sm + $spacing-xs;
        font-size: $font-size-sm;
        color: #555;

        span {
          display: block;
          padding: $spacing-sm 0;
        }
      }

      .story-characters {
        font-size: 13px;
        color: #777;
        font-style: italic;
      }

      .expand-indicator {
        position: absolute;
        bottom: $spacing-sm + 2px;
        right: $spacing-sm + 2px;
        font-size: $font-size-xs;
        color: #4a90e2;
        font-weight: 600;
      }
      
      .expand-toggle-btn {
        width: auto;
        display: inline-block;
        margin-top: $spacing-md;
        padding: $spacing-sm + 2px 24px;
        background: #4a90e2;
        color: white;
        border: none;
        border-radius: $border-radius-md;
        cursor: pointer;
        font-size: $font-size-sm;
        font-weight: 500;
        transition: all 0.2s ease;
        
        &:hover {
          background: #357abd;
          transform: translateY(-1px);
        }
        
        &:active {
          transform: translateY(0);
        }
      }
      
      .full-summary {
        .detailed-content {
          margin-top: $spacing-md;
          padding: $spacing-md;
          background: rgba($color-white, 0.7);
          border-radius: $border-radius-md;
          
          h5 {
            margin: $spacing-0 0 8px 0;
            color: $color-gray-800;
            font-size: $font-size-sm;
            font-weight: 600;
          }
          
          p {
            margin: $spacing-0;
            line-height: 1.5;
          }
        }
      }

      .story-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: $spacing-sm + $spacing-xs;
        
        .story-header-buttons {
          display: flex;
          gap: $spacing-sm;
          align-items: center;
        }
        
        .toggle-story-btn {
          background: #6c757d;
          color: white;
          border: none;
          padding: 6px 8px;
          border-radius: $border-radius-md - 2px;
          font-size: $font-size-sm;
          cursor: pointer;
          transition: all 0.2s ease;
          display: flex;
          align-items: center;
          justify-content: center;
          min-width: $spacing-xl;
          height: $spacing-xl;
          
          &:hover {
            background: #5a6268;
            transform: translateY(-1px);
          }
        }
        
        .edit-story-btn {
          background: linear-gradient(135deg, $color-primary, $color-primary-dark);
          color: white;
          border: none;
          padding: 6px 12px;
          border-radius: $border-radius-md - 2px;
          font-size: $font-size-xs;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.2s ease;
          display: flex;
          align-items: center;
          gap: $spacing-xs;
          
          &:hover {
            background: linear-gradient(135deg, $color-primary-dark, #0A1A99);
            transform: translateY(-1px);
          }
          
          &:disabled {
            opacity: 0.6;
            cursor: not-allowed;
          }
        }
      }

      .edit-story-form {
        .edit-story-textarea {
          width: 100%;
          min-height: 120px;
          padding: $spacing-sm + $spacing-xs 16px;
          border: 2px solid #e0e0e0;
          border-radius: $border-radius-md;
          font-size: $font-size-sm;
          line-height: 1.6;
          resize: vertical;
          transition: all 0.2s ease;
          
          &:focus {
            outline: none;
            border-color: #4318FF;
            box-shadow: 0 0 0 3px rgba(67, 24, 255, 0.1);
          }
          
          &::placeholder {
            color: $color-gray-500;
          }
        }
        
        .edit-story-buttons {
          display: flex;
          gap: $spacing-sm + $spacing-xs;
          margin-top: $spacing-sm + $spacing-xs;
          
          .save-story-btn {
            background: #4caf50;
            color: white;
            border: none;
            padding: $spacing-sm 16px;
            border-radius: $border-radius-md - 2px;
            font-size: $font-size-sm;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            
            &:hover {
              background: #45a049;
            }
          }
          
          .cancel-story-btn {
            background: #f44336;
            color: white;
            border: none;
            padding: $spacing-sm 16px;
            border-radius: $border-radius-md - 2px;
            font-size: $font-size-sm;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            
            &:hover {
              background: #da190b;
            }
          }
        }
      }
    }
  }

  .story-framework-section {
    margin-top: $spacing-xl;
    padding: $spacing-lg;
    background: $color-background-secondary;
    border-radius: $border-radius-lg;

    .framework-options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: $spacing-md;
      margin-bottom: $spacing-xl;

      .framework-card {
        padding: $spacing-lg - $spacing-xs;
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: $border-radius-lg - 2px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;

        &:hover {
          transform: translateY(-2px);
          box-shadow: 0 4px 12px rgba($color-black, 0.1);
          border-color: #4a90e2;
        }

        &.active {
          border-color: #012$color-white;
          background: #f0f7ff;

          &::after {
            content: '✓';
            position: absolute;
            top: $spacing-sm + $spacing-xs;
            right: $spacing-sm + $spacing-xs;
            width: $spacing-lg;
            height: $spacing-lg;
            background: linear-gradient(135deg, $color-primary, $color-primary-dark);
            color: white;
            border-radius: $border-radius-full;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
          }
        }

        h5 {
          font-size: $font-size-base;
          font-weight: 600;
          color: $color-gray-800;
          margin-bottom: $spacing-sm;
        }

        p {
          font-size: $font-size-sm;
          color: $color-gray-600;
          line-height: 1.5;
          margin-bottom: $spacing-sm + $spacing-xs;
        }

        .framework-stages {
          font-size: 13px;
          color: $color-gray-500;
          background: $color-gray-100;
          padding: 6px 12px;
          border-radius: 20px;
          display: inline-block;
        }
      }
    }

    .development-level {
      background: white;
      padding: $spacing-lg;
      border-radius: $border-radius-lg - 2px;
      border: 1px solid #e0e0e0;

      .level-buttons {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: $spacing-sm + $spacing-xs;

        .level-btn {
          padding: $spacing-md 12px;
          background: white;
          border: 2px solid #e0e0e0;
          border-radius: $border-radius-lg - 2px;
          cursor: pointer;
          transition: all 0.3s ease;
          text-align: center;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: $spacing-sm;

          &:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba($color-black, 0.1);
          }

          // 그대로 버튼 - 회색 계열
          &:nth-child(1) {
            border-color: #9e9e9e;
            
            &:hover {
              border-color: #757575;
              background: $color-gray-100;
            }
            
            &.active {
              border-color: #9e9e9e;
              background: $color-gray-100;
              
              .level-name {
                color: #616161;
                font-weight: 600;
              }
            }
          }

          // 가벼움 버튼 - 파란색 계열
          &:nth-child(2) {
            border-color: #42a5f5;
            
            &:hover {
              border-color: #1e88e5;
              background: #e3f2fd;
            }
            
            &.active {
              border-color: #42a5f5;
              background: #e3f2fd;
              
              .level-name {
                color: #1565c0;
                font-weight: 600;
              }
            }
          }

          // 균형 버튼 - 보라색 계열 (기본 브랜드 컬러)
          &:nth-child(3) {
            border-color: #4318FF;
            
            &:hover {
              border-color: #3311dd;
              background: #f0f4ff;
            }
            
            &.active {
              border-color: #4318FF;
              background: #f0f4ff;
              
              .level-name {
                color: #4318FF;
                font-weight: 600;
              }
            }
          }

          // 상세 버튼 - 주황색 계열
          &:nth-child(4) {
            border-color: #ff8a50;
            
            &:hover {
              border-color: #ff6f00;
              background: #fff3e0;
            }
            
            &.active {
              border-color: #ff8a50;
              background: #fff3e0;
              
              .level-name {
                color: #e65100;
                font-weight: 600;
              }
            }
          }

          .level-icon {
            display: none; /* 이모지 아이콘 숨김 */
          }

          .level-name {
            font-size: 15px;
            font-weight: 500;
            color: $color-gray-800;
          }

          .level-desc {
            font-size: $font-size-xs;
            color: $color-gray-600;
          }
        }
      }
    }

    .character-settings {
      background: $color-white;
      padding: $spacing-xl;
      border-radius: $border-radius-xl;
      border: 1px solid #e5e7eb;
      margin-top: $spacing-xl;
      box-shadow: 0 1px 3px rgba($color-black, 0.05);
      position: relative;
      transition: all 0.3s ease;

      &:hover {
        border-color: #d1d5db;
        box-shadow: 0 4px 6px rgba($color-black, 0.07);
      }


      .character-settings-content {
        display: flex;
        gap: $spacing-lg;
        align-items: flex-start;

        @media (max-width: $breakpoint-md) {
          flex-direction: column;
        }

        .character-input-group {
          flex: 1;
          display: flex;
          flex-direction: column;
          gap: $spacing-lg - $spacing-xs;

          .character-name-input {
            width: 100%;
            padding: $spacing-md - 2px 18px;
            border: 1px solid #e5e7eb;
            border-radius: $border-radius-md;
            font-size: $font-size-base;
            transition: all 0.2s ease;
            background: $color-white;
            font-weight: 500;

            &:focus {
              outline: none;
              border-color: $color-primary;
              box-shadow: 0 0 0 3px rgba($color-primary, 0.08);
            }

            &::placeholder {
              color: #9ca3af;
              font-size: 15px;
              font-weight: 400;
            }
          }

          .character-description-input {
            width: 100%;
            padding: $spacing-md - 2px 18px;
            border: 1px solid #e5e7eb;
            border-radius: $border-radius-md;
            font-size: 15px;
            resize: vertical;
            min-height: 120px;
            font-family: inherit;
            transition: all 0.2s ease;
            background: $color-white;
            line-height: 1.6;

            &:focus {
              outline: none;
              border-color: $color-primary;
              box-shadow: 0 0 0 3px rgba($color-primary, 0.08);
            }

            &::placeholder {
              color: #9ca3af;
              font-size: 15px;
              font-weight: 400;
            }
          }
        }

        .character-image-upload {
          width: 180px;
          flex-shrink: 0;

          .image-upload-label {
            cursor: pointer;
            display: block;

            input[type="file"] {
              display: none;
            }

            .upload-button {
              width: 180px;
              height: 180px;
              border: 2px dashed #e5e7eb;
              border-radius: $border-radius-lg;
              display: flex;
              flex-direction: column;
              align-items: center;
              justify-content: center;
              gap: $spacing-sm;
              background: #f9fafb;
              transition: all 0.2s ease;
              position: relative;
              overflow: hidden;

              &:hover {
                border-color: $color-primary;
                background: #f0f4ff;
                transform: scale(1.02);
              }

              .upload-icon {
                font-size: 32px;
                color: #9ca3af;
              }

              .upload-text {
                font-size: 13px;
                color: #6b7280;
                text-align: center;
                padding: $spacing-0 10px;
                font-weight: 500;
                line-height: 1.4;
              }

              .image-preview {
                width: 100%;
                height: 100%;
                position: relative;

                img {
                  width: 100%;
                  height: 100%;
                  object-fit: cover;
                  border-radius: $border-radius-lg - 2px;
                }

                .change-image {
                  position: absolute;
                  bottom: $spacing-0;
                  left: $spacing-0;
                  right: $spacing-0;
                  background: rgba($color-black, 0.7);
                  color: white;
                  padding: $spacing-sm;
                  font-size: $font-size-xs;
                  text-align: center;
                  opacity: 0;
                  transition: opacity 0.3s ease;
                }

                &:hover .change-image {
                  opacity: 1;
                }
              }
            }
          }

          .remove-image-btn {
            width: 100%;
            margin-top: $spacing-sm;
            padding: $spacing-sm 12px;
            background: $color-white;
            color: $color-danger;
            border: 1px solid $color-danger;
            border-radius: $border-radius-md - 2px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;

            &:hover {
              background: $color-danger;
              color: white;
            }
          }
        }
      }
    }
  }

  .storyboard-style-selector {
    background: $color-background-secondary;
    padding: $spacing-lg - $spacing-xs;
    border-radius: $border-radius-lg;
    margin-bottom: $spacing-lg;

    label {
      display: block;
      font-size: $font-size-base;
      font-weight: 600;
      color: $color-gray-800;
      margin-bottom: $spacing-md;
    }

    .style-select {
      width: 100%;
      padding: $spacing-sm + $spacing-xs;
      border: 2px solid #e0e0e0;
      border-radius: $border-radius-md;
      font-size: $font-size-sm;
      background: white;
      cursor: pointer;
      transition: all 0.2s ease;

      &:hover {
        border-color: #4a90e2;
      }

      &:focus {
        outline: none;
        border-color: #012$color-white;
        box-shadow: 0 0 0 3px rgba(1, 47, 255, 0.1);
      }
    }

    .style-options-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: $spacing-sm + $spacing-xs;

      .style-option {
        padding: $spacing-md 12px;
        border: 2px solid;
        background: white;
        border-radius: $border-radius-lg - 2px;
        font-size: $font-size-sm;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: $spacing-xs;
        min-height: $spacing-5xl;
        justify-content: center;

        &::before {
          content: '';
          position: absolute;
          top: $spacing-0;
          left: $spacing-0;
          right: $spacing-0;
          bottom: $spacing-0;
          background: currentColor;
          opacity: 0;
          transition: opacity 0.3s ease;
        }

        .style-name {
          font-weight: 600;
          font-size: 15px;
          display: block;
          position: relative;
          z-index: 1;
        }

        .style-desc {
          font-size: $font-size-xs;
          opacity: 0.8;
          display: block;
          position: relative;
          z-index: 1;
        }

        &:hover:not(.active) {
          transform: translateY(-2px);
          box-shadow: 0 4px 12px rgba($color-black, 0.15);
          
          &::before {
            opacity: 0.1;
          }
        }

        &.active {
          color: white;
          border-width: 3px;

          &::before {
            opacity: 1;
          }

          .style-name,
          .style-desc {
            color: white;
          }
        }
      }
    }
  }

  .scenes-with-storyboards-container {
    display: flex;
    flex-direction: column;
    gap: $spacing-lg;
    margin-bottom: $spacing-lg + 6px;

    .scene-with-storyboard {
      display: flex;
      gap: $spacing-lg - $spacing-xs;
      align-items: stretch;

      .storyboard-section {
        flex: 0 0 300px;
        background: $color-background-secondary;
        border-radius: $border-radius-lg;
        overflow: hidden;
        border: 2px solid #e0e0e0;

        .storyboard-content {
          height: 100%;
          display: flex;
          flex-direction: column;

          .storyboard-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background: $color-gray-800;
          }

          .storyboard-placeholder {
            width: 100%;
            height: 200px;
            background: #e0e0e0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: $color-gray-500;
            font-size: $font-size-base;
          }

          .storyboard-info {
            padding: $spacing-md;
            font-size: $font-size-sm;
            color: $color-gray-600;
            line-height: 1.6;
            position: relative;

            .storyboard-description-kr {
              font-size: $font-size-base;
              color: $color-gray-800;
              font-weight: 500;
              margin-bottom: $spacing-sm + $spacing-xs;
              padding: $spacing-sm + 2px 14px;
              background: $color-background-secondary;
              border-left: 3px solid #4a90e2;
              border-radius: $border-radius-sm;
              line-height: 1.5;
            }

            .storyboard-actions {
              display: flex;
              gap: $spacing-sm;
              margin-top: $spacing-sm + $spacing-xs;
            }

            .edit-storyboard-btn,
            .regenerate-storyboard-btn,
            .download-storyboard-btn {
              padding: $spacing-sm 16px;
              background: #f0f0f0;
              color: $color-gray-800;
              border: 1px solid $color-gray-300;
              border-radius: $border-radius-sm;
              font-size: 13px;
              cursor: pointer;
              transition: all 0.2s ease;
              display: inline-block;

              &:hover {
                background: #e0e0e0;
                border-color: $color-gray-400;
              }

              &:active {
                transform: translateY(1px);
              }

              &:disabled {
                opacity: 0.6;
                cursor: not-allowed;
              }
            }

            .edit-storyboard-btn {
              background: #ff9800;
              color: white;
              border-color: #ff9800;
              
              &:hover {
                background: #f57c00;
                border-color: #f57c00;
              }
            }

            .regenerate-storyboard-btn {
              background: #4CAF50;
              color: white;
              border-color: #4CAF50;
              
              &:hover {
                background: #45a049;
                border-color: #45a049;
              }
            }

            .storyboard-edit-mode {
              width: 100%;

              .storyboard-edit-input {
                width: 100%;
                padding: $spacing-sm;
                border: 1px solid $color-gray-300;
                border-radius: $border-radius-sm;
                font-size: 13px;
                resize: vertical;
                font-family: inherit;
                margin-bottom: $spacing-sm;

                &:focus {
                  outline: none;
                  border-color: #4a90e2;
                }
              }

              .edit-actions {
                display: flex;
                gap: $spacing-sm;

                button {
                  padding: 6px 16px;
                  font-size: 13px;
                  border: none;
                  border-radius: $border-radius-sm;
                  cursor: pointer;
                  transition: all 0.2s;

                  &.save-edit-btn {
                    background: #4caf50;
                    color: white;

                    &:hover {
                      background: #45a049;
                    }
                  }

                  &.cancel-edit-btn {
                    background: #f44336;
                    color: white;

                    &:hover {
                      background: #da190b;
                    }
                  }
                }
              }
            }
          }
        }

        .storyboard-empty {
          height: 100%;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: $spacing-lg - $spacing-xs;

          .generate-storyboard-btn {
            padding: $spacing-sm + $spacing-xs 24px;
            background: #4a90e2;
            color: white;
            border: none;
            border-radius: $border-radius-md;
            font-size: $font-size-sm;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;

            &:hover:not(:disabled) {
              background: #357abd;
              transform: translateY(-1px);
            }

            &:disabled {
              background: $color-gray-400;
              cursor: not-allowed;
            }
          }
        }
      }

      .scene-card {
        flex: 1;
      }
    }
  }

  .scenes-container {
    display: flex;
    flex-direction: column;
    gap: $spacing-lg - $spacing-xs;
    margin-bottom: $spacing-lg + 6px;

    .scene-card {
      background: $color-white;
      border: 2px solid #e0e0e0;
      border-radius: $border-radius-lg;
      padding: $spacing-lg;
      cursor: pointer;
      transition: all 0.3s ease;

      &:hover {
        transform: translateX(4px);
        box-shadow: 0 2px 8px rgba($color-black, 0.1);
      }

      &.selected {
        border-color: #4a90e2;
        background: #f0f8ff;
      }

      .scene-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: $spacing-md;

        h4 {
          color: #2c5aa0;
          font-size: $font-size-lg;
        }

        .scene-time {
          background: #ffd54f;
          color: #795548;
          padding: 6px 12px;
          border-radius: 20px;
          font-size: $font-size-sm;
          font-weight: 500;
        }

        .scene-stage {
          background: #e3f2fd;
          color: #1976d2;
          padding: 6px 12px;
          border-radius: 20px;
          font-size: 13px;
          font-weight: 500;
          margin-left: $spacing-sm;
        }
      }

      .scene-description {
        color: $color-gray-800;
        line-height: 1.8;
        margin-bottom: $spacing-md;
        font-size: 15px;
      }

      .scene-details {
        background: $color-gray-100;
        padding: $spacing-md;
        border-radius: $border-radius-md;

        p {
          margin: $spacing-sm 0;
          font-size: $font-size-sm;
          color: $color-gray-600;

          strong {
            color: $color-gray-800;
          }
        }
      }
    }
  }

  .shots-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: $spacing-lg - $spacing-xs;
    margin-bottom: $spacing-lg + 6px;

    .shot-card {
      background: $color-white;
      border: 2px solid #e0e0e0;
      border-radius: $border-radius-lg - 2px;
      padding: $spacing-lg - $spacing-xs;
      cursor: pointer;
      transition: all 0.3s ease;

      &:hover {
        transform: scale(1.02);
        box-shadow: 0 4px 12px rgba($color-black, 0.1);
      }

      &.selected {
        border-color: #4a90e2;
        background: #f0f8ff;
      }

      .shot-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: $spacing-sm + $spacing-xs;

        .shot-number {
          font-weight: bold;
          color: #4a90e2;
          font-size: $font-size-base;
        }

        .shot-type {
          background: #e3f2fd;
          color: #1976d2;
          padding: $spacing-xs 12px;
          border-radius: $border-radius-xl;
          font-size: $font-size-xs;
          font-weight: 500;
        }
      }

      .shot-description {
        margin-bottom: $spacing-md;
        line-height: 1.6;
        color: $color-gray-800;
      }

      .shot-technical {
        display: flex;
        flex-direction: column;
        gap: $spacing-sm;
        font-size: 13px;
        color: $color-gray-600;
        padding: $spacing-sm + $spacing-xs;
        background: #f9f9f9;
        border-radius: $border-radius-md - 2px;

        span {
          display: flex;
          align-items: center;
          gap: $spacing-xs;
        }
      }

      .shot-dialogue {
        margin-top: $spacing-sm + $spacing-xs;
        padding: $spacing-sm + 2px;
        background: #fff3cd;
        border-left: $spacing-xs solid $color-warning;
        border-radius: $border-radius-sm;
        font-style: italic;
        font-size: $font-size-sm;
        color: #856404;
      }
    }
  }

  .storyboards-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: $spacing-lg;
    margin-bottom: $spacing-lg + 6px;

    .storyboard-card {
      background: $color-white;
      border: 2px solid #e0e0e0;
      border-radius: $border-radius-lg;
      overflow: hidden;
      box-shadow: 0 2px 4px rgba($color-black, 0.1);

      .board-frame {
        background: $color-gray-800;
        padding: $spacing-lg - $spacing-xs;
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;

        img {
          width: 100%;
          height: auto;
          display: block;
          max-height: 400px;
          object-fit: contain;
        }

        .frame-placeholder {
          width: 100%;
          height: 180px;
          background: #f0f0f0;
          border: 2px dashed $color-gray-500;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          color: $color-gray-600;
          font-size: $font-size-lg;
          font-weight: bold;

          small {
            font-weight: normal;
            font-size: $font-size-sm;
          }
        }
      }

      .board-details {
        padding: $spacing-lg - $spacing-xs;

        h5 {
          color: #2c5aa0;
          margin-bottom: $spacing-sm + 2px;
          font-size: $font-size-base;
        }

        .board-composition {
          color: $color-gray-800;
          line-height: 1.6;
          margin-bottom: $spacing-md;
        }

        .board-notes {
          background: $color-gray-100;
          padding: $spacing-sm + $spacing-xs;
          border-radius: $border-radius-md - 2px;
          margin-bottom: $spacing-sm + $spacing-xs;

          p {
            margin: 6px 0;
            font-size: $font-size-sm;
            color: $color-gray-600;

            strong {
              color: $color-gray-800;
            }
          }
        }

        .board-additional-notes {
          font-size: $font-size-sm;
          color: $color-gray-600;
          font-style: italic;
          padding: $spacing-sm 12px;
          background: #fffde7;
          border-left: 3px solid #fbc02d;
          border-radius: $border-radius-sm;
        }
      }
    }
  }

  .button-group {
    display: flex;
    gap: $spacing-sm + $spacing-xs;
    justify-content: center;
    margin-top: $spacing-lg + 6px;

    button {
      width: auto;
      min-width: 180px;
      padding: $spacing-0 32px;
      height: $spacing-3xl;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
    }

    .back-btn {
      padding: $spacing-md - 2px 32px;
      background: white;
      color: #4318FF;
      border: 2px solid #4318FF;
      border-radius: $border-radius-md;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;

      &:hover {
        background: linear-gradient(135deg, $color-primary, $color-primary-dark);
        color: white;
        transform: translateY(-1px);
      }
    }

    .generate-btn {
      padding: $spacing-md - 2px 32px;
      background: #4318FF;
      color: white;
      border: none;
      border-radius: $border-radius-md;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-top: $spacing-0;

      &:hover:not(:disabled) {
        background: #3311CC;
        transform: translateY(-1px);
      }

      &:disabled {
        background: $color-gray-400;
        cursor: not-allowed;
      }
    }

    .new-btn {
      padding: $spacing-md - 2px 32px;
      background: #00BFA5;
      color: white;
      border: none;
      border-radius: $border-radius-md;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;

      &:hover {
        background: #00A693;
        transform: translateY(-1px);
      }
    }
    
    .export-btn {
      padding: $spacing-md - 2px 32px;
      background: #FF6B6B;
      color: white;
      border: none;
      border-radius: $border-radius-md;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: $spacing-0;
      
      &:hover {
        background: #FF5252;
        transform: translateY(-1px);
      }
    }
  }

  .error-message, .success-message {
    max-width: 900px;
    margin: $spacing-0 auto 20px;
    padding: $spacing-md 40px 16px 20px;
    border-radius: $border-radius-md;
    text-align: center;
    position: relative;
    animation: slideDown 0.3s ease;

    p {
      margin: $spacing-0;
      font-size: 15px;
    }

    button {
      position: absolute;
      top: 50%;
      right: $spacing-sm + $spacing-xs;
      transform: translateY(-50%);
      background: none;
      border: none;
      font-size: $font-size-2xl;
      cursor: pointer;
      padding: $spacing-0;
      width: $spacing-lg + 6px;
      height: $spacing-lg + 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: $border-radius-full;
      transition: background 0.2s ease;

      &:hover {
        background: rgba($color-black, 0.1);
      }
    }
  }

  .error-message {
    background: #fee;
    border: 1px solid #fcc;
    color: #c00;

    button {
      color: #c00;
    }
  }

  .success-message {
    background: #d4edda;
    border: 1px solid #c3e6cb;
    color: #155724;

    button {
      color: #155724;
    }
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .custom-input-wrapper {
    display: flex;
    flex-direction: column;
    gap: $spacing-sm + 2px;
    
    input {
      width: 100%;
      padding: $spacing-sm + $spacing-xs 16px;
      font-size: 15px;
      border: 2px solid #4a90e2;
      border-radius: $border-radius-md - 2px;
      background: #f8fbff;
      transition: all 0.3s ease;
      font-weight: 500;
      
      &:focus {
        outline: none;
        border-color: #2d6fdb;
        background: $color-white;
        box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.1);
      }
      
      &::placeholder {
        color: #8ca0b3;
        font-weight: 400;
      }
    }
  }
  
  .cancel-custom-btn {
    padding: $spacing-sm 16px;
    background: #6c757d;
    color: white;
    border: none;
    border-radius: $border-radius-sm;
    font-size: $font-size-sm;
    cursor: pointer;
    transition: background 0.3s ease;
    white-space: nowrap;
    margin-top: $spacing-sm;
    align-self: flex-start;
    
    &:hover {
      background: #5a6268;
    }
  }

  // 단계별 미리보기 섹션
  .step-preview-section {
    margin-top: $spacing-2xl;
    display: flex;
    flex-direction: column;
    gap: $spacing-lg - $spacing-xs;

    .step-preview {
      background: white;
      border-radius: $border-radius-lg;
      padding: $spacing-lg;
      box-shadow: 0 2px 8px rgba($color-black, 0.08);
      border-left: $spacing-xs solid #e0e0e0;
      transition: all 0.3s ease;

      &.active {
        border-left-color: $color-primary;
        box-shadow: 0 4px 16px rgba($color-primary, 0.1);
