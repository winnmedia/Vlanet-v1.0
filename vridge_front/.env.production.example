# VideoPlanet 프론트엔드 프로덕션 환경변수 예시
# 이 파일을 복사하여 .env.production으로 만들거나 Vercel/Railway 환경변수에 설정하세요

# API 설정
REACT_APP_API_URL=https://videoplanet.up.railway.app
REACT_APP_WEBSOCKET_URL=wss://videoplanet.up.railway.app

# 기능 플래그
REACT_APP_ENABLE_WEBSOCKET=true
REACT_APP_ENABLE_AI_FEATURES=true

# 분석 도구
REACT_APP_GA_TRACKING_ID=G-XXXXXXXXXX
REACT_APP_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# 버전 정보
REACT_APP_VERSION=$npm_package_version
REACT_APP_BUILD_DATE=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# 개발자 도구 (프로덕션에서는 false)
REACT_APP_ENABLE_DEBUG=false

# 파일 업로드 설정
REACT_APP_MAX_FILE_SIZE=524288000  # 500MB in bytes
REACT_APP_ALLOWED_FILE_TYPES=.mp4,.mov,.avi,.wmv,.mkv

# 타임아웃 설정
REACT_APP_API_TIMEOUT=30000  # 30초
REACT_APP_UPLOAD_TIMEOUT=600000  # 10분