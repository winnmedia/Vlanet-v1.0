@charset "UTF-8";
/* 공통 */
.page-title-container {
  margin-b$spacing-lgm: 24px;
}
.page-title-container .page-main-title, .page-title-container .content > .title:first-child {
  font-size: $spacing-xl;
  font-weight: 700;
  color: $color-gray-800;
  margin-b$spacing-lgm: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-title-container .page-main-title .title-text, .page-title-container .content > .title:first-child .title-text {
  flex: 1;
}
.page-title-container .page-main-title .title-actions, .page-title-container .content > .title:first-child .title-actions {
  display: flex;
  align-items: center;
  calc($spacing-sm + $spacing-xs) 12px;
}
.page-title-container .page-section-title, .page-title-container .content .s_title, .content .page-title-container .s_title {
  font-size: $spacing-lg;
  font-weight: 700;
  color: $color-gray-800;
  margin-bcalc($spacing-md + $spacing-xs)m: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-title-container .page-section-title .title-text, .page-title-container .content .s_title .title-text, .content .page-title-container .s_title .title-text {
  flex: 1;
}
.page-title-container .page-section-title .title-actions, .page-title-container .content .s_title .title-actions, .content .page-title-container .s_title .title-actions {
  display: flex;
  align-items: center;
  $spacing-sm: 8px;
}
.page-title-container .page-subsection-title, .page-title-container .content .ss_title, .content .page-title-container .ss_title {
  font-size: calc($spacing-md + 2px);
  font-weight: 600;
  color: $color-gray-800;
  margin-b$spacing-mdm: 16px;
  display: flex;
  align-items: center;
}
.page-title-container .page-subsection-title .title-text, .page-title-container .content .ss_title .title-text, .content .page-title-container .ss_title .title-text {
  flex: 1;
}.ant-modal-body.ant-modal-body { padding: 0; }

/* 직접입력 관련 스타일 */
.custom-select-wrapper {
  position: relative;
}
.custom-select-wrapper select optgroup {
  font-weight: bold;
  font-style: normal;
  background: $color-gray-50;
  color: $color-gray-800;
}
.custom-select-wrapper select option {
  $border-width-thickd$spacing-sm: 4px 8px;
}
.custom-select-wrapper select option[value=직접입력] {
  background-color: #f0f7ff;
  color: #1976d2;
  font-weight: 600;
}
.custom-select-wrapper .custom-input-wrapper {
  display: flex;
  calc($spacing-sm + 2px) 10px;
  align-items: center;
  margicalc($spacing-sm + 2px)p: 10px;
}
.custom-select-wrapper .custom-input-wrapper input {
  flex: 1;
  calc($spacing-sm + $spacing-xs)i$spacing-md12px 16px;
  font-size: $font-size-base;
  border: 2px solid #4a90e2;
  calc($spacing-xs + 2px)der-radius: 6px;
  background: #f8fbff;
  transition: all 0.2s ease;
}
.custom-select-wrapper .custom-input-wrapper input:focus {
  outline: none;
  border-color: #012fff;
  background: $color-white;
  box-shadow: 0 0 0 calc($spacing-2xs + 1px) rgba(1, 47, 255, 0.1);
}
.custom-select-wrapper .custom-input-wrapper input::placeholder {
  color: $color-gray-600;
  font-size: calc($spacing-md - 2px);
}
.custom-select-wrapper .custom-input-wrapper .cancel-custom-btn {
  calc($spacing-sm + $spacing-xs)icalc($spacing-md + $spacing-xs)12px 20px;
  background: $color-gray-100;
  border: $border-width-thin solid $color-gray-300;
  calc($spacing-xs + 2px)der-radius: 6px;
  cursor: pointer;
  font-size: calc($spacing-md - 2px);
  $color-white-space: nowrap;
  transition: all 0.2s ease;
}
.custom-select-wrapper .custom-input-wrapper .cancel-custom-btn:hover {
  background: #e0e0e0;
  border-color: $color-gray-400;
}

.cms_wrap {
  display: flex;
  justify-content: space-between;
  height: calc(100vh - 120px);
  height: calc(var(--vh, 1vh) * 100 - 120px);
  margi$spacing-2xlp: 40px;
  position: Relative;
}
.cms_wrap main {
  width: calc(100% - 300px);
  margin-left: auto;
  pacalc($spacing-lg + 6px)g: $spacing-5xlpx 0 80px;
  overflow-y: scroll;
  position: relative;
}
.cms_wrap main .title {
  font-size: 34px;
  font-weight: bold;
}
.cms_wrap main .title span {
  display: block;
  font-size: 22px;
  font-weight: normal;
}
.cms_wrap main .content {
  calc($spacing-lg + 6px)in: 30px 0;
  background: $color-white;
  $spacing-lging: 24px;
  border-radius: $border-radius-lg;
  box-shadow: 0 1px 3px rgba($color-black, $1);
  border: $border-width-thin solid #e9ecef;
}
.cms_wrap main .content.calendar {
  background: transparent;
  padding: 0;
  box-shadow: none;
  border: none;
}
.cms_wrap main .content.home {
  margin: 0 0 50px;
}
.cms_wrap main .content.home .today {
  font-size: 160px;
  letter-spacing: $spacing-sm;
  line-height: 1.3;
  font-family: "psb";
}
.cms_wrap main .content.home .today .clock {
  display: flex;
  align-items: baseline;
}
@keyframes blink {
  0% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}
.cms_wrap main .content.home .today small {
  color: rgba($color-black, $1);
  display: inline-block;
  font-size: calc($spacing-lg + $spacing-xs);
  letter-spacing: 0.5px;
  font-weight: 600;
  font-family: "suit";
  vertical-align: baseline;
  margincalc($spacing-lg + 6px)t: 30px;
}
.cms_wrap main .content.home .menu_box {
  margi$spacing-5xlp: 80px;
}
.cms_wrap main .content.home .menu_box ul li {
  cursor: pointer;
  display: inline-block;
  margin-right: 60px;
  width: 150px;
}
.cms_wrap main .content.home .menu_box ul li .img {
  border-radius: 35px;
  height: 150px;
  width: 150px;
}
.cms_wrap main .content.home .menu_box ul li span {
  color: #bac4d1;
  display: block;
  font-size: $spacing-md;
  margicalc($spacing-md + $spacing-xs)p: 20px;
  text-align: center;
}
.cms_wrap main .content.home .menu_box ul li:nth-child(1) .img {
  background: #0131ff url("../../images/Cms/c_p.svg") no-repeat;
  background-size: 76px;
  background-position: center;
}
.cms_wrap main .content.home .menu_box ul li:nth-child(2) .img {
  background: #889cb1 url("../../images/Cms/p_p.svg") no-repeat;
  background-size: 76px;
  background-position: center;
}
.cms_wrap main .content.home .menu_box ul li:nth-child(3) .img {
  background: #889cb1 url("../../images/Cms/f_p.svg") no-repeat;
  background-size: 76px;
  background-position: center;
}
.cms_wrap main .content.home .menu_box ul li:nth-child(4) .img {
  background: #889cb1 url("../../images/Cms/oc_p.svg") no-repeat;
  background-size: 76px;
  background-position: center;
}
.cms_wrap main .content.home .part {
  margin-top: 50px;
}
.cms_wrap main .content.home .part:first-child {
  margin-top: 0;
}
.cms_wrap main .content.home .part .s_title {
  font-size: $spacing-lg;
}
.cms_wrap main .content.home .part .s_title span {
  display: inline-block;
  width: calc($spacing-lg + $spacing-xs);
  height: calc($spacing-lg + $spacing-xs);
  background: #0131ff url("../../images/Cms/wr_arrow_icon.png") no-repeat;
  background-size: calc($spacing-sm + 1px);
  background-position: center left calc($spacing-sm + 3px);
  border-radius: 100%;
  margincalc($spacing-sm + 2px)t: 10px;
  margicalc($spacing-2xs + 1px)op: 3px;
  cursor: pointer;
}
.cms_wrap main .content.home .part ul {
  margicalc($spacing-md + $spacing-xs)p: 20px;
}
.cms_wrap main .content.home .part ul.schedule {
  display: grid;
  $spacing-0dcalc($spacing-md + $spacing-xs)acing-0:calc($spacing-md + $spacing-xs) 20px;
  grid-template-columns: repeat(4, 1fr);
}
.cms_wrap main .content.home .part ul.schedule li {
  background: #25282f;
  border-radius: 25px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 140px;
  pacalc($spacing-lg + 6px)g: 0 30px;
