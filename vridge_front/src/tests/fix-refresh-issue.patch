## 9. Update util/util.js for better error handling
# Add try-catch blocks and better token management:

export function checkSession() {
  try {
    let session = window.localStorage.getItem('VGID')
    
    if (!session) {
      // Try sessionStorage as fallback
      session = window.sessionStorage.getItem('VGID')
    }
    
    if (session) {
      // Remove quotes if present
      session = session.replace(/^"|"$/g, '')
      return session
    }
    
    return null
  } catch (error) {
    console.error('Error checking session:', error)
    return null
  }
}

## 10. Add loading states to prevent accessing undefined data
# Create a custom hook for data loading:

// src/hooks/useDataLoader.js
import { useState, useEffect } from 'react'

export function useDataLoader(loadFunction, dependencies = []) {
  const [data, setData] = useState(null)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState(null)
  
  useEffect(() => {
    const loadData = async () => {
      try {
        setLoading(true)
        const result = await loadFunction()
        setData(result)
      } catch (err) {
        setError(err)
      } finally {
        setLoading(false)
      }
    }
    
    loadData()
  }, dependencies)
  
  return { data, loading, error }
}

