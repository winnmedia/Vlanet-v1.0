@import '../styles/design-tokens';

.video-player-wrapper {
  width: 100%;
  height: 100%;
  min-height: 300px;
  max-height: 80vh;
  
  .loading-container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: $color-background-secondary;
    
    .spinner {
      width: $spacing-2xl;
      height: $spacing-2xl;
      border: 3px solid #e0e0e0;
      border-top-color: #012$color-white;
      border-radius: $border-radius-full;
      animation: spin 1s linear infinite;
    }
    
    p {
      margin-top: $spacing-md;
      color: $color-gray-600;
      font-size: $font-size-sm;
    }
  }
  
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  
  .native-player-container {
    width: 100%;
    height: 100%;
    position: relative;
    background: $color-black;
    display: flex;
    flex-direction: column;
    
    .format-warning {
      background: #fff3cd;
      border: 1px solid #ffeaa7;
      color: #856404;
      padding: $spacing-sm + $spacing-xs 16px;
      margin: $spacing-0;
      text-align: center;
      
      p {
        margin: $spacing-0;
        font-size: $font-size-sm;
        
        &:first-child {
          font-weight: 600;
          margin-bottom: $spacing-xs;
        }
      }
    }
    
    video {
      flex: 1;
      width: 100%;
      height: 100%;
      background: $color-black;
      outline: none;
    }
    
    .player-info {
      background: rgba($color-black, 0.8);
      color: $color-white;
      padding: $spacing-sm;
      text-align: center;
      
      small {
        font-size: $font-size-xs;
        opacity: 0.8;
      }
    }
  }
  
  // 반응형 디자인
  @media (max-width: $breakpoint-md) {
    min-height: 200px;
    max-height: 50vh;
    
    .native-player-container {
      .format-warning {
        padding: $spacing-sm 12px;
        
        p {
          font-size: $font-size-xs;
        }
      }
      
      .player-info {
        padding: 6px;
        
        small {
          font-size: 11px;
        }
      }
    }
  }
  
  @media (max-width: 480px) {
    min-height: 180px;
    max-height: 40vh;
  }
}