// ========================================
// 타이포그래피 헬퍼 함수들
// ========================================

/**
 * CSS 스타일 객체로 변환
 */
export const getTypographyStyle = (styleName) => {
  const style = typography.styles[styleName];
  if (!style) return null;
  
  return {
    fontSize: style.fontSize,
    fontWeight: style.fontWeight,
    lineHeight: style.lineHeight,
    letterSpacing: style.letterSpacing || 'normal',
    textTransform: style.textTransform || 'none',
    fontFamily: typography.fontFamily[style.fontFamily] || typography.fontFamily.primary,
  };
};

/**
 * 반응형 타이포그래피 스타일 생성
 */
export const getResponsiveTypography = (desktop, mobile) => {
  return {
    ...getTypographyStyle(desktop),
    '@media (max-width: 768px)': {
      ...getTypographyStyle(mobile),
    },
  };
};

/**
 * 컨텍스트에 따른 타이포그래피 추천
 */
export const getContextualTypography = (context, size = 'default') => {
  const contextMap = {
    'page-header': size === 'large' ? 'pageTitle' : 'sectionTitle',
    'card': size === 'large' ? 'cardTitle' : 'body',
    'project': size === 'large' ? 'projectTitle' : 'projectDescription',
    'feedback': 'feedbackText',
    'metadata': size === 'small' ? 'metadataSmall' : 'metadata',
    'button': size === 'large' ? 'buttonLarge' : 'button',
    'stat': size === 'small' ? 'statSmall' : 'stat',
  };
  
  return contextMap[context] || 'body';
};

export default typography;