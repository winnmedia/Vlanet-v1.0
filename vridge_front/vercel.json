{
  "name": "vlanet-production",
  "alias": ["vlanet.net", "www.vlanet.net"],
  "projectSettings": {
    "framework": "nextjs",
    "buildCommand": "npm run build",
    "outputDirectory": ".next",
    "devCommand": "npm run dev",
    "installCommand": "npm install --legacy-peer-deps"
  },
  "regions": ["icn1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://videoplanet.up.railway.app",
    "NEXT_PUBLIC_VERSION": "1.0.9",
    "NEXT_PUBLIC_SITE_NAME": "VLanet"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "https://videoplanet.up.railway.app",
      "NEXT_PUBLIC_VERSION": "1.0.9",
      "NEXT_PUBLIC_SITE_NAME": "VLanet",
      "NODE_ENV": "production"
    }
  },
  "functions": {
    "pages/api/**.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/home",
      "destination": "/cmshome",
      "permanent": true
    }
  ],
  "github": {
    "enabled": true,
    "silent": true,
    "autoAlias": false
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": false
    }
  },
  "public": false,
  "scope": "winnmedia"
}