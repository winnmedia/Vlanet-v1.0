import React from 'react'
import { ErrorBoundary as ReactErrorBoundary } from 'react-error-boundary'
import styles from './ErrorBoundary.module.scss'
import { message } from 'antd'

// 에러 폴백 컴포넌트
function ErrorFallback({ error, resetErrorBoundary }) {
  return (
    <div className={styles.errorContainer}>
      <div className={styles.errorContent}>
        <div className={styles.errorIcon}>
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none">
            <path 
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" 
              stroke="currentColor" 
              strokeWidth="2" 
              strokeLinecap="round" 
              strokeLinejoin="round"
            />
          </svg>
        </div>
        
        <h1 className={styles.errorTitle}>
          앗! 문제가 발생했습니다
        </h1>
        
        <p className={styles.errorMessage}>
          예상치 못한 오류가 발생했습니다. 
          불편을 드려 죄송합니다.
        </p>
        
        {process.env.NODE_ENV === 'development' && error && (
          <details className={styles.errorDetails}>
            <summary>오류 상세 정보</summary>
            <pre>{error.message}</pre>
            <pre>{error.stack}</pre>
          </details>
        )}
        
        <div className={styles.errorActions}>
          <button 
            onClick={resetErrorBoundary}
            className={styles.retryButton}
          >
            다시 시도
          </button>
          
          <button 
            onClick={() => {
              if (typeof window !== 'undefined') {
                window.location.href = '/'
              }
            }}
            className={styles.homeButton}
          >
            홈으로 이동
          </button>
        </div>
      </div>
    </div>
  )
}

// 에러 로깅 함수
function logErrorToService(error, errorInfo) {
  // 프로덕션 환경에서는 실제 에러 로깅 서비스로 전송
  if (process.env.NODE_ENV === 'production') {
    // 예: Sentry, LogRocket 등으로 에러 전송
    console.error('Error logged:', error, errorInfo)
    
    // API로 에러 로그 전송
    const errorData = {
      message: error.toString(),
      stack: error.stack,
      componentStack: errorInfo.componentStack,
      timestamp: new Date().toISOString(),
      userAgent: typeof window !== 'undefined' ? window.navigator.userAgent : 'unknown',
      url: typeof window !== 'undefined' ? window.location.href : 'unknown'
    }
    
    // 에러 로깅 API 호출 (실제 구현 시)
    // fetch('/api/error-log', {
    //   method: 'POST',
    //   headers: { 'Content-Type': 'application/json' },
    //   body: JSON.stringify(errorData)
    // }).catch(console.error)
  } else {
    // 개발 환경에서는 콘솔에 출력
    console.error('Error Boundary caught:', error, errorInfo)
  }
}

// 메인 ErrorBoundary 컴포넌트
export default function ErrorBoundary({ children, fallback, onError }) {
  return (
    <ReactErrorBoundary
      FallbackComponent={fallback || ErrorFallback}
      onError={onError || logErrorToService}
      onReset={() => {
        // 에러 상태 초기화 시 필요한 작업
        if (typeof window !== 'undefined') {
          // 세션 스토리지의 임시 데이터 클리어
          window.sessionStorage.removeItem('errorState')
          // 페이지 리로드
          window.location.reload()
        }
      }}
    >
      {children}
    </ReactErrorBoundary>
  )
}

// 레거시 클래스 컴포넌트 (하위 호환성)
export class LegacyErrorBoundary extends React.Component {
  constructor(props) {
    super(props);
    this.state = { hasError: false, error: null };
  }

  static getDerivedStateFromError(error) {
    return { hasError: true, error };
  }

  componentDidCatch(error, errorInfo) {
    logErrorToService(error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return <ErrorFallback error={this.state.error} resetErrorBoundary={() => {
        this.setState({ hasError: false, error: null });
      }} />;
    }

    return this.props.children;
  }
}

// 특정 페이지용 커스텀 에러 바운더리
export function PageErrorBoundary({ children, pageName }) {
  const handleError = (error, errorInfo) => {
    logErrorToService(error, { ...errorInfo, pageName })
  }
  
  const CustomErrorFallback = ({ error, resetErrorBoundary }) => (
    <div className={styles.pageErrorContainer}>
      <div className={styles.pageErrorContent}>
        <h2>{pageName} 페이지 오류</h2>
        <p>이 페이지를 불러오는 중 문제가 발생했습니다.</p>
        <button onClick={resetErrorBoundary} className={styles.retryButton}>
          새로고침
        </button>
      </div>
    </div>
  )
  
  return (
    <ErrorBoundary 
      fallback={CustomErrorFallback}
      onError={handleError}
    >
      {children}
    </ErrorBoundary>
  )
}