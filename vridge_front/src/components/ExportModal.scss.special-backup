@import '../styles/design-tokens';

.export-modal-overlay {
  position: fixed;
  top: $spacing-0;
  left: $spacing-0;
  right: $spacing-0;
  bottom: $spacing-0;
  background-color: rgba($color-black, $opacity-50);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9$color-gray-500;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.export-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: white;
  border-radius: $border-radius-lg;
  box-shadow: 0 10px 40px rgba($color-black, 0.2);
  width: 90%;
  max-width: 600px;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
  z-index: 10$color-black;
}

@keyframes slideUp {
  from {
    transform: translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.export-modal-header {
  padding: $spacing-lg;
  border-bottom: 1px solid #e0e0e0;
  display: flex;
  justify-content: space-between;
  align-items: center;

  h2 {
    margin: $spacing-0;
    font-size: $font-size-xl;
    font-weight: 600;
    color: #1a1a1a;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 28px;
    color: $color-gray-600;
    cursor: pointer;
    width: $spacing-xl + $spacing-xs;
    height: $spacing-xl + $spacing-xs;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: $border-radius-md - 2px;
    transition: all 0.2s;

    &:hover {
      background-color: $color-gray-100;
      color: $color-gray-800;
    }
  }
}

.export-modal-body {
  flex: 1;
  padding: $spacing-lg;
  overflow-y: auto;

  .export-info {
    p {
      margin-bottom: $spacing-sm + $spacing-xs;
      font-size: $font-size-sm;
      color: #374151;
    }

    ul {
      margin-left: $spacing-lg - $spacing-xs;
      color: #6b7280;
      font-size: $font-size-sm;
      
      li {
        margin-bottom: $spacing-sm;
      }
    }
  }

  .format-option {
    display: flex;
    align-items: center;
    padding: $spacing-md;
    border: 2px solid #e0e0e0;
    border-radius: $border-radius-md;
    cursor: pointer;
    transition: all 0.2s;

    &:hover:not(.disabled) {
      border-color: #3b82f6;
      background-color: #f0f7ff;
    }

    &.selected {
      border-color: #3b82f6;
      background-color: #f0f7ff;
    }

    &.disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .format-icon {
      width: $spacing-3xl;
      height: $spacing-3xl;
      background-color: #f3f4f6;
      border-radius: $border-radius-md;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: $spacing-md;
      flex-shrink: 0;

      font-size: $font-size-2xl;
    }

    &.selected .format-icon {
      background-color: #3b82f6;
    }

    .format-info {
      flex: 1;

      h5 {
        margin: $spacing-0 0 4px 0;
        font-size: $font-size-base;
        font-weight: 600;
        color: #1a1a1a;
      }

      p {
        margin: $spacing-0 0 4px 0;
        font-size: $font-size-sm;
        color: #6b7280;
      }

      small {
        font-size: $font-size-xs;
        color: #9ca3af;
        font-style: italic;
      }

      .unavailable {
        display: inline-block;
        margin-top: $spacing-xs;
        font-size: $font-size-xs;
        color: #ef4444;
        font-weight: 500;
      }
    }
  }

  .export-error {
    margin-top: $spacing-md;
    padding: $spacing-sm + $spacing-xs 16px;
    border-radius: $border-radius-md;
    background-color: #fee;
    color: #dc2626;
    border: 1px solid #fecaca;
    font-size: $font-size-sm;
  }

  .export-success {
    margin-top: $spacing-md;
    padding: $spacing-sm + $spacing-xs 16px;
    border-radius: $border-radius-md;
    background-color: #f0fdf4;
    color: #16a34a;
    border: 1px solid #bbf7d0;
    font-size: $font-size-sm;

    a {
      color: #4318FF;
      text-decoration: none;
      font-weight: 500;
      
      &:hover {
        text-decoration: underline;
      }
    }

    div {
      font-size: $font-size-xs;
      color: $color-gray-600;
      margin-top: $spacing-xs;
    }
  }

  .loading {
    text-align: center;
    padding: $spacing-2xl 20px;
    color: $color-gray-600;
    font-size: $font-size-sm;
  }
}

.export-modal-footer {
  padding: $spacing-lg - $spacing-xs 24px;
  border-top: 1px solid #e0e0e0;
  display: flex;
  justify-content: flex-end;
  gap: $spacing-sm + $spacing-xs;

  button {
    padding: $spacing-sm + 2px 20px;
    border-radius: $border-radius-md - 2px;
    font-size: $font-size-sm;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    border: none;

    &.cancel-btn {
      background-color: #f3f4f6;
      color: #374151;

      &:hover {
        background-color: #e5e7eb;
      }
    }

    &.export-btn {
      background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
      color: white;

      &:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba($color-primary, 0.4);
      }

      &:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
    }
  }
}