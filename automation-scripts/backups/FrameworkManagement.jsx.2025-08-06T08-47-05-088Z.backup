import React, { useState, useEffect } from 'react'
import { useRouter } from '../../util/nextNavigation'
import PageTemplate from 'components/PageTemplate'
import SideBar from 'components/SideBar'

import { GetFrameworks, CreateFramework, UpdateFramework, DeleteFramework, SetDefaultFramework } from 'api/framework'
import { checkSession } from 'util/util'
import { useEffect, useState } from 'react'
import { message } from 'antd'

export default function FrameworkManagement() {
  const { navigate } = useRouter()
  const [frameworks, setFrameworks] = useState([])
  const [loading, setLoading] = useState(true)
  const [showForm, setShowForm] = useState(false)
  const [editingFramework, setEditingFramework] = useState(null)
  const [formData, setFormData] = useState({
    name: '',
    intro_hook: '',
    immersion: '',
    twist: '',
    hook_next: '',
    is_default: false
  })

  useEffect(() => {
    const session = checkSession()
    if (!session) {
      navigate('/Login', { replace: true })
      return
    }
    loadFrameworks()
  }, [navigate])

  const loadFrameworks = async () => {
    try {
      setLoading(true)
      const response = await GetFrameworks()
      setFrameworks(response.data.frameworks)
    } catch (error) {
      console.error('프레임워크 목록 로드 실패:', error)
      alert('프레임워크 목록을 불러오는데 실패했습니다.')
    } finally {
      setLoading(false)
    }
  }

  const handleSubmit = async (e) => {
    e.preventDefault()
    
    try {
      if (editingFramework) {
        await UpdateFramework(editingFramework.id, formData)
        alert('프레임워크가 수정되었습니다.')
      } else {
        await CreateFramework(formData)
        alert('프레임워크가 생성되었습니다.')
      }
      
      resetForm()
      loadFrameworks()
    } catch (error) {
      console.error('프레임워크 저장 실패:', error)
      alert('프레임워크 저장에 실패했습니다.')
    }
  }

  const handleEdit = (framework) => {
    setEditingFramework(framework)
    setFormData({
      name: framework.name,
      intro_hook: framework.intro_hook,
      immersion: framework.immersion,
      twist: framework.twist,
      hook_next: framework.hook_next,
      is_default: framework.is_default
    })
    setShowForm(true)
  }

  const handleDelete = async (id) => {
    if (!window.confirm('정말로 이 프레임워크를 삭제하시겠습니까?')) {
      return
    }

    try {
      await DeleteFramework(id)
      alert('프레임워크가 삭제되었습니다.')
      loadFrameworks()
    } catch (error) {
      console.error('프레임워크 삭제 실패:', error)
      alert(error.response?.data?.message || '프레임워크 삭제에 실패했습니다.')
    }
  }

  const handleSetDefault = async (id) => {
    try {
      await SetDefaultFramework(id)
      alert('기본 프레임워크로 설정되었습니다.')
      loadFrameworks()
    } catch (error) {
      console.error('기본 프레임워크 설정 실패:', error)
      alert('기본 프레임워크 설정에 실패했습니다.')
    }
  }

  const resetForm = () => {
    setFormData({
      name: '',
      intro_hook: '',
      immersion: '',
      twist: '',
      hook_next: '',
      is_default: false
    })
    setEditingFramework(null)
    setShowForm(false)
  }

  return (
    <PageTemplate>
      <div className="cms_wrap">
        <SideBar />
        <main>
          <div className="content framework-management">
            <div className="page-header">
              <h1>기획안 디벨롭 프레임워크 관리</h1>
              <button 
                className="btn-primary"
                onClick={() => setShowForm(true)}
              >
                새 프레임워크 추가
              </button>
            </div>

            {showForm && (
              <div className="framework-form-container">
                <form onSubmit={handleSubmit} className="framework-form">
                  <h2>{editingFramework ? '프레임워크 수정' : '새 프레임워크 추가'}</h2>
                  
                  <div className="form-group">
                    <label>프레임워크 이름 *</label>
                    <input
                      type="text"
                      value={formData.name}
                      onChange={(e) => setFormData({...formData, name: e.target.value})}
                      required
                      placeholder="예: 유튜브 쇼츠 프레임워크"
                    />
                  </div>

                  <div className="form-group">
                    <label>1. 인트로 훅 *</label>
                    <textarea
                      value={formData.intro_hook}
                      onChange={(e) => setFormData({...formData, intro_hook: e.target.value})}
                      required
                      placeholder="초반 5초 안에 시청자의 시선을 사로잡을 강력한 한 방"
                      rows={3}
                    />
                  </div>

                  <div className="form-group">
                    <label>2. 몰입 *</label>
                    <textarea
                      value={formData.immersion}
                      onChange={(e) => setFormData({...formData, immersion: e.target.value})}
                      required
                      placeholder="빠른 컷 전환과 흥미로운 전개로 시청자 몰입 유도"
                      rows={3}
                    />
                  </div>

                  <div className="form-group">
                    <label>3. 반전 *</label>
                    <textarea
                      value={formData.twist}
                      onChange={(e) => setFormData({...formData, twist: e.target.value})}
                      required
                      placeholder="예상치 못한 이벤트로 지루함 방지 및 긴장감 유지"
                      rows={3}
                    />
                  </div>

                  <div className="form-group">
                    <label>4. 떡밥 *</label>
                    <textarea
                      value={formData.hook_next}
                      onChange={(e) => setFormData({...formData, hook_next: e.target.value})}
                      required
                      placeholder="다음 콘텐츠에 대한 궁금증 유발로 재방문 유도"
                      rows={3}
                    />
                  </div>

                  <div className="form-group checkbox-group">
                    <label>
                      <input
                        type="checkbox"
                        checked={formData.is_default}
                        onChange={(e) => setFormData({...formData, is_default: e.target.checked})}
                      />
                      기본 프레임워크로 설정
                    </label>
                  </div>

                  <div className="form-actions">
                    <button type="submit" className="btn-primary">
                      {editingFramework ? '수정하기' : '추가하기'}
                    </button>
                    <button type="button" className="btn-secondary" onClick={resetForm}>
                      취소
                    </button>
                  </div>
                </form>
              </div>
            )}

            {loading ? (
              <div className="loading">프레임워크 목록을 불러오는 중...</div>
            ) : (
              <div className="framework-list">
                {frameworks.length === 0 ? (
                  <div className="empty-state">
                    <p>등록된 프레임워크가 없습니다.</p>
                    <p>새 프레임워크를 추가해보세요!</p>
                  </div>
                ) : (
                  frameworks.map((framework) => (
                    <div key={framework.id} className={`framework-card ${framework.is_default ? 'default' : ''}`}>
                      <div className="framework-header">
                        <h3>
                          {framework.name}
                          {framework.is_default && <span className="default-badge">기본값</span>}
                        </h3>
                        <div className="framework-actions">
                          {!framework.is_default && (
                            <button
                              className="btn-small btn-outline"
                              onClick={() => handleSetDefault(framework.id)}
                            >
                              기본값 설정
                            </button>
                          )}
                          <button
                            className="btn-small btn-secondary"
                            onClick={() => handleEdit(framework)}
                          >
                            수정
                          </button>
                          <button
                            className="btn-small btn-danger"
                            onClick={() => handleDelete(framework.id)}
                          >
                            삭제
                          </button>
                        </div>
                      </div>
                      
                      <div className="framework-content">
                        <div className="framework-item">
                          <h4>1. 인트로 훅</h4>
                          <p>{framework.intro_hook}</p>
                        </div>
                        <div className="framework-item">
                          <h4>2. 몰입</h4>
                          <p>{framework.immersion}</p>
                        </div>
                        <div className="framework-item">
                          <h4>3. 반전</h4>
                          <p>{framework.twist}</p>
                        </div>
                        <div className="framework-item">
                          <h4>4. 떡밥</h4>
                          <p>{framework.hook_next}</p>
                        </div>
                      </div>
                    </div>
                  ))
                )}
              </div>
            )}
          </div>
        </main>
      </div>
    </PageTemplate>
  )
}