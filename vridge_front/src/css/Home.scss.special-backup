  #footer {
    background: #1a1a1a;
    padding: 70px;
    .inner {
      max-width: 1200px;
      margin: $spacing-0 auto;
      > div {
        .logo {
          color: #0632f5;
          font-size: 34px;
          font-weight: bold;
          margin-top: $spacing-0;
        }
        ul {
          margin-top: $spacing-lg + 6px;
          li {
            color: $color-white;
            margin-top: $spacing-sm + 2px;
          }
        }
        div {
          margin-top: $spacing-lg + 6px;
          span {
            cursor: pointer;
            display: inline-block;
            background: $color-white;
            padding: $spacing-xs 8px;
            margin-right: $spacing-sm + 2px;
            border-radius: $border-radius-lg - 2px;
          }
        }
      }
      > ul {
        li {
          display: inline-block;
          margin-left: $spacing-md - 1px;
          width: $spacing-3xl + 2px;
          height: $spacing-3xl + 2px;
          border-radius: 100%;
          text-indent: -9$color-gray-500px;
          cursor: pointer;
          &:nth-child(1) {
            background: $color-white url('../images/Common/yt_icon.svg') no-repeat;
            background-size: 30px;
            background-position: center;
          }
          &:nth-child(2) {
            background: $color-white url('../images/Common/insta_icon.svg') no-repeat;
            background-size: 26px;
            background-position: center;
          }
          a {
            display: block;
          }
        }
      }
    }
  }
}

