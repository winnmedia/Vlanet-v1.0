// Button Alignment System - 전역 버튼 정렬 및 크기 표준화
// 백업에서 복원된 핵심 버튼 스타일 + 디자인 토큰 통합

@import '../../design-system/tokens/design-tokens';

// 전역 버튼 정렬 시스템
button,
.button,
.btn,
[type="button"],
[type="submit"],
[type="reset"],
.all,
.share,
.video_upload_label div,
.change_btn_wrap div,
.guide_btn,
.project_btn,
.submit,
.cert {
  // 중앙 정렬 기본값
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  
  // 일관된 텍스트 렌더링
  line-height: 1;
  white-space: nowrap;
  font-family: inherit;
  
  // 트랜지션
  transition: $transition-button;
}

// 버튼 크기 표준화
.btn-size {
  &-sm {
    min-width: 80px;
    height: 32px;
    padding: 0 $spacing-md;
    font-size: $font-size-sm;
  }
  
  &-md {
    min-width: 120px;
    height: 40px;
    padding: 0 $spacing-lg;
    font-size: $font-size-base;
  }
  
  &-lg {
    min-width: 160px;
    height: 48px;
    padding: 0 $spacing-xl;
    font-size: $font-size-lg;
  }
}

// 피드백 페이지 버튼 정렬
.feedback_wrap,
.feedback_section {
  .etc_box {
    .flex {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      
      // 액션 버튼 통일
      button,
      .all,
      .share {
        min-width: 120px;
        height: 40px;
        padding: 0 20px;
        font-size: 14px;
        font-weight: 500;
      }
      
      // 중간 버튼 그룹
      .good {
        display: flex;
        gap: 8px;
        
        .change_btn_wrap {
          div {
            height: 40px;
            padding: 0 16px;
            min-width: auto;
          }
        }
      }
    }
  }
  
  // 좋아요/싫어요 버튼 고정 크기
  .action-btn {
    &.like-btn,
    &.dislike-btn,
    &.reply-btn {
      width: 60px;
    }
    
    &.need-explanation-btn {
      width: 110px;
    }
    
    &.important-btn {
      width: 70px;
    }
  }
}

// 비디오 플레이어 컨트롤 버튼
.video_player_section,
.feedback-player {
  .control_btn_wrap,
  .control-buttons {
    display: flex;
    align-items: center;
    gap: 10px;
    
    button {
      min-width: 40px;
      height: 40px;
      padding: 0;
      border-radius: $border-radius-base;
      
      // 아이콘 중앙 정렬
      display: flex;
      align-items: center;
      justify-content: center;
      
      svg {
        width: 20px;
        height: 20px;
      }
    }
  }
  
  // 코멘트 버튼 특별 처리
  .comment-button {
    min-width: 80px;
    padding: 0 12px;
  }
}

// CMS 페이지 버튼 정렬
.project_card,
.project-info {
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    
    button {
      height: 36px;
      padding: 0 16px;
    }
  }
  
  .btn-group {
    display: flex;
    gap: 8px;
    
    button {
      min-width: 100px;
    }
  }
}

// 영상기획 페이지 버튼
.video-planning {
  .button-container {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-top: 24px;
    
    button {
      min-width: 120px;
      height: 44px;
    }
  }
}

// 모달 버튼 정렬
.modal,
.popup {
  .modal-footer,
  .popup-footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding-top: 20px;
    
    button {
      min-width: 100px;
      height: 40px;
    }
  }
}

// 폼 제출 버튼
form {
  .submit-wrapper,
  .form-actions {
    display: flex;
    justify-content: center;
    margin-top: 30px;
    
    .submit,
    button[type="submit"] {
      min-width: 200px;
      height: 48px;
      font-size: 16px;
      font-weight: 600;
    }
  }
}

// 반응형 버튼 조정
@media (max-width: 768px) {
  // 모바일에서 버튼 크기 조정
  .btn-size {
    &-md {
      min-width: 100px;
      height: 36px;
      font-size: 14px;
    }
    
    &-lg {
      min-width: 140px;
      height: 44px;
      font-size: 16px;
    }
  }
  
  // 피드백 버튼 모바일 최적화
  .feedback_wrap .etc_box {
    .flex {
      flex-wrap: wrap;
      
      button {
        min-width: 80px;
        height: 36px;
        font-size: 13px;
      }
    }
  }
  
  // 폼 버튼 전체 너비
  form .submit-wrapper {
    .submit {
      width: 100%;
      min-width: auto;
    }
  }
}