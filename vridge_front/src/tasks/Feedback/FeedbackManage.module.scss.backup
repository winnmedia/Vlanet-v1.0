// 피드백 관리 페이지 스타일
.feedbackContainer {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

// 피드백 아이템
.feedbackItem {
  background: white;
  border: 1px solid #e9ecef;
  border-radius: 12px;
  padding: 20px;
  transition: all 0.2s ease;
  position: relative;
  
  &:hover {
    border-color: #1631F8;
    box-shadow: 0 4px 12px rgba(22, 49, 248, 0.08);
    transform: translateY(-1px);
  }
  
  &.myFeedback {
    background: linear-gradient(to right, rgba(22, 49, 248, 0.03) 0%, transparent 100%);
    border-left: 3px solid #1631F8;
  }
}

// 피드백 헤더
.feedbackHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

// 작성자 정보
.authorInfo {
  display: flex;
  align-items: center;
  gap: 12px;
  
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1631F8 0%, #0F23C9 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 600;
    flex-shrink: 0;
  }
  
  .details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    
    .name {
      font-size: 15px;
      font-weight: 600;
      color: #212529;
    }
    
    .date {
      font-size: 13px;
      color: #6c757d;
    }
  }
}

// 시간 버튼
.timeButton {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 12px;
  background: rgba(22, 49, 248, 0.08);
  color: #1631F8;
  border: 1px solid rgba(22, 49, 248, 0.2);
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  
  svg {
    width: 16px;
    height: 16px;
  }
  
  &:hover {
    background: #1631F8;
    color: white;
    border-color: #1631F8;
    transform: scale(1.05);
  }
}

// 피드백 내용
.feedbackContent {
  font-size: 15px;
  line-height: 1.7;
  color: #495057;
  margin-bottom: 16px;
  word-break: keep-all;
}

// 피드백 액션
.feedbackActions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16px;
  border-top: 1px solid #f1f3f5;
}

// 반응 버튼들
.reactions {
  display: flex;
  gap: 8px;
  
  button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 20px;
    font-size: 13px;
    color: #6c757d;
    cursor: pointer;
    transition: all 0.2s ease;
    
    svg {
      width: 16px;
      height: 16px;
    }
    
    &.active {
      background: #1631F8;
      color: white;
      border-color: #1631F8;
    }
    
    &:hover:not(.active) {
      background: white;
      border-color: #adb5bd;
      transform: translateY(-1px);
    }
  }
}

// 삭제 버튼
.deleteButton {
  padding: 6px 12px;
  background: transparent;
  color: #dc3545;
  border: 1px solid #dc3545;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: #dc3545;
    color: white;
    transform: translateY(-1px);
  }
}

// 빈 상태
.emptyState {
  text-align: center;
  padding: 60px 20px;
  background: #f8f9fa;
  border-radius: 12px;
  
  svg {
    width: 64px;
    height: 64px;
    color: #dee2e6;
    margin-bottom: 16px;
  }
  
  h3 {
    font-size: 18px;
    font-weight: 600;
    color: #495057;
    margin-bottom: 8px;
  }
  
  p {
    font-size: 14px;
    color: #adb5bd;
  }
}

// 탭 전환
.tabSwitch {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
  padding: 4px;
  background: #f1f3f5;
  border-radius: 10px;
  
  button {
    flex: 1;
    padding: 8px 16px;
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    color: #6c757d;
    cursor: pointer;
    transition: all 0.2s ease;
    
    &.active {
      background: white;
      color: #1631F8;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    
    &:hover:not(.active) {
      color: #495057;
    }
  }
}