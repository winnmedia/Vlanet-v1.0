// Source: FeedbackManage.module.scss
.authorInfo {
  display: flex;
  align-items: center;
  gap: $spacing-sm + $spacing-xs;
  
  .avatar {
    width: $spacing-2xl;
    height: $spacing-2xl;
    border-radius: $border-radius-full;
    background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
    color: $color-white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: $font-size-base;
    font-weight: 600;
    flex-shrink: 0;
  }
  
  .details {
    display: flex;
    flex-direction: column;
    gap: $spacing-2xs;
    
    .name {
      font-size: $spacing-md - $spacing-2xs;
      font-weight: 600;
      color: $color-gray-900;
    }
    
    .date {
      font-size: $spacing-md - $spacing-xs;
      color: $color-gray-600;
    }
  }
}

// Source: FeedbackInput.module.scss
.buttonGroup {
  display: flex;
  gap: $spacing-sm + $spacing-xs;
  margin-top: $spacing-sm + $spacing-xs;
  
  button {
    flex: 1;
    padding: $spacing-sm + $spacing-xs $spacing-lg;
    border-radius: $border-radius-md;
    font-size: $font-size-sm;
    font-weight: 600;
    cursor: pointer;
    transition: $transition-base;
    border: none;
    
    &.submitButton {
      background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
      color: $color-white;
      
      &:hover {
        transform: translateY(-$spacing-2xs);
        box-shadow: 0 $spacing-sm $font-size-xl rgba($color-primary, 0.3);
      }
      
      &:active {
        transform: translateY(0);
      }
      
      &:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
      }
    }
    
    &.aiButton {
      background: $color-white;
      color: $color-primary;
      border: $spacing-2xs solid $color-primary;
      
      &:hover {
        background: rgba($color-primary, 0.05);
        transform: translateY(-$spacing-2xs);
        box-shadow: $shadow;
      }
      
      &:active {
        transform: translateY(0);
      }
    }
  }
}

// Source: FeedbackPage.scss
.cms_wrap {
  display: flex;
  height: 100vh;
  
  .sidebar {
    width: 250px;
    flex-shrink: 0;
  }
  
  .feedback-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
}

// Source: FeedbackInput.module.scss
.contentInput {
  display: flex;
  flex-direction: column;
  gap: $spacing-sm;
  
  label {
    font-size: $font-size-sm;
    font-weight: 600;
    color: $color-gray-900;
  }
  
  textarea {
    padding: $spacing-sm + $spacing-xs $spacing-md;
    border: $spacing-2xs solid $color-vp-gray-light-2;
    border-radius: $border-radius-md;
    font-size: $font-size-sm;
    line-height: $line-height-relaxed;
    min-height: $spacing-6xl + $spacing-lg;
    resize: vertical;
    transition: $transition-base;
    font-family: inherit;
    
    &:focus {
      outline: none;
      border-color: $color-primary;
      box-shadow: 0 0 0 $spacing-xs rgba($color-primary, 0.1);
    }
    
    &::placeholder {
      color: $color-gray-500;
    }
  }
}

// Source: FeedbackPlayer.scss
    .controls {
      border-radius: $border-radius-none 0 $border-radius-lg $border-radius-lg;
      
      .control-buttons {
        padding: $spacing-sm $spacing-sm + $spacing-xs;
        
        .left-controls {
          gap: $spacing-sm;
          
          .time-display {
            font-size: $font-size-xs;
          }
        }
        
        .right-controls {
          gap: $spacing-xs;
          
          .icon-button {
            padding: $spacing-sm - $spacing-2xs;
            min-height: $spacing-xl;
            
            .button-text {
              display: none;
            }
          }
        }
      }
    }

// Source: FeedbackManage.module.scss
.deleteButton {
  padding: $spacing-sm - $spacing-2xs $spacing-sm + $spacing-xs;
  background: transparent;
  color: $color-danger;
  border: $spacing-2xs solid $color-danger;
  border-radius: $border-radius-md - $border-radius-sm / 2;
  font-size: $spacing-md - $spacing-xs;
  font-weight: 500;
  cursor: pointer;
  transition: $transition-base;
  
  &:hover {
    background: $color-danger;
    color: $color-white;
    transform: translateY(-$spacing-2xs);
  }
}

// Source: FeedbackManage.module.scss
.emptyState {
  text-align: center;
  padding: $spacing-4xl - $spacing-xs $spacing-lg - $spacing-xs;
  background: $color-background-secondary;
  border-radius: $border-radius-lg;
  
  svg {
    width: $spacing-4xl;
    height: $spacing-4xl;
    color: $color-vp-gray-light-3;
    margin-bottom: $spacing-md;
  }
  
  h3 {
    font-size: $font-size-lg;
    font-weight: 600;
    color: $color-gray-700;
    margin-bottom: $spacing-sm;
  }
  
  p {
    font-size: $font-size-sm;
    color: $color-gray-500;
  }
}

// Source: FeedbackHeader.scss
.feedback {
  // 프로젝트 헤더 영역
  .feedback-header {
    background: $$color-white;
    border-bottom: $spacing-2xs solid $border-color;
    padding: $spacing-lg $spacing-xl - $spacing-2xs;
    margin-bottom: $spacing-lg - $spacing-xs;
    box-shadow: $shadow-sm;
    
    .header-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      
      .header-left {
        display: flex;
        align-items: center;
        gap: $spacing-lg - $spacing-xs;
        
        // 뒤로가기 버튼
        .back-button {
          width: $spacing-2xl;
          height: $spacing-2xl;
          border-radius: $border-radius-lg - $border-radius-sm / 2;
          background: $background-light;
          border: none;
          display: flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          transition: $transition-base;
          
          &:hover {
            background: rgba($primary-color, 0.1);
            transform: translateX(-$spacing-2xs);
          }
          
          svg {
            width: $spacing-lg - $spacing-xs;
            height: $spacing-lg - $spacing-xs;
            stroke: $text-dark;
          }
        }
        
        // 프로젝트 정보
        .project-info {
          .project-name {
            font-size: $font-size-2xl;
            font-weight: 700;
            color: $text-dark;
            margin-bottom: $spacing-xs;
          }
          
          .project-meta {
            display: flex;
            align-items: center;
            gap: $spacing-md - $spacing-2xs;
            
            .meta-item {
              font-size: $font-size-sm;
              color: $text-gray;
              display: flex;
              align-items: center;
              gap: $spacing-xs;
              
              &::before {
                content: '';
                width: $spacing-xs;
                height: $spacing-xs;
                background: $text-gray;
                border-radius: $border-radius-full;
                opacity: 0.5;
              }
              
              &:first-child::before {
                display: none;
              }
            }
          }
        }
      }
      
      .header-right {
        display: flex;
        align-items: center;
        gap: $spacing-sm + $spacing-2xs;
        
        // 액션 버튼들
        .action-button {
          padding: $spacing-sm + $spacing-2xs $spacing-lg - $spacing-xs;
          border-radius: $border-radius-lg - $border-radius-sm / 2;
          border: none;
          font-size: $font-size-sm;
          font-weight: 500;
          cursor: pointer;
          transition: $transition-base;
          display: flex;
          align-items: center;
          gap: $spacing-sm;
          
          &.outline {
            background: transparent;
            border: $spacing-2xs solid $border-color;
            color: $text-dark;
            
            &:hover {
              border-color: $primary-color;
              color: $primary-color;
            }
          }
          
          &.primary {
            background: $primary-color;
            color: $$color-white;
            
            &:hover {
              background: $primary-hover;
              transform: translateY(-$spacing-2xs);
              box-shadow: $shadow;
            }
          }
          
          svg {
            width: $spacing-md + $spacing-2xs;
            height: $spacing-md + $spacing-2xs;
          }
        }
        
        // 더보기 메뉴
        .more-menu {
          position: relative;
          
          .more-button {
            width: $spacing-2xl;
            height: $spacing-2xl;
            border-radius: $border-radius-lg - $border-radius-sm / 2;
            background: $background-light;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: $transition-base;
            
            &:hover {
              background: rgba($primary-color, 0.1);
            }
            
            .dots {
              display: flex;
              gap: $spacing-xs - $spacing-2xs;
              
              span {
                width: $spacing-xs;
                height: $spacing-xs;
                background: $text-dark;
                border-radius: $border-radius-full;
              }
            }
          }
          
          .dropdown {
            position: absolute;
            top: calc(100% + $spacing-sm);
            right: $spacing-0;
            background: $$color-white;
            border-radius: $border-radius-lg;
            box-shadow: $shadow-lg;
            padding: $spacing-sm;
            min-width: $spacing-6xl * 2 + $spacing-sm;
            z-index: $z-index-sticky;
            
            .dropdown-item {
              display: flex;
              align-items: center;
              gap: $spacing-sm + $spacing-xs;
              padding: $spacing-sm + $spacing-xs $spacing-md;
              border-radius: $border-radius-md;
              cursor: pointer;
              transition: $transition-base;
              
              &:hover {
                background: $background-light;
              }
              
              svg {
                width: $spacing-md + $spacing-2xs;
                height: $spacing-md + $spacing-2xs;
                opacity: 0.6;
              }
              
              span {
                font-size: $font-size-sm;
                color: $text-dark;
              }
              
              &.danger {
                color: $color-danger;
                
                svg {
                  stroke: $color-danger;
                }
              }
            }
          }
        }
      }
    }
  }
  
  // 기존 탭 메뉴 스타일 개선
  .tab_wrap {
    background: $$color-white;
    border-radius: $border-radius-lg;
    padding: $spacing-sm;
    margin-bottom: $spacing-lg - $spacing-xs;
    box-shadow: 0 $spacing-2xs $spacing-sm rgba($color-black, 0.04);
    display: flex;
    justify-content: space-between;
    align-items: center;
    
    ul {
      display: flex;
      gap: $spacing-xs;
      margin: $spacing-0;
      padding: $spacing-0;
      list-style: none;
      
      li {
        padding: $spacing-sm + $spacing-xs $spacing-lg;
        border-radius: $border-radius-md;
        cursor: pointer;
        font-size: $spacing-md - $spacing-2xs;
        font-weight: 500;
        color: $text-gray;
        transition: $transition-base;
        min-width: $spacing-6xl + $spacing-lg;
        text-align: center;
        
        &:hover {
          background: $background-light;
          color: $text-dark;
        }
        
        &.active {
          background: $primary-color;
          color: $$color-white;
          
          &:hover {
            background: $primary-hover;
          }
        }
      }
    }
    
    .tab_btn {
      display: flex;
      gap: $spacing-sm;
      
      li {
        padding: $spacing-sm + $spacing-2xs $spacing-lg - $spacing-xs;
        background: transparent;
        border: $spacing-2xs solid $border-color;
        border-radius: $border-radius-md;
        color: $text-dark;
        font-size: $font-size-sm;
        font-weight: 500;
        cursor: pointer;
        transition: $transition-base;
        
        &:hover {
          border-color: $primary-color;
          color: $primary-color;
          background: rgba($primary-color, 0.05);
        }
      }
    }
  }
}

// Source: FeedbackLayoutRestore.scss
.feedback_section {
  // 코멘트 리스트
  .comment_list {
    .comment_item {
      display: flex;
      align-items: flex-start;
      gap: $spacing-lg;
      padding: $spacing-lg;
      border-bottom: $spacing-2xs solid $color-gray-200;
      transition: $transition-base;
      
      &:hover {
        background: $color-gray-50;
      }
      
      .avatar {
        width: $spacing-2xl;
        height: $spacing-2xl;
        border-radius: $border-radius-full;
        flex-shrink: 0;
      }
      
      .content {
        flex: 1;
        
        .header {
          display: flex;
          justify-content: space-between;
          align-items: flex-start;
          margin-bottom: $spacing-sm;
          
          .user_info {
            .name {
              font-weight: 600;
              color: $color-gray-900;
              margin-right: $spacing-sm;
            }
            
            .time {
              font-size: $font-size-sm;
              color: $color-gray-500;
            }
          }
          
          .actions {
            display: flex;
            gap: $spacing-xs;
            
            button {
              padding: $spacing-xs $spacing-sm;
              font-size: $font-size-sm;
            }
          }
        }
        
        .text {
          color: $color-gray-700;
          line-height: $line-height-relaxed;
          margin-bottom: $spacing-md;
        }
        
        .reactions {
          display: flex;
          gap: $spacing-md;
          
          .reaction_btn {
            display: flex;
            align-items: center;
            gap: $spacing-xs;
            padding: $spacing-sm - $spacing-2xs $spacing-sm + $spacing-xs;
            border: $spacing-2xs solid $color-gray-300;
            border-radius: $border-radius-base;
            background: $color-white;
            font-size: $font-size-sm;
            cursor: pointer;
            transition: $transition-base;
            
            &:hover {
              border-color: $color-primary;
              color: $color-primary;
            }
            
            &.active {
              background: $color-primary;
              border-color: $color-primary;
              color: $color-white;
            }
            
            .count {
              font-weight: 500;
            }
          }
        }
      }
    }
    
    // 답글 스타일
    .reply_list {
      margin-left: $spacing-4xl - $spacing-sm; // 아바타 너비 + gap
      margin-top: $spacing-md;
      
      .reply_item {
        padding: $spacing-md;
        background: $color-gray-50;
        border-radius: $border-radius-base;
        margin-bottom: $spacing-sm;
      }
    }
  }
  
  // 입력 영역
  .input_section {
    padding: $spacing-xl;
    background: $color-gray-50;
    border-radius: $border-radius-base;
    margin-top: $spacing-xl;
    
    .input_header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: $spacing-lg;
      
      .title {
        font-size: $font-size-lg;
        font-weight: 600;
        color: $color-gray-900;
      }
      
      .mode_selector {
        display: flex;
        gap: $spacing-sm;
        
        button {
          padding: $spacing-sm - $spacing-2xs $spacing-sm + $spacing-xs;
          font-size: $font-size-sm;
          border: $spacing-2xs solid $color-gray-300;
          border-radius: $border-radius-base;
          background: $color-white;
          cursor: pointer;
          
          &.active {
            background: $color-primary;
            border-color: $color-primary;
            color: $color-white;
          }
        }
      }
    }
    
    .input_content {
      textarea {
        width: 100%;
        min-height: $spacing-6xl + $spacing-xs;
        padding: $spacing-md;
        border: $spacing-2xs solid $color-gray-300;
        border-radius: $border-radius-base;
        resize: vertical;
        font-family: inherit;
        
        &:focus {
          outline: none;
          border-color: $color-primary;
          box-shadow: 0 0 0 $spacing-xs rgba($color-primary, 0.1);
        }
      }
      
      .input_footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: $spacing-md;
        
        .char_count {
          font-size: $font-size-sm;
          color: $color-gray-500;
        }
        
        button {
          min-width: $spacing-6xl + $spacing-xs;
        }
      }
    }
  }
}

// Source: FeedbackLayoutRestore.scss
.feedback_wrap {
  // 헤더 영역 정렬
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: $spacing-lg 0;
    border-bottom: $spacing-2xs solid $color-gray-200;
    margin-bottom: $spacing-xl;
    
    .title {
      font-size: $font-size-2xl;
      font-weight: 700;
      color: $color-gray-900;
    }
    
    .actions {
      display: flex;
      gap: $spacing-md;
    }
  }
  
  // 비디오 섹션 레이아웃
  .video_section {
    display: flex;
    gap: $spacing-xl;
    margin-bottom: $spacing-2xl;
    
    .video_inner {
      flex: 1;
      position: relative;
      
      .video-player-section {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%; // 16:9 비율
        background: $color-gray-900;
        border-radius: $border-radius-lg;
        overflow: visible; // 콘솔 버튼 표시를 위해
      }
    }
    
    .info_panel {
      width: $spacing-6xl * 3.33;
      flex-shrink: 0;
    }
  }
  
  // 탭 레이아웃
  .tab_section {
    .tab_header {
      display: flex;
      border-bottom: $spacing-2xs solid $color-gray-200;
      margin-bottom: $spacing-xl;
      
      .tab_item {
        padding: $spacing-md $spacing-xl;
        font-size: $font-size-lg;
        font-weight: 500;
        color: $color-gray-600;
        border-bottom: $spacing-2xs solid transparent;
        margin-bottom: -$spacing-2xs;
        cursor: pointer;
        transition: $transition-base;
        
        &.active {
          color: $color-primary;
          border-bottom-color: $color-primary;
        }
        
        &:hover:not(.active) {
          color: $color-gray-800;
        }
      }
    }
  }
  
  // 컨트롤 박스 레이아웃
  .etc_box {
    background: $color-gray-50;
    padding: $spacing-lg;
    border-radius: $border-radius-base;
    margin-bottom: $spacing-xl;
    
    .flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: $spacing-md;
      
      .left {
        display: flex;
        gap: $spacing-sm;
      }
      
      .good {
        display: flex;
        gap: $spacing-sm;
        
        button {
          display: flex;
          align-items: center;
          gap: $spacing-xs;
          
          span {
            font-weight: 500;
          }
        }
      }
      
      .right {
        display: flex;
        gap: $spacing-sm;
      }
    }
  }
}

// Source: FeedbackButtons.scss
.feedback-button {
  display: inline-flex;
  align-items: center;
  gap: $spacing-sm;
  padding: $spacing-sm + $spacing-2xs $spacing-lg - $spacing-xs;
  border: none;
  border-radius: $border-radius-md;
  font-size: $font-size-sm;
  font-weight: 600;
  cursor: pointer;
  transition: $transition-base;
  
  svg {
    width: $spacing-md;
    height: $spacing-md;
  }
  
  &:hover {
    transform: translateY(-$spacing-2xs);
  }
  
  &:active {
    transform: translateY(0);
  }
}

// Source: FeedbackButtons.scss
.feedback-button-container {
  display: flex;
  gap: $spacing-sm + $spacing-xs;
  flex-wrap: wrap;
  align-items: center;
  margin-top: $spacing-lg - $spacing-xs;
}

// Source: FeedbackButtons.scss
.feedback-button-danger {
  @extend .feedback-button;
  background: linear-gradient(135deg, $color-danger 0%, $color-gray-800 100%);
  color: $color-white;
  box-shadow: $shadow;
  
  &:hover {
    box-shadow: 0 $spacing-sm $font-size-xl rgba($color-danger, 0.4);
  }
}

// Source: FeedbackButtons.scss
.feedback-button-outline {
  @extend .feedback-button;
  background: $color-white;
  color: $color-primary;
  border: $spacing-2xs solid $color-primary;
  
  &:hover {
    background: $color-primary;
    color: $color-white;
    box-shadow: $shadow;
  }
}

// Source: FeedbackButtons.scss
.feedback-button-primary {
  @extend .feedback-button;
  background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
  color: $color-white;
  box-shadow: $shadow;
  
  &:hover {
    box-shadow: 0 $spacing-sm $font-size-xl rgba($color-primary, 0.4);
  }
}

// Source: FeedbackButtons.scss
.feedback-button-secondary {
  @extend .feedback-button;
  background: linear-gradient(135deg, $color-gray-600 0%, $color-gray-600 100%);
  color: $color-white;
  box-shadow: $shadow;
  
  &:hover {
    box-shadow: 0 $spacing-sm $font-size-xl rgba($color-gray-600, 0.4);
  }
}

// Source: FeedbackButtons.scss
.feedback-button-toggle {
  display: inline-flex;
  align-items: center;
  gap: $spacing-sm;
  padding: $spacing-sm $spacing-md;
  background: $color-background-secondary;
  color: $color-gray-700;
  border: $spacing-2xs solid $color-vp-gray-light-3;
  border-radius: $border-radius-md - $border-radius-sm / 2;
  font-size: $font-size-sm;
  font-weight: 500;
  cursor: pointer;
  transition: $transition-base;
  
  &:hover {
    background: $color-vp-gray-light-2;
    color: $color-gray-900;
  }
  
  &:active {
    background: $color-vp-gray-light-3;
  }
}

// Source: FeedbackPage.scss
.feedback-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: $color-gray-100;
}

// Source: FeedbackGridLayout.module.scss
.feedback-date-group {
  margin-bottom: $spacing-lg;
  
  .date-header {
    font-size: $spacing-md - $spacing-xs;
    font-weight: 700;
    color: $color-gray-700;
    margin-bottom: $spacing-md;
    padding-left: $spacing-sm - $spacing-2xs;
    display: flex;
    align-items: center;
    gap: $spacing-sm;
    position: relative;
    
    &::before {
      content: '';
      position: absolute;
      left: $spacing-0;
      top: 50%;
      transform: translateY(-50%);
      width: $spacing-2xs;
      height: $spacing-md;
      background: $brand-blue;
      border-radius: $spacing-2xs;
    }
    
    &::after {
      content: '';
      flex: 1;
      height: $spacing-2xs;
      background: linear-gradient(90deg, $color-vp-gray-light-2 0%, transparent 100%);
    }
  }
  
  .feedback-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax($spacing-6xl * 4.4, 1fr));
    gap: $spacing-sm;
  }
}

