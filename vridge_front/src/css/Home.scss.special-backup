@media screen and (max-width: $breakpoint-lg) {
  #Home {
    #header {
      .inner {
        padding: $spacing-sm + 2px 0 0;
        .logo {
          img {
            width: 100px;
          }
        }
        .etc {
          ul {
            li {
              width: $spacing-lg + 6px;
              height: $spacing-lg + 6px;
              margin-left: $spacing-sm + 2px;
            }
          }
          button.submit {
            width: $spacing-5xl;
            height: $spacing-2xl;
            font-size: 15px;
            margin-left: $spacing-lg - $spacing-xs;
          }
        }
      }
    }
    #container {
      .visual {
        padding: 100px 0 50px;
        .inner {
          display: block;
          &:before {
            display: none;
          }
          .txt {
            font-size: 26px;
            text-align: center;
            width: 100%;
            p {
              font-size: $font-size-base;
            }
          }
          .img {
            width: 100%;
            max-width: 360px;
            margin: $spacing-3xl + 2px auto 0;
          }
        }
      }

      .textbox {
        padding: $spacing-3xl + 2px 2%;
        img {
          width: 240px;
        }
        div {
          line-height: 1.4;
          font-size: 22px;
        }
        p {
          font-size: $font-size-base;
          word-break: keep-all;
        }
      }

      .function {
        padding: 100px 0 0;
        .inner {
          h2 {
            span {
              font-size: 26px;
              &:after {
                font-size: $font-size-xl;
                left: auto;
                right: -10px;
                top: $spacing-0;
              }
            }
          }
          .content {
            display: block;
            margin-top: $spacing-lg + 6px;
            .img {
              width: 100%;
              margin-top: $spacing-lg + 6px;
            }
            .txt {
              width: 100%;
              div {
                font-size: $font-size-3xl;
                padding-top: $spacing-2xl;
                span {
                  font-size: 17px;
                }
              }
              p {
                font-size: 15px;
                margin-top: $spacing-md - 1px;
              }
              .submit {
                margin-top: $spacing-lg - $spacing-xs;
                border-radius: $border-radius-sm + 1px;
                width: 120px;
                height: $spacing-2xl;
                color: $color-white;
                background: #25282f;
                font-size: 15px;
              }
            }
          }
        }
        &.feedback {
          .inner {
            .content {
              .txt {
                div {
                  &:before {
                    content: '';
                    display: block;
                    width: $spacing-xl + $spacing-xs;
                    height: $spacing-xl + $spacing-xs;
                  }
                }
              }
            }
          }
        }
        &.project {
          .inner {
            .content {
              flex-direction: row-reverse;
              .txt {
                div {
                  &:before {
                    content: '';
                    display: block;
                    width: $spacing-xl + $spacing-xs;
                    height: $spacing-xl + $spacing-xs;
                  }
                }
              }
            }
          }
        }
        &.comment {
          .inner {
            .content {
              .txt {
                div {
                  &:before {
                    content: '';
                    display: block;
                    width: $spacing-xl + $spacing-xs;
                    height: $spacing-xl + $spacing-xs;
                  }
                }
              }
            }
          }
        }
        &.contents {
          padding: 150px 0;
          .inner {
            .content {
              flex-direction: row-reverse;
              .list {
                width: 100%;
                margin-top: $spacing-lg + 6px;
                ul {
                  grid-gap: $spacing-sm + 2px;
                  grid-template-columns: repeat(2, 1fr);
                  li {
                    height: 180px;
                    border-radius: $border-radius-lg - 2px;
                    .text {
                      color: $color-white;
                      font-size: $font-size-base;
                      font-weight: 500;
                    }
                  }
                }
              }
              .txt {
                div {
                  &:before {
                    content: '';
                    display: block;
                    width: $spacing-xl + $spacing-xs;
                    height: $spacing-xl + $spacing-xs;
                  }
                }
              }
            }
          }
        }
      }

      .identity {
        background: #f4f7fe;
        padding: 100px 0;
        .inner {
          h2 {
            span {
              font-size: 26px;
              &:after {
                font-size: $font-size-xl;
                left: auto;
                right: -10px;
                top: $spacing-0;
              }
            }
          }
          ul {
            margin-top: $spacing-lg + 6px;
            grid-gap: $spacing-sm + 2px;
            grid-template-columns: repeat(2, 1fr);
            li {
              .img {
                width: 120px;
                height: 120px;
                border-radius: $border-radius-lg - 2px;
                box-shadow: 16px 10px 16px rgba($color-black, 0.2);
                img {
                  width: $spacing-4xl - $spacing-xs;
                }
              }
              .txt {
                font-size: $font-size-lg;
                font-weight: 500;
                line-height: 1.2;
                margin-top: $spacing-sm + 2px;
                text-align: center;
              }
            }
          }
        }
      }

      .background {
        padding: 100px 0;
        .inner {
          h2 {
            span {
              font-size: 22px;
              &:after {
                content: '*';
                display: block;
                color: $color-black;
                font-size: $font-size-xl;
                position: absolute;
                right: -10px;
                top: -10px;
              }
            }
          }
          .group {
            display: block;
            justify-content: initial;
            margin-top: $spacing-3xl + 2px;
            .txt_box {
              font-size: $font-size-xl;
              line-height: 1.6;
              word-break: keep-all;
              br {
                display: none;
              }
              span {
                display: block;
                font-family: 'psb';
                font-size: $font-size-base;
                margin-bottom: $spacing-sm + 2px;
              }
              b {
                line-height: 1.2;
                margin-top: $spacing-0;
              }
            }
            .ex {
              margin-top: $spacing-3xl + 2px;
              .part {
                display: block;
                position: relative;
                .img {
                  position: absolute;
                  width: $spacing-2xl;
                  height: $spacing-2xl;
                  right: -5px;
                  top: $spacing-0;
                  &:before {
                    content: '';
                    display: block;
                    width: $spacing-2xl;
                    height: $spacing-2xl;
                    border-radius: 100%;
                    position: absolute;
                    left: $spacing-0;
                    top: $spacing-0;
                    background: #0059db;
                  }
                  img {
                    height: 44px;
                    position: absolute;
                    left: 50%;
                    transform: translateX(-50%);
                    top: -8px;
                    max-width: initial;
                    &.img01 {
                      height: $spacing-2xl;
                    }
                    &.img02 {
                      height: $spacing-xl + $spacing-xs;
                      top: -4px;
                    }
                  }
                }
                .text {
                  background: $color-white;
                  padding: $spacing-lg - $spacing-xs;
                  box-shadow: 5px 5px 10px #e8e8e8;
                  width: 100%;
                  div {
                    span {
                      background: #0059db;
                      display: inline-block;
                      border-radius: $border-radius-lg - 2px;
                      padding: $spacing-xs 8px;
                      font-size: $font-size-xs;
                      color: $color-white;
                      img {
                        height: $spacing-sm + 2px;
                        vertical-align: middle;
                        margin: -2px 4px 0 0;
                      }
                    }
                  }
                  p {
                    font-size: $font-size-base;
                    margin-top: $spacing-sm + 2px;
                    word-break: keep-all;
                    b {
                      word-break: keep-all;
                    }
                  }
                }
                &:nth-child(1) {
                  .text {
                    border-radius: 20px 20px 20px 0;
                    margin-left: 00px;
                  }
                }
                &:nth-child(2) {
                  .text {
                    border-radius: 20px 20px 0 20px;
                    margin-right: 00px;
                  }
                }
              }
            }
          }
        }
      }

      .video {
        padding: $spacing-4xl - $spacing-xs 0;
        .inner {
          width: 100%;
          h2 {
            padding: $spacing-0 20px;
            margin-bottom: $spacing-lg + 6px;
            span {
              font-size: 22px;
              line-height: 1.3;
              &:after {
                content: '*';
                display: block;
                color: $color-white;
                font-size: $font-size-xl;
                position: absolute;
                right: -10px;
                top: -10px;
              }
              br {
                display: block;
              }
            }
          }
          .video-wrap {
            position: relative;
            padding-bottom: 56.25%;
            iframe {
              position: absolute;
              top: $spacing-0;
              left: $spacing-0;
              right: $spacing-0;
              bottom: $spacing-0;
              width: 100%;
              height: 100%;
            }
          }
        }
      }

      .end {
        padding: $spacing-5xl 0 30px;
        .inner {
          display: block;
          .txt {
            font-size: 26px;
            margin-right: 00px;
            text-align: center;
          }
          .img {
            width: 100%;
            max-width: 360px;
            margin: $spacing-3xl + 2px auto 0;
          }
        }
        .ment {
          font-size: $font-size-lg;
          img {
            width: 22px;
          }
        }
      }

