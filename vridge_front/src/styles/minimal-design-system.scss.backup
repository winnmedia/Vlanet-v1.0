// VideoPlanet Minimal Design System v3.0
// Inspired by Apple, Linear, and Notion

// 1. 극도로 제한된 색상 팔레트 (5색)
:root {
  // Core colors
  --white: #FFFFFF;
  --black: #000000;
  --gray: #6E6E73;  // WCAG AA 기준 충족 (기존 #8B8B8D에서 변경)
  --blue: #0066FF;  // Apple Blue
  --red: #FF3B30;   // iOS Red
  
  // Semantic colors
  --background: var(--white);
  --foreground: var(--black);
  --muted: var(--gray);
  --accent: var(--blue);
  --danger: var(--red);
  
  // Subtle variations
  --border: rgba(0, 0, 0, 0.08);
  --border-hover: rgba(0, 0, 0, 0.12);
  --overlay: rgba(255, 255, 255, 0.9);
}

// 2. SF Pro 기반 타이포그래피 (황금비 1.618)
:root {
  // Font family
  --font-sans: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 
               'Helvetica Neue', 'Helvetica', 'Arial', sans-serif;
  --font-mono: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace;
  
  // Type scale (황금비)
  --text-xs: 0.694rem;    // 11px
  --text-sm: 0.833rem;    // 13px
  --text-base: 1rem;      // 16px
  --text-lg: 1.2rem;      // 19px
  --text-xl: 1.44rem;     // 23px
  --text-2xl: 1.728rem;   // 28px
  --text-3xl: 2.074rem;   // 33px
  --text-4xl: 2.488rem;   // 40px
  
  // Line heights (단 2개)
  --leading-tight: 1.2;
  --leading-normal: 1.6;
  
  // Font weights (단 3개)
  --font-normal: 400;
  --font-medium: 500;
  --font-semibold: 600;
  
  // Letter spacing
  --tracking-tight: -0.02em;
  --tracking-normal: 0;
  --tracking-wide: 0.02em;
}

// 3. 8pt 그리드 시스템
:root {
  --spacing-0: 0;
  --spacing-1: 0.5rem;   // 8px
  --spacing-2: 1rem;     // 16px
  --spacing-3: 1.5rem;   // 24px
  --spacing-4: 2rem;     // 32px
  --spacing-5: 2.5rem;   // 40px
  --spacing-6: 3rem;     // 48px
  --spacing-8: 4rem;     // 64px
  --spacing-10: 5rem;    // 80px
  --spacing-12: 6rem;    // 96px
  --spacing-16: 8rem;    // 128px
}

// 4. 애니메이션 (Apple 스타일 easing)
:root {
  // Durations
  --duration-fast: 150ms;
  --duration-normal: 200ms;
  --duration-slow: 300ms;
  
  // Easing curves
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);      // Apple's ease-out
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);  // Apple's ease-in-out
  --spring: cubic-bezier(0.34, 1.56, 0.64, 1);    // Spring effect
}

// 5. 레이아웃
:root {
  // Containers
  --container-sm: 640px;
  --container-md: 768px;
  --container-lg: 1024px;
  --container-xl: 1280px;
  
  // Border radius (미세한)
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-full: 9999px;
}

// 6. 그림자 대신 보더
@mixin border-subtle {
  border: 1px solid var(--border);
  transition: border-color var(--duration-normal) var(--ease-out);
  
  &:hover {
    border-color: var(--border-hover);
  }
}

// 7. 미니멀 컴포넌트 믹스인

// Button
@mixin button-minimal($variant: 'primary') {
  // Reset
  appearance: none;
  border: none;
  background: none;
  font: inherit;
  cursor: pointer;
  
  // Base styles
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-1);
  padding: 0 var(--spacing-3);
  height: 40px;
  font-size: var(--text-base);
  font-weight: var(--font-medium);
  line-height: var(--leading-tight);
  letter-spacing: var(--tracking-tight);
  border-radius: var(--radius-md);
  transition: all var(--duration-normal) var(--ease-out);
  position: relative;
  overflow: hidden;
  
  @if $variant == 'primary' {
    background: var(--black);
    color: var(--white);
    
    &:hover {
      transform: translateY(-1px);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }
    
    &:active {
      transform: translateY(0);
      box-shadow: none;
    }
  } @else if $variant == 'secondary' {
    @include border-subtle;
    background: var(--white);
    color: var(--black);
    
    &:hover {
      background: rgba(0, 0, 0, 0.02);
    }
    
    &:active {
      background: rgba(0, 0, 0, 0.05);
    }
  } @else if $variant == 'ghost' {
    color: var(--black);
    
    &:hover {
      background: rgba(0, 0, 0, 0.05);
    }
    
    &:active {
      background: rgba(0, 0, 0, 0.1);
    }
  }
  
  &:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
  }
  
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
}

// Card
@mixin card-minimal {
  @include border-subtle;
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: var(--spacing-4);
  transition: all var(--duration-normal) var(--ease-out);
  
  &:hover {
    transform: translateY(-2px);
  }
}

// Input
@mixin input-minimal {
  appearance: none;
  border: none;
  background: none;
  font: inherit;
  
  width: 100%;
  padding: var(--spacing-2) 0;
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  border-bottom: 1px solid var(--border);
  transition: all var(--duration-normal) var(--ease-out);
  
  &::placeholder {
    color: var(--muted);
  }
  
  &:hover {
    border-color: var(--border-hover);
  }
  
  &:focus {
    outline: none;
    border-color: var(--accent);
  }
  
  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
}

// Layout utilities
.container {
  width: 100%;
  max-width: var(--container-lg);
  margin: 0 auto;
  padding: 0 var(--spacing-4);
}

.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

.gap-1 { gap: var(--spacing-1); }
.gap-2 { gap: var(--spacing-2); }
.gap-3 { gap: var(--spacing-3); }
.gap-4 { gap: var(--spacing-4); }

// Typography utilities
.text-xs { font-size: var(--text-xs); }
.text-sm { font-size: var(--text-sm); }
.text-base { font-size: var(--text-base); }
.text-lg { font-size: var(--text-lg); }
.text-xl { font-size: var(--text-xl); }
.text-2xl { font-size: var(--text-2xl); }

.font-normal { font-weight: var(--font-normal); }
.font-medium { font-weight: var(--font-medium); }
.font-semibold { font-weight: var(--font-semibold); }

.text-muted { color: var(--muted); }
.text-accent { color: var(--accent); }
.text-danger { color: var(--danger); }

// Spacing utilities
.mt-1 { margin-top: var(--spacing-1); }
.mt-2 { margin-top: var(--spacing-2); }
.mt-3 { margin-top: var(--spacing-3); }
.mt-4 { margin-top: var(--spacing-4); }

.mb-1 { margin-bottom: var(--spacing-1); }
.mb-2 { margin-bottom: var(--spacing-2); }
.mb-3 { margin-bottom: var(--spacing-3); }
.mb-4 { margin-bottom: var(--spacing-4); }

// Animation classes
.fade-in {
  animation: fadeIn var(--duration-slow) var(--ease-out) forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

// Focus management
.focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

// Screen reader only
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}