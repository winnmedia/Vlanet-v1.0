@import '../styles/design-tokens';

// 완료 버튼 스타일
.completeBtn {
  width: $spacing-lg - $spacing-xs;
  height: $spacing-lg - $spacing-xs;
  padding: $spacing-0;
  border: none;
  background: transparent;
  color: $color-gray-600;
  cursor: pointer;
  transition: $transition-base;
  display: flex;
  align-items: center;
  justify-content: center;
  
  &:hover {
    color: $color-primary;
    transform: scale(1.1);
  }
  
  &.completed {
    color: $color-primary;
    
    &:hover {
      color: $color-primary-dark;
    }
  }
  
  &:active {
    transform: scale(0.95);
  }
}

.projectPhaseBoard {
  margin-top: $spacing-xl;
  background: transparent;
  border-radius: $border-radius-none;
  padding: $spacing-0;
  box-shadow: $shadow-none;
  border: none;
  
  // 헤더 스타일
  .phaseBoardHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: $spacing-lg;
    padding-bottom: $spacing-md;
    border-bottom: $spacing-2xs solid $color-vp-gray-light-2;
    
    .phaseBoardTitle {
      font-size: $font-size-2xl;
      font-weight: 700;
      color: $color-gray-900;
      margin: $spacing-0;
      letter-spacing: -0.$spacing-sm;
    }
    
    .phaseBoardControls {
      display: flex;
      align-items: center;
      gap: $spacing-lg;
      
      .filterTabs {
        display: flex;
        gap: $spacing-sm + $spacing-xs;
        background: transparent;
        padding: $spacing-0;
        
        .filterTab {
          padding: $spacing-sm + $spacing-2xs $spacing-lg - $spacing-xs;
          border: $spacing-2xs solid $color-gray-300;
          background: $color-white;
          color: $color-gray-700;
          font-size: $font-size-sm;
          font-weight: 500;
          cursor: pointer;
          border-radius: $border-radius-md;
          transition: $transition-base;
          display: flex;
          align-items: center;
          gap: $spacing-sm;
          box-shadow: $shadow-sm;
          
          .count {
            font-size: $font-size-base;
            font-weight: 700;
            padding: $spacing-xs $spacing-sm + $spacing-2xs;
            background: $color-gray-100;
            border-radius: $border-radius-md - $border-radius-sm / 2;
            min-width: $spacing-xl;
            text-align: center;
            color: $color-gray-700;
            
            &.delayed {
              background: #fee;
              color: $color-danger;
            }
          }
          
          &:hover {
            background: $color-background-secondary;
            border-color: $color-primary;
            transform: translateY(-$spacing-2xs);
            box-shadow: 0 $spacing-2xs $spacing-sm rgba($color-primary, 0.15);
            
            .count {
              background: $color-info;
              color: $color-primary;
            }
          }
          
          &.active {
            background: $color-primary;
            color: white;
            border-color: $color-primary;
            box-shadow: 0 $spacing-2xs $spacing-sm rgba($color-primary, $opacity-25);
            
            .count {
              background: rgba($color-white, 0.2);
              color: white;
            }
          }
        }
      }
      
      .collapseBtn {
        width: $spacing-xl + $spacing-xs;
        height: $spacing-xl + $spacing-xs;
        border: none;
        background: white;
        border-radius: $border-radius-lg - $border-radius-sm / 2;
        cursor: pointer;
        transition: $transition-base;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 $spacing-2xs $spacing-sm rgba($color-black, 0.06);
        color: $color-gray-600;
        
        &:hover {
          background: $color-background-secondary;
          transform: translateY(-$spacing-2xs);
          box-shadow: $shadow;
          color: $color-primary;
        }
        
        &:active {
          transform: translateY(0);
        }
        
        &:focus {
          outline: none;
        }
      }
    }
  }
  
  .boardHeader {
    margin-bottom: $spacing-0;
    
    .collapseBtn {
      width: $spacing-xl;
      height: $spacing-xl;
      border: none;
      background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
      border-radius: $border-radius-full;
      cursor: pointer;
      transition: $transition-base;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 $spacing-2xs $spacing-sm rgba($color-primary, $opacity-25);
      
      &:hover {
        transform: translateY(-$spacing-2xs);
        box-shadow: $shadow;
      }
      
      &:active {
        transform: translateY(0);
        box-shadow: $shadow-sm;
      }
      
      &:focus {
        outline: none;
      }
    }
  }

  // 프로젝트 카운트 섹션 - 백업과 동일한 스타일
  .projectCountsSection {
    margin-bottom: $spacing-lg + $spacing-xs + $spacing-2xs;
    
    ul.schedule {
      display: grid;
      grid-gap: $spacing-0 $spacing-lg - $spacing-xs;
      grid-template-columns: repeat(4, 1fr);
      
      li {
        background: $color-gray-800;
        border-radius: $spacing-lg + $spacing-2xs;
        height: 140px;
        padding: $spacing-0 $spacing-xl - $spacing-2xs;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: $spacing-lg - $spacing-2xs;
        color: $color-white;
        
        br {
          display: block;
        }
        
        span {
          display: block;
          font-weight: bold;
          font-size: $spacing-3xl + $spacing-2xs;
          margin-top: $spacing-sm + $spacing-2xs;
        }
        
        &:first-child {
          background: $color-vp-blue-4;
        }
      }
    }
  }
  
  .boardContent {
    animation: fadeIn 0.3s ease;
    
    .projectsContainer {
      display: flex;
      flex-direction: column;
      gap: $spacing-md;
    }
    
    .emptyState {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: $spacing-4xl - $spacing-xs $spacing-lg - $spacing-xs;
      text-align: center;
      
      svg {
        margin-bottom: $spacing-md;
      }
      
      p {
        color: $color-gray-600;
        font-size: $font-size-sm;
        margin: $spacing-0;
      }
    }
  }
  
  .projectCard {
    background: white;
    border: $spacing-2xs solid $color-vp-gray-light-2;
    border-radius: $border-radius-xl;
    overflow: hidden;
    transition: $transition-base-bezier(0.4, 0, 0.2, 1);
    position: relative;
    
    &.hasDelayed {
      border-color: rgba($color-danger, 0.2);
      
      &:hover {
        border-color: rgba($color-danger, 0.3);
        box-shadow: $shadow-lg;
      }
    }
    
    &:hover {
      border-color: rgba($color-primary, 0.2);
      box-shadow: $shadow-lg;
      transform: translateY(-$spacing-2xs);
    }
    
    .projectHeader {
      padding: $spacing-lg - $spacing-xs $spacing-lg;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.2s;
      
      &:hover {
        background: $color-gray-100;
      }
      
      .projectMainInfo {
        flex: 1;
        
        .projectTitleRow {
          display: flex;
          align-items: center;
          gap: $spacing-sm + $spacing-xs;
          margin-bottom: $spacing-sm;
          
          .projectName {
            font-size: $font-size-base;
            font-weight: 600;
            color: $color-gray-900;
            margin: $spacing-0;
            letter-spacing: -0.$spacing-xs;
          }
          
          .delayIndicator {
            display: flex;
            align-items: center;
            justify-content: center;
            width: $spacing-lg;
            height: $spacing-lg;
            
            svg {
              animation: pulse 2s infinite;
            }
          }
        }
        
        .projectDetails {
          display: flex;
          align-items: center;
          gap: $spacing-md;
          
          .projectDates {
            font-size: $spacing-md - $spacing-xs;
            color: $color-gray-600;
            font-weight: 500;
          }
          
          .projectDuration {
            font-size: $spacing-md - $spacing-xs;
            color: $color-gray-600;
            padding: $spacing-2xs $spacing-sm;
            background: $color-background-secondary;
            border-radius: $border-radius-lg;
            font-weight: 500;
          }
        }
      }
      
      .projectActions {
        display: flex;
        align-items: center;
        gap: $spacing-md;
        
        .progressIndicator {
          position: relative;
          width: $spacing-3xl;
          height: $spacing-3xl;
          
          .progressRing {
            transform: rotate(-90deg);
          }
          
          .progressText {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: $font-size-xs;
            font-weight: 700;
            color: $color-gray-900;
          }
        }
        
        .expandToggle {
          width: $spacing-xl;
          height: $spacing-xl;
          border: none;
          background: $color-background-secondary;
          border-radius: $border-radius-md;
          cursor: pointer;
          transition: $transition-base;
          display: flex;
          align-items: center;
          justify-content: center;
          color: $color-gray-600;
          
          &:hover {
            background: $color-vp-gray-light-2;
            color: $color-primary;
          }
          
          &:focus {
            outline: none;
          }
        }
      }
    }
    
    // 타임라인 스타일
    .phasesTimeline {
      padding: $spacing-lg;
      background: $color-gray-100;
      border-top: $spacing-2xs solid $color-vp-gray-light-2;
      
      .phaseItem {
        display: flex;
        align-items: flex-start;
        position: relative;
        
        &:last-child .phaseLine {
          display: none;
        }
        
        .phaseDot {
          width: $spacing-lg;
          height: $spacing-lg;
          border-radius: $border-radius-full;
          background: $color-vp-gray-light-2;
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
          position: relative;
          z-index: 2;
          transition: $transition-base;
          
          .pulseDot {
            width: $spacing-sm;
            height: $spacing-sm;
            background: white;
            border-radius: $border-radius-full;
            animation: pulse 2s infinite;
          }
        }
        
        .phaseLine {
          position: absolute;
          left: $spacing-sm + $spacing-xs - $spacing-2xs;
          top: $spacing-lg;
          width: $spacing-2xs;
          height: calc(100% + $spacing-md);
          background: $color-vp-gray-light-2;
          z-index: $z-index-base;
        }
        
        &.completed {
          .phaseDot {
            background: $color-success;
            box-shadow: $shadow;
          }
          
          .phaseLine {
            background: $color-success;
          }
        }
        
        &.inProgress {
          .phaseDot {
            background: $color-primary;
            box-shadow: $shadow;
          }
          
          .phaseLine {
            background: linear-gradient(to bottom, $color-primary 0%, $color-vp-gray-light-2 100%);
          }
        }
        
        &.delayed {
          .phaseDot {
            background: $color-danger;
            box-shadow: $shadow;
          }
        }
        
        &.pending {
          opacity: 0.6;
        }
        
        .phaseContent {
          flex: 1;
          margin-left: $spacing-md;
          padding-bottom: $spacing-lg;
        }
        
        .phaseHeader {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: $spacing-sm;
          margin-bottom: $spacing-xs;
          
          .phaseName {
            font-size: $font-size-sm;
            font-weight: 600;
            color: $color-gray-900;
            letter-spacing: -0.$spacing-2xs;
          }
        }
        
        .phaseDates {
          display: flex;
          align-items: center;
          gap: $spacing-sm;
          
          .dateRange {
            font-size: $font-size-xs;
            color: $color-gray-600;
            font-weight: 500;
          }
          
          .delayBadge {
            font-size: $spacing-sm + $spacing-xs;
            color: $color-danger;
            font-weight: 600;
            padding: $spacing-2xs $spacing-sm;
            background: rgba($color-danger, 0.1);
            border-radius: $border-radius-lg - $border-radius-sm / 2;
          }
        }
        
        .noDataMessage {
          font-size: $font-size-xs;
          color: $color-gray-500;
          font-style: italic;
        }
      }
    }
  }
  
  // 반응형 디자인
  @media (max-width: $breakpoint-md) { padding: $spacing-md;
    
    .boardHeader {
      flex-direction: column;
      align-items: flex-start;
      gap: $spacing-sm + $spacing-xs;
    }
    
    .projectCard {
      .projectHeader {
        flex-wrap: wrap;
        
        .projectInfo {
          flex: 100%;
          margin-bottom: $spacing-sm;
        }
      }
      
      .projectPhases {
        grid-template-columns: 1fr;
      }
    }
  }
  
    // 프로젝트 카운트 섹션 스타일
  .projectCountsSection {
    margin: $spacing-lg 0;
    animation: fadeIn 0.3s ease;
    
    ul.schedule {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      gap: $spacing-md !important;
      width: 100%;
      max-width: 100%;
      margin: $spacing-0;
      padding: $spacing-0;
      list-style: none;
      
      li {
        background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%) !important;
        border-radius: $border-radius-xl !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
        align-items: center !important;
        height: $spacing-6xl + $spacing-xs !important;
        padding: $spacing-md !important;
        color: $color-white !important;
        font-size: $font-size-sm !important;
        font-weight: 500 !important;
        line-height: $line-height-base !important;
        text-align: center !important;
        box-shadow: $shadow;
        transition: $transition-base-bezier(0.4, 0, 0.2, 1) !important;
        border: $spacing-2xs solid rgba($color-white, 0.1) !important;
        position: relative;
        overflow: hidden;
        
        &::before {
          content: '';
          position: absolute;
          top: -50%;
          left: -50%;
          width: 200%;
          height: 200%;
          background: radial-gradient(circle, rgba($color-white, 0.1) 0%, transparent 70%);
          opacity: 0;
          transition: opacity 0.3s;
        }
        
        &:hover {
          transform: translateY(-$spacing-xs) !important;
          box-shadow: $shadow-lg;
          
          &::before {
            opacity: 1;
          }
        }
        
        br {
          display: none !important;
        }
        
        span {
          font-weight: 700 !important;
          font-size: $spacing-lg + $spacing-xs !important;
          margin-top: $spacing-sm - $spacing-2xs !important;
          display: block !important;
        }
        
        &:first-child {
          background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%) !important;
        }
        
        &:nth-child(2) {
          background: linear-gradient(135deg, $color-gray-900 0%, $color-black 100%) !important;
        }
        
        &:nth-child(3) {
          background: linear-gradient(135deg, $color-gray-900 0%, $color-black 100%) !important;
        }
      }
    }
  }
}

// 반응형 스타일 추가
@media (max-width: $breakpoint-xl) { .projectPhaseBoard { .projectCountsSection { ul.schedule li { font-size: $spacing-md - $spacing-xs - $spacing-2xs !important;
        height: $spacing-6xl !important;
        padding: $spacing-sm + $spacing-xs !important;
        
        span {
          font-size: $font-size-2xl !important;
        }
      }
    }
  }
}

@media (max-width: $breakpoint-md) { .projectPhaseBoard { .projectCountsSection { ul.schedule { grid-template-columns: 1fr !important;
        gap: $spacing-sm + $spacing-xs !important;
        
        li {
          height: $spacing-4xl + $spacing-xs + $spacing-2xs !important;
          flex-direction: row !important;
          justify-content: space-between !important;
          padding: $spacing-sm + $spacing-xs $spacing-lg - $spacing-xs !important;
          
          span {
            font-size: $spacing-lg - $spacing-2xs !important;
            margin-top: $spacing-0 !important;
            margin-left: $spacing-sm + $spacing-xs !important;
          }
        }
      }
    }
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-$spacing-sm + $spacing-2xs);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% { 
    transform: scale(1);
    opacity: 1;
  }
  50% { 
    transform: scale(1.1);
    opacity: 0.8;
  }
}