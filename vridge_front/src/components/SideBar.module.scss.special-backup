@import '../styles/design-tokens';

.SideBar {
  width: 300px;
  padding: $spacing-3xl + 2px 30px;
  position: sticky; // sticky로 변경하여 스크롤 시에도 고정
  top: $spacing-0;
  box-shadow: 16px 0px 16px rgba($color-black, 0.06);
  border-radius: $border-radius-none 30px 30px 0;
  z-index: 10;
  background: $color-white;
  height: 100vh; // 뷰포트 전체 높이
  box-sizing: border-box;
  flex-shrink: 0; // 플렉스박스에서 크기 고정
  align-self: flex-start; // 상단에 정렬
  nav {
    ul {
      li {
        margin-top: $spacing-3xl + 2px;
        padding: $spacing-0 0px 0px 50px;
        border-radius: 15px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: $font-size-lg;
        position: relative;
        &:first-child {
          margin-top: $spacing-0;
        }
        &:before {
          content: '';
          display: block;
          width: 34px;
          height: 34px;
          position: absolute;
          left: $spacing-0;
          top: 50%;
          transform: translateY(-50%);
          border-radius: $border-radius-lg - 2px;
        }
        &:nth-child(1) {
          &:before {
            background: #e4e4e4 url('../images/Cms/h_l_b.svg') no-repeat;
            background-size: 16px;
            background-position: center;
          }
          &.active {
            color: #012$color-white;
            &:before {
              background: #012$color-white url('../images/Cms/h_l_w.svg') no-repeat;
              background-size: 16px;
              background-position: center;
            }
            span {
              color: $color-black;
            }
          }
        }
        &:nth-child(2) {
          &:before {
            background: #e4e4e4 url('../images/Cms/c_l_b.svg') no-repeat;
            background-size: 16px;
            background-position: center;
          }
          &.active {
            color: #012$color-white;
            &:before {
              background: #012$color-white url('../images/Cms/c_l_w.svg') no-repeat;
              background-size: 16px;
              background-position: center;
            }
            span {
              color: $color-black;
            }
          }
        }
        &:nth-child(3) {
          &:before {
            background: #e4e4e4 url('../images/Cms/p_l_b.svg') no-repeat;
            background-size: 16px;
            background-position: center;
          }
          &.active {
            color: #012$color-white;
            &:before {
              background: #012$color-white url('../images/Cms/p_l_w.svg') no-repeat;
              background-size: 16px;
              background-position: center;
            }
            span {
              color: $color-black;
            }
          }
        }
        &:nth-child(4) {
          &:before {
            background: #e4e4e4 url('../images/Cms/f_l_b.svg') no-repeat;
            background-size: 16px;
            background-position: center;
          }
          &.active {
            color: #012$color-white;
            &:before {
              background: #012$color-white url('../images/Cms/f_l_w.svg') no-repeat;
              background-size: 16px;
              background-position: center;
            }
            span {
              color: $color-black;
            }
          }
        }
        &:nth-child(5) {
          &:before {
            background: #e4e4e4 url('../images/Cms/oc_l_b.svg') no-repeat;
            background-size: 16px;
            background-position: center;
          }
          &.active {
            color: #012$color-white;
            &:before {
              background: #012$color-white url('../images/Cms/oc_l_w.svg') no-repeat;
              background-size: 16px;
              background-position: center;
            }
            span {
              color: $color-black;
            }
          }
        }

        &:hover {
          color: #012$color-white;
          span {
            transform: scale(1.1);
            box-shadow: 0 3px 6px rgba($color-primary, 0.3);
          }
        }
        &.menu_project {
          display: flex;
          justify-content: space-between;
          align-items: center;
          
          span {
            display: inline-block;
            width: 26px;
            height: 26px;
            line-height: 26px;
            padding: $spacing-0;
            background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
            color: $color-white;
            text-align: center;
            font-size: 13px;
            font-weight: 600;
            border-radius: $border-radius-full;
            margin-left: $spacing-sm;
            margin-right: $spacing-sm + 2px;
            box-shadow: 0 2px 4px rgba($color-primary, 0.2);
            transition: all 0.3s ease;
          }
        }
        
        // 토글 아이콘이 있는 메뉴 아이템
        &.has-toggle {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding-right: $spacing-md - 1px;
          
          &::after {
            content: '';
            display: inline-block;
            width: $spacing-0;
            height: $spacing-0;
            border-left: $spacing-xs solid transparent;
            border-right: $spacing-xs solid transparent;
            border-top: 6px solid $color-gray-500;
            margin-left: auto;
            transition: transform 0.3s ease;
          }
          
          &.active::after {
            transform: rotate(180deg);
            border-top-color: #012$color-white;
          }
          
          &:hover::after {
            border-top-color: #012$color-white;
          }
          
          // 프로젝트 메뉴의 경우 카운트 뱃지와 토글 아이콘이 함께 표시
          &.menu_project {
            span {
              margin-right: $spacing-sm + 2px;
            }
          }
        }
      }
    }
  }
  .mypage {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 120px;
    width: calc(100% - 60px);
    text-align: center;
    line-height: 54px;
    background: $color-gray-100;
    color: $color-gray-800;
    border-radius: 15px;
    height: 54px;
    font-size: $font-size-base;
    cursor: pointer;
    transition: all 0.3s;
    &:hover {
      background: #e0e0e0;
      color: #012$color-white;
    }
    &.active {
      background: #012$color-white;
      color: $color-white;
    }
  }
  .logout {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: $spacing-3xl + 2px;
    width: calc(100% - 60px);
    text-align: Center;
    line-height: 54px;
    background: #25282f;
    color: $color-white;
    border-radius: 15px;
    height: 54px;
    font-size: $font-size-base;
    cursor: pointer;
  }
}
.Submenu {
  width: 330px;
  padding: $spacing-0; // 패딩 제거
  box-shadow: 16px 0px 16px rgba($color-black, 0.06);
  border-radius: $border-radius-none 30px 30px 0;
  overflow: hidden; // 스크롤 영역 제어
  position: fixed;
  left: $spacing-0;
  top: $spacing-0;
  height: 100vh; // 사이드바와 동일한 뷰포트 높이
  background: rgba(248, 248, 248, 0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: 2; // 사이드바보다 낮은 z-index
  transform: translateX(-100%); // 왼쫝으로 완전히 숨김
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  pointer-events: none;
  opacity: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  &.active {
    transform: translateX(300px); // 사이드바 너비(300px)만큼 이동
    pointer-events: auto;
    opacity: 1;
    // 슬라이드 애니메이션 강조
    animation: slideFromLeft 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  
  @keyframes slideFromLeft {
    from {
      transform: translateX(0);
      opacity: 0;
    }
    to {
      transform: translateX(300px);
      opacity: 1;
    }
  }
  &::-webkit-scrollbar {
    display: none;
  }
  & {
    -ms-overflow-style: none;
  }
  .etc {
    padding: $spacing-3xl + 2px 40px 20px 40px; // 사이드바 홈버튼 위치와 맞춤
    text-align: right;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba($color-black, 0.1); // 홈버튼 위 줄과 동일한 느낌
    .ss_title {
      font-size: $font-size-xl;
    }
    ul {
      li {
        display: inline-block;
        width: 34px;
        height: 34px;
        border-radius: 100%;
        text-align: center;
        text-indent: -99$color-gray-500px;
        cursor: pointer;
        position: relative;
        z-index: 20;
        &.plus {
          background: #efefef url('../images/Common/plus_icon.png') no-repeat;
          background-size: 16px;
          background-position: center;
        }
        &.close {
          background: #efefef url('../images/Common/close_icon.png') no-repeat;
          background-size: 12px;
          background-position: center;
          margin-left: $spacing-sm + 2px;
        }
      }
    }
  }
  nav {
    padding: $spacing-lg + 6px 40px; // 적절한 패딩
    flex: 1; // 남은 공간 차지
    overflow-y: auto;
    ul {
      li {
        margin-top: $spacing-lg + 6px;
        line-height: 1.3;
        cursor: pointer;
        transition: all 0.3s;
        font-size: $font-size-lg;
        position: relative;
        z-index: 10;
        padding: $spacing-sm + 2px;
        margin-left: -10px;
        margin-right: -10px;
        border-radius: $border-radius-md;
        &:hover {
          color: #012$color-white;
          background: rgba(1, 47, 255, 0.05);
        }
        &:first-child {
          margin-top: $spacing-0;
        }
      }
    }
  }
  .empty {
    margin-top: $spacing-3xl + 2px;
    font-size: $font-size-lg;
    text-align: center;
    .submit {
      margin-top: $spacing-lg + 6px;
      font-size: $font-size-base;
    }
  }
  
  .empty {
    margin-top: $spacing-3xl + 2px;
    font-size: $font-size-lg;
    text-align: center;
    padding: $spacing-0 40px;
    .submit {
      margin-top: $spacing-lg + 6px;
      font-size: $font-size-base;
    }
  }
}
