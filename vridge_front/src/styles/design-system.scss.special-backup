@import '../styles/design-tokens';

// VideoPlanet Design System v3.0
// Minimal Design Philosophy: Less is More

// 1. 색상 시스템 - 극도로 제한된 팔레트
$colors: (
  // Core Colors (5 colors only)
  white: $color-white,
  black: $color-black,
  gray: #8B8B8D,     // 단일 회색톤
  blue: #0066FF,     // Apple Blue - 주요 액센트
  red: #FF3B30,      // iOS Red - 오류/위험 상태만
  
  // Legacy mapping (기존 코드 호환성)
  primary-500: #0066FF,
  primary-600: #0052CC,
  gray-50: #FAFAFA,
  gray-100: $color-gray-100,
  gray-200: #EEE$color-gray-200,
  gray-300: #E0E0E0,
  gray-400: #BDBDBD,
  gray-500: #9E9E9E,
  gray-600: #757575,
  gray-700: #616161,
  gray-800: #424242,
  gray-900: #212121,
  danger: #FF3B30,
  success: #34C759,
  warning: #FF9500,
  info: #007AFF,
);

// 2. 타이포그래피 - SF Pro 중심의 깨끗한 체계
$typography: (
  // Font families - Apple 스타일
  font-primary: ('SF Pro Display', 'SF Pro Text', -apple-system, 'Inter', sans-serif),
  font-mono: ('SF Mono', 'Monaco', 'Fira Code', monospace),
  
  // Font sizes - 황금비 기반 스케일
  text-xs: 0.694rem,   // 11px
  text-sm: 0.833rem,   // 13px
  text-base: 1rem,     // 16px
  text-lg: 1.2rem,     // 19px
  text-xl: 1.44rem,    // 23px
  text-2xl: 1.728rem,  // 28px
  text-3xl: 2.074rem,  // 33px
  text-4xl: 2.488rem,  // 40px
  
  // Line heights - 단순화
  leading-tight: 1.2,
  leading-normal: 1.6,
  leading-relaxed: 1.8,
  
  // Font weights - 3단계로 축소
  font-normal: 400,
  font-medium: 500,
  font-semibold: 600,
  font-bold: 600,  // bold를 semibold로 통일
);

// 3. 간격 시스템 - 8pt 그리드
$spacing: (
  0: 0,
  1: 0.5rem,    // 8px
  2: 1rem,      // 16px
  3: 1.5rem,    // 24px
  4: 2rem,      // 32px
  5: 2.5rem,    // 40px
  6: 3rem,      // 48px
  8: 4rem,      // 64px
  10: 5rem,     // 80px
  12: 6rem,     // 96px
  16: 8rem,     // 128px
);

// 4. 그림자 - 최소화 (보더로 대체)
$shadows: (
  none: none,
  subtle: (0 1px 3px rgba($color-black, 0.04)),  // 아주 미세한 그림자
  // Legacy mapping
  sm: (0 1px 2px rgba($color-black, 0.04)),
  base: (0 1px 3px rgba($color-black, 0.04)),
  md: (0 2px 4px rgba($color-black, 0.06)),
  lg: (0 4px 6px rgba($color-black, 0.07)),
  xl: (0 8px 12px rgba($color-black, 0.08)),
  brand: none,  // 브랜드 그림자 제거
);

// 5. 애니메이션 - Apple 스타일 Easing
$transitions: (
  fast: 200ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
  base: 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
  slow: $duration-slower cubic-bezier(0.25, 0.46, 0.45, 0.94),
  // Easing functions
  ease-out: cubic-bezier(0.215, 0.61, 0.355, 1),
  ease-in-out: cubic-bezier(0.645, 0.045, 0.355, 1),
);

// 6. Border radius - 일관된 곡률
$radii: (
  none: 0,
  sm: 6px,      // 작은 요소
  base: 8px,    // 기본값
  md: 10px,     // 중간 요소
  lg: 12px,     // 큰 요소
  xl: 16px,     // 특대 요소
  full: 9$color-gray-500px, // 원형
);

// 7. Breakpoints
$breakpoints: (
  sm: 640px,
  md: 768px,
  lg: 1024px,
  xl: 1280px,
  2xl: 1536px,
);

// 8. Z-index
$z-indices: (
  base: 1,
  dropdown: 1$color-black,
  sticky: 1100,
  fixed: 1200,
  modal-backdrop: 1300,
  modal: 1400,
  popover: 1500,
  tooltip: 1600,
  notification: 1700,
);

// Mixins - 미니멀 스타일
@mixin button-minimal {
  // Reset
  appearance: none;
  border: none;
  background: none;
  font: inherit;
  
  // Base
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: map-get($spacing, 1);
  padding: $spacing-0 map-get($spacing, 3);
  height: 44px; // Apple 표준
  
  // Typography
  font-weight: map-get($typography, font-medium);
  font-size: map-get($typography, text-base);
  letter-spacing: -0.01em;
  
  // Style
  border-radius: map-get($radii, base);
  transition: all map-get($transitions, fast);
  cursor: pointer;
  user-select: none;
  
  &:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  
  &:focus-visible {
    outline: 2px solid map-get($colors, blue);
    outline-offset: 2px;
  }
}

@mixin card-minimal {
  background: map-get($colors, white);
  border: 1px solid rgba($color-black, 0.08);
  border-radius: map-get($radii, lg);
  padding: map-get($spacing, 4);
  transition: border-color map-get($transitions, base);
  
  &:hover {
    border-color: rgba($color-black, 0.12);
  }
}

@mixin text-truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@mixin visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: $spacing-0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

// Utility functions
@function color($name) {
  @return map-get($colors, $name);
}

@function space($size) {
  @return map-get($spacing, $size);
}

@function shadow($size) {
  @return map-get($shadows, $size);
}

// Export for JavaScript
:export {
  @each $name, $value in $colors {
    #{$name}: $value;
  }
}