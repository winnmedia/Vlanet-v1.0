@import '../styles/design-tokens';

.Header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: $spacing-5xl;
  padding: $spacing-0 30px;
  
  // 알림 관련 스타일
  .notification-wrapper {
    position: relative;
    
    .notification-icon {
      color: $color-gray-600;
      transition: all 0.2s ease;
      
      &:hover {
        color: $color-primary;
        transform: scale(1.1);
      }
      
      svg {
        transition: all 0.2s ease;
      }
    }
    
    .notification-dropdown {
      animation: slideDown 0.2s ease;
      border: 1px solid #e1e5e9;
      
      @keyframes slideDown {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      // 스크롤바 커스터마이징
      ::-webkit-scrollbar {
        width: 6px;
      }
      
      ::-webkit-scrollbar-track {
        background: #f1f1f1;
      }
      
      ::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: $border-radius-sm - 1px;
      }
      
      ::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8;
      }
    }
  }
  .logo {
    img {
      width: 150px;
    }
  }
  .profile-wrapper {
    position: relative;
    
    .profile {
      display: flex;
      align-items: center;
      justify-content: start;
      gap: $spacing-sm + $spacing-xs; // 아이템 간 간격 추가
      cursor: pointer;
      padding: $spacing-sm 12px;
      border-radius: $border-radius-md;
      transition: background-color 0.3s;
      
      &:hover {
        background-color: #f0f0f0;
      }
      
      .nick {
        width: $spacing-2xl;
        height: $spacing-2xl;
        background: #516e8b;
        border-radius: 100%;
        position: relative;
        overflow: hidden;
        line-height: $spacing-2xl;
        text-align: Center;
        font-size: $font-size-base;
        color: $color-white;
        
        &.clickable {
          cursor: pointer;
        }
      }
      .mail {
        font-size: 13px;
      }
    }
    
    .dropdown-menu {
      position: absolute;
      top: 100%;
      right: $spacing-0;
      margin-top: $spacing-sm;
      background: white;
      border-radius: $border-radius-md;
      box-shadow: 0 2px 10px rgba($color-black, 0.1);
      min-width: 200px;
      z-index: 1$color-black;
      overflow: hidden;
      
      .dropdown-item {
        display: flex;
        align-items: center;
        padding: $spacing-sm + $spacing-xs 20px;
        font-size: $font-size-sm;
        color: $color-gray-800;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
        
        &::before {
          content: '';
          position: absolute;
          left: $spacing-0;
          top: 50%;
          transform: translateY(-50%);
          width: 3px;
          height: $spacing-0;
          background: #0058da;
          transition: height 0.2s ease;
        }
        
        &:hover {
          background-color: $color-background-secondary;
          color: #0058da;
          padding-left: $spacing-lg;
          
          &::before {
            height: 60%;
          }
        }
        
        &.logout {
          color: #ff4757;
          
          &:hover {
            background-color: #fff1f0;
            color: #ff4757;
            
            &::before {
              background: #ff4757;
            }
          }
        }
      }
      
      .dropdown-divider {
        height: 1px;
        background-color: #e0e0e0;
        margin: $spacing-xs 0;
      }
    }
    
    .profile-photo {
      width: $spacing-2xl;
      height: $spacing-2xl;
      border-radius: $border-radius-full;
      object-fit: cover;
      border: 2px solid #0058da;
      cursor: pointer;
    }
  }
}
