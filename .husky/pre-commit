#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 실행 중: Pre-commit 검증..."

# 프론트엔드 디렉토리로 이동
cd vridge_front

# Import 검증 실행
echo "📦 Import 검증 중..."
node ../automation-scripts/import-validator.js

# ESLint 실행
echo "🔧 ESLint 검사 중..."
npm run lint:fix

# Prettier 실행
echo "💅 코드 포맷팅 중..."
npm run format

# 테스트 실행 (선택적)
echo "🧪 빠른 테스트 실행 중..."
node ../automation-scripts/quick-test.js

echo "✅ Pre-commit 검증 완료!"