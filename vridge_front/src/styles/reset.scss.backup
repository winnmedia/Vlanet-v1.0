/* CSS Reset - VideoPlanet */
/* 브라우저 기본 스타일 초기화 */

*, *::before, *::after {
  box-sizing: border-box;
}

* {
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
}

body {
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

img, picture, video, canvas, svg {
  display: block;
  max-width: 100%;
}

input, button, textarea, select {
  font: inherit;
}

p, h1, h2, h3, h4, h5, h6 {
  overflow-wrap: break-word;
}

#root, #__next {
  isolation: isolate;
}

/* 링크 스타일 초기화 */
a {
  color: inherit;
  text-decoration: none;
}

/* 리스트 스타일 초기화 */
ul, ol {
  list-style: none;
}

/* 버튼 스타일 초기화 */
button {
  background: none;
  border: none;
  cursor: pointer;
}