{
  "name": "videoplanet-frontend",
  "version": "2.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headless": "cypress run --headless",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cy:run",
    "test:e2e:open": "start-server-and-test dev http://localhost:3000 cy:open",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:visual": "playwright test tests/visual",
    "test:a11y": "playwright test tests/accessibility",
    "test:update": "playwright test --update-snapshots",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "style:analyze": "node scripts/analyze-styles.js",
    "style:imports": "node scripts/find-style-imports.js",
    "style:health": "node scripts/style-health-check.js",
    "style:clean": "npm run style:imports && bash scripts/delete-unused-styles.sh",
    "design:consistency": "node scripts/design-consistency-analyzer.js",
    "design:visual-diff": "node scripts/visual-diff-analyzer.js",
    "design:analyze": "npm run design:consistency && npm run design:visual-diff",
    "tokenize": "node scripts/auto-tokenize.js",
    "tokenize:advanced": "node scripts/advanced-tokenizer.js",
    "analyze:buttons": "grep -r 'button\\|btn\\|Button' src --include='*.scss' --include='*.css' | wc -l",
    "setup:linter": "npm install --save-dev stylelint stylelint-config-standard-scss stylelint-config-prettier-scss stylelint-scss stylelint-order",
    "lint:styles": "stylelint 'src/**/*.scss' --fix",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production' && !process.env.CI) { require('child_process').execSync('husky install', {stdio: 'inherit'}); }\"",
    "console:analyze": "node scripts/console-log-analyzer.js",
    "console:remove-debug": "node scripts/console-log-analyzer.js --remove --no-dry-run",
    "console:remove-all": "node scripts/console-log-analyzer.js --remove-all --no-dry-run",
    "console:safe-analyze": "node scripts/safe-console-remover.js --analyze",
    "console:safe-remove": "node scripts/safe-console-remover.js --remove --no-dry-run",
    "console:safe-wrap": "node scripts/safe-console-remover.js --wrap --no-dry-run",
    "console:cleanup": "node scripts/safe-console-remover.js --phased"
  },
  "dependencies": {
    "@ant-design/plots": "^2.6.1",
    "@react-oauth/google": "^0.12.2",
    "@reduxjs/toolkit": "^2.8.2",
    "@videojs/themes": "^1.0.1",
    "@vidstack/react": "^0.6.15",
    "antd": "^5.26.6",
    "axios": "^1.10.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "form-data": "^4.0.4",
    "immer": "^10.1.1",
    "moment": "^2.30.1",
    "next": "15.4.2",
    "playwright": "^1.54.1",
    "puppeteer": "^24.14.0",
    "query-string": "^9.2.2",
    "react": "^18.3.1",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.0",
    "react-kakao-login": "^2.1.1",
    "react-redux": "^9.2.0",
    "react-switch": "^7.1.0",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "sass": "^1.89.2",
    "styled-components": "^6.1.19",
    "swiper": "^11.2.10",
    "video.js": "^8.23.3",
    "videojs-hotkeys": "^0.2.30",
    "videojs-markers": "^1.0.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.0.5",
    "babel-plugin-styled-components": "^2.1.4",
    "glob": "^11.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "5.8.3"
  }
}