            .story-title {
              font-size: $font-size-sm;
              color: $color-gray-800;
              font-weight: 500;
              flex: 1;
            }
          }

          .more-stories {
            text-align: center;
            color: $color-gray-600;
            font-size: 13px;
            padding: $spacing-sm;
            background: $color-background-secondary;
            border-radius: $border-radius-md - 2px;
            margin-top: $spacing-sm;
          }
        }

        // 씬 미리보기 스타일
        .scenes-preview {
          .scene-preview-item {
            display: flex;
            align-items: center;
            gap: $spacing-sm + $spacing-xs;
            padding: $spacing-sm 12px;
            background: $color-background-secondary;
            border-radius: $border-radius-md - 2px;
            margin-bottom: $spacing-sm;

            .scene-number {
              font-size: 13px;
              font-weight: 600;
              color: $color-primary;
              background: white;
              padding: $spacing-xs 8px;
              border-radius: $border-radius-sm;
              min-width: $spacing-4xl - $spacing-xs;
              text-align: center;
            }

            .scene-location {
              font-size: $font-size-sm;
              color: $color-gray-800;
              flex: 1;
            }

            .has-storyboard {
              font-size: $font-size-xs;
              color: #22c55e;
              background: #f0fdf4;
              padding: 2px 6px;
              border-radius: $border-radius-sm;
              font-weight: 500;
            }
          }

          .more-scenes {
            font-size: 13px;
            color: $color-gray-600;
            text-align: center;
            padding: $spacing-sm;
            font-style: italic;
          }
        }

        // 전체 내용 표시 스타일
        .full-content {
          .planning-options-display {
            margin-top: $spacing-lg - $spacing-xs;
            padding: $spacing-md;
            background: $color-background-secondary;
            border-radius: $border-radius-md;

            h5 {
              font-size: $font-size-sm;
              font-weight: 600;
              color: $color-gray-800;
              margin-bottom: $spacing-sm + $spacing-xs;
            }

            .options-grid {
              display: flex;
              flex-wrap: wrap;
              gap: $spacing-sm;

              .option-tag {
                background: #e0ebff;
                color: $color-primary;
                padding: $spacing-xs 10px;
                border-radius: $border-radius-xl;
                font-size: $font-size-xs;
                font-weight: 500;
              }
            }
          }

          .story-preview-full {
            padding: $spacing-lg - $spacing-xs;
            background: $color-background-secondary;
            border-radius: $border-radius-md;
            margin-bottom: $spacing-md;

            h5 {
              font-size: $font-size-base;
              font-weight: 600;
              color: #1a1a1a;
              margin-bottom: $spacing-sm;
            }

            .story-stage-name {
              font-size: 13px;
              color: $color-primary;
              background: #f0f4ff;
              padding: $spacing-xs 10px;
              border-radius: $border-radius-sm;
              display: inline-block;
              margin-bottom: $spacing-sm + $spacing-xs;
            }

            .story-summary {
              font-size: $font-size-sm;
              color: $color-gray-800;
              line-height: 1.6;
              margin-bottom: $spacing-sm + $spacing-xs;
            }

            .story-detail {
              margin-top: $spacing-md;
              padding: $spacing-sm + $spacing-xs;
              background: white;
              border-radius: $border-radius-md - 2px;
              border-left: 3px solid $color-primary;

              h6 {
                font-size: 13px;
                font-weight: 600;
                color: $color-gray-800;
                margin-bottom: $spacing-sm;
              }

              p {
                font-size: 13px;
                color: $color-gray-600;
                line-height: 1.5;
              }
            }

            .story-characters {
              font-size: 13px;
              color: $color-gray-600;
              margin-top: $spacing-sm;
            }
          }

          &.scenes-full {
            .scene-preview-full {
              padding: $spacing-lg - $spacing-xs;
              background: $color-background-secondary;
              border-radius: $border-radius-md;
              margin-bottom: $spacing-md;

              .scene-header-full {
                display: flex;
                align-items: center;
                gap: $spacing-sm + $spacing-xs;
                margin-bottom: $spacing-sm + $spacing-xs;

                h5 {
                  font-size: $font-size-base;
                  font-weight: 600;
                  color: #1a1a1a;
                  margin: $spacing-0;
                }

                .scene-time {
                  font-size: 13px;
                  color: $color-gray-600;
                  background: white;
                  padding: $spacing-xs 8px;
                  border-radius: $border-radius-sm;
                }

                .scene-stage-tag {
                  font-size: $font-size-xs;
                  color: $color-primary;
                  background: #f0f4ff;
                  padding: $spacing-xs 8px;
                  border-radius: $border-radius-sm;
                  font-weight: 500;
                }
              }

              .scene-description {
                font-size: $font-size-sm;
                color: $color-gray-800;
                line-height: 1.6;
                margin-bottom: $spacing-sm + $spacing-xs;
              }

              .scene-dialogue,
              .scene-purpose,
              .scene-characters {
                font-size: 13px;
                color: $color-gray-600;
                margin-bottom: $spacing-sm;

                strong {
                  color: $color-gray-800;
                  font-weight: 600;
                }
              }

              .scene-storyboard-preview {
                margin-top: $spacing-md;
                padding: $spacing-sm + $spacing-xs;
                background: white;
                border-radius: $border-radius-md;
                text-align: center;

                img {
                  max-width: 100%;
                  max-height: 300px;
                  border-radius: $border-radius-md - 2px;
                  box-shadow: 0 2px 8px rgba($color-black, 0.1);
                }
              }
            }
          }
        }
      }
    }
  }

  // 애니메이션 정의
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  // 네비게이션 스타일 개선
  .planning-navigation {
    .nav-step {
      cursor: pointer;
      transition: all 0.2s ease;

      &:hover:not(.disabled) {
        opacity: 0.8;
      }

      &.disabled {
        cursor: not-allowed;
        opacity: 0.3;
      }

      &.current {
        .step-number {
          box-shadow: 0 0 0 3px rgba(1, 47, 255, 0.2);
        }
      }
    }
  }

  // 버튼 그룹 스타일 (가로 길이 고정)
  .button-group {
    display: flex;
    justify-content: center;
    gap: $spacing-md;
    margin-top: $spacing-lg + 6px;
    margin-bottom: $spacing-lg - $spacing-xs;
    
    button {
      min-width: 140px; // 최소 가로 길이 고정
      padding: $spacing-sm + $spacing-xs 24px;
      border: none;
      border-radius: $border-radius-md;
      font-size: $font-size-base;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: $spacing-sm;
      
      &.back-btn {
        background: #6c757d;
        color: white;
        
        &:hover {
          background: #5a6268;
          transform: translateY(-1px);
        }
      }
      
      &.generate-btn,
      &.next-btn {
        background: linear-gradient(135deg, $color-primary, $color-primary-dark);
        color: white;
        
        &:hover {
          background: linear-gradient(135deg, $color-primary-dark, #0A1A99);
          transform: translateY(-1px);
        }
        
        &:disabled {
          background: $color-gray-400$color-gray-400;
          color: $color-gray-600$color-gray-600;
          cursor: not-allowed;
          transform: none;
        }
      }
      
      &.export-btn {
        background: linear-gradient(135deg, $color-primary, $color-primary-dark);
        color: white;
        
        &:hover {
          background: linear-gradient(135deg, $color-primary-dark, #0A1A99);
          transform: translateY(-1px);
        }
      }
      
      &.reset-btn {
        background: $color-danger;
        color: white;
        
        &:hover {
          background: #c82$color-gray-800;
          transform: translateY(-1px);
        }
      }
    }
  }

  // 고속 콘티 생성 관련 스타일
  .batch-actions {
    background: white;
    padding: $spacing-lg - $spacing-xs;
    border-radius: $border-radius-lg;
    border: 1px solid #e0e0e0;
    margin-bottom: $spacing-lg + 6px;
    
    .batch-buttons {
      display: flex;
      gap: $spacing-sm + $spacing-xs;
      margin-bottom: $spacing-md;
      flex-wrap: wrap;
      
      .generate-all-btn {
        background: linear-gradient(135deg, $color-primary, $color-primary-dark);
        color: white;
        border: none;
        padding: $spacing-sm + $spacing-xs 20px;
        border-radius: $border-radius-md;
        font-size: $font-size-sm;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: $spacing-sm;
        min-width: 160px;
        justify-content: center;
        
        &:hover:not(:disabled) {
          background: linear-gradient(135deg, $color-primary-dark, #0A1A99);
          transform: translateY(-1px);
        }
        
        &:disabled {
          background: $color-gray-400$color-gray-400;
          color: $color-gray-600$color-gray-600;
          cursor: not-allowed;
          transform: none;
        }
      }
      
      .generate-all-fast-btn {
        background: linear-gradient(135deg, #ff6b35, #f7931e);
        color: white;
        border: none;
        padding: $spacing-sm + $spacing-xs 20px;
        border-radius: $border-radius-md;
        font-size: $font-size-sm;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: $spacing-sm;
        min-width: 160px;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.3);
        
        &:hover:not(:disabled) {
          background: linear-gradient(135deg, #ff5722, #f57c00);
          transform: translateY(-1px);
          box-shadow: 0 4px 12px rgba(255, 107, 53, 0.4);
        }
        
        &:disabled {
          background: $color-gray-400$color-gray-400;
          color: $color-gray-600$color-gray-600;
          cursor: not-allowed;
          transform: none;
          box-shadow: $shadow-none;
        }
      }
    }
    
    .batch-info {
      display: flex;
      flex-direction: column;
      gap: $spacing-sm + $spacing-xs;
      
      > span {
        font-size: $font-size-sm;
        color: $color-gray-600;
      }
      
      .generation-progress {
        display: flex;
        flex-wrap: wrap;
        gap: $spacing-sm;
        
        .progress-item {
          padding: $spacing-xs 8px;
          border-radius: $border-radius-md - 2px;
          font-size: $font-size-xs;
          font-weight: 500;
          
          &.pending {
            background: $color-gray-100;
            color: $color-gray-600;
          }
          
          &.generating {
            background: #fff3cd;
            color: #856404;
            animation: pulse 1.5s ease-in-out infinite;
          }
          
          &.completed {
            background: #d4edda;
            color: #155724;
          }
          
          &.error {
            background: #f8d7da;
            color: #721c24;
          }
        }
      }
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  // 영상 업로드 섹션 스타일
  .video-upload-section {
    max-width: 800px;
    margin: $spacing-0 auto;

    .upload-area {
      background: $color-background-secondary;
      border: 2px dashed #d0d7de;
      border-radius: $border-radius-lg;
      padding: $spacing-2xl 20px;
      text-align: center;
      margin-bottom: $spacing-lg + 6px;
      transition: all 0.3s ease;

      &:hover {
        border-color: #4318FF;
        background: #f0f7ff;
      }

      .upload-icon {
        font-size: $font-size-5xl;
        margin-bottom: $spacing-md;
      }

      h4 {
        font-size: $font-size-xl;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: $spacing-sm;
      }

      p {
        color: $color-gray-600;
        margin-bottom: $spacing-lg;
        font-size: $font-size-sm;
      }

      .upload-btn {
        display: inline-block;
        background: linear-gradient(135deg, $color-primary, $color-primary-dark);
        color: white;
        padding: $spacing-sm + $spacing-xs 24px;
        border-radius: $border-radius-md;
        text-decoration: none;
        font-weight: 600;
        margin-right: $spacing-sm + $spacing-xs;
        cursor: pointer;
        transition: all 0.2s;
        min-width: 140px;

        &:hover {
          background: linear-gradient(135deg, $color-primary-dark, #0A1A99);
          transform: translateY(-1px);
        }
      }

      .upload-guide-btn {
        background: #6c757d;
        color: white;
        border: none;
        padding: $spacing-sm + $spacing-xs 24px;
        border-radius: $border-radius-md;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        min-width: 140px;

        &:hover {
          background: #5a6268;
          transform: translateY(-1px);
        }
      }
    }

    .uploaded-video-preview {
      background: white;
      border-radius: $border-radius-lg;
      padding: $spacing-lg;
      box-shadow: 0 2px 8px rgba($color-black, 0.1);
      margin-bottom: $spacing-lg + 6px;

      h5 {
        font-size: $font-size-lg;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: $spacing-md;
      }

      video {
        margin-bottom: $spacing-md;
        box-shadow: 0 2px 8px rgba($color-black, 0.1);
      }

      .video-info {
        background: $color-background-secondary;
        padding: $spacing-md;
        border-radius: $border-radius-md;
        margin-bottom: $spacing-md;

        p {
          margin: $spacing-xs 0;
          font-size: $font-size-sm;
          color: $color-gray-800;

          strong {
            color: #1a1a1a;
          }
        }
      }

      .video-actions {
        display: flex;
        gap: $spacing-sm + $spacing-xs;

        button {
          border: none;
          padding: $spacing-sm + 2px 20px;
          border-radius: $border-radius-md - 2px;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.2s;
          min-width: 140px;

          &.replace-video-btn {
            background: $color-warning;
            color: $color-gray-800;

            &:hover {
              background: #e0a800;
              transform: translateY(-1px);
            }
          }

          &.delete-video-btn {
            background: $color-danger;
            color: white;

            &:hover {
              background: #c82$color-gray-800;
              transform: translateY(-1px);
            }
          }
        }
      }
    }

    .step-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: $spacing-md;

      .prev-step-btn {
        background: #6c757d;
        color: white;
        border: none;
        padding: $spacing-sm + $spacing-xs 24px;
        border-radius: $border-radius-md;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        min-width: 140px;

        &:hover {
          background: #5a6268;
          transform: translateY(-1px);
        }
      }

      .complete-project-btn {
        background: linear-gradient(135deg, $color-success, #20c997);
        color: white;
        border: none;
        padding: $spacing-md - 2px 28px;
        border-radius: $border-radius-md;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-size: $font-size-base;
        min-width: 180px;

        &:hover:not(:disabled) {
          background: linear-gradient(135deg, #218838, #1fa07a);
          transform: translateY(-1px);
          box-shadow: 0 4px 12px rgba($color-success, 0.3);
        }

        &:disabled {
          background: #d6d8db;
          color: #6c757d;
          cursor: not-allowed;
          transform: none;
          box-shadow: $shadow-none;
        }
      }
    }
  }
  
  // 프레임워크 선택 스타일
  .framework-selection {
    background: white;
    border-radius: $border-radius-lg;
    padding: $spacing-lg - $spacing-xs;
    margin-bottom: $spacing-lg;
    box-shadow: 0 2px 8px rgba($color-black, 0.08);
    
    .framework-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: $spacing-md;
      
      h4 {
        font-size: $font-size-base;
        font-weight: 600;
        color: $color-gray-800;
        margin: $spacing-0;
        display: flex;
        align-items: center;
        gap: $spacing-sm;
      }
      
      .framework-select-btn {
        background: white;
        border: 2px solid $color-primary;
        color: $color-primary;
        padding: $spacing-sm + 2px 20px;
        border-radius: $border-radius-md;
        font-size: $font-size-sm;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: $spacing-sm;
        
        &:hover {
          background: $color-primary;
          color: white;
        }
        
        .arrow {
          font-size: 10px;
          transition: transform 0.3s ease;
        }
      }
    }
    
    .framework-dropdown {
      background: $color-background-secondary;
      border: 1px solid #e0e0e0;
      border-radius: $border-radius-md;
      padding: $spacing-sm + $spacing-xs;
      margin-bottom: $spacing-md;
      
      .no-framework {
        text-align: center;
        padding: $spacing-lg - $spacing-xs;
        
        p {
          color: $color-gray-600;
          margin-bottom: $spacing-sm + $spacing-xs;
        }
        
        .create-framework-btn {
          background: $color-primary;
          color: white;
          border: none;
          padding: $spacing-sm + 2px 20px;
          border-radius: $border-radius-md - 2px;
          font-size: $font-size-sm;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.3s ease;
          
          &:hover {
            background: $color-primary-dark;
          }
        }
      }
      
      .framework-list {
        display: flex;
        flex-direction: column;
        gap: $spacing-sm;
        
        .framework-option {
          background: white;
          padding: $spacing-sm + $spacing-xs 16px;
          border-radius: $border-radius-md;
          cursor: pointer;
          transition: all 0.3s ease;
          border: 2px solid transparent;
          
          &:hover {
            border-color: $color-primary;
            box-shadow: 0 2px 4px rgba($color-primary, 0.1);
          }
          
          &.selected {
            border-color: $color-primary;
            background: #f0f4ff;
          }
          
          .framework-name {
            font-size: $font-size-sm;
            font-weight: 600;
            color: $color-gray-800;
            margin-bottom: $spacing-xs;
            display: flex;
            align-items: center;
            gap: $spacing-sm;
            
            .default-badge {
              background: $color-primary;
              color: white;
              font-size: 11px;
              padding: 2px 8px;
              border-radius: $border-radius-lg;
              font-weight: 500;
            }
          }
          
          .framework-preview {
            font-size: $font-size-xs;
            color: $color-gray-600;
            
            .preview-item {
              display: block;
              white-space: nowrap;
              overflow: hidden;
              text-overflow: ellipsis;
            }
          }
        }
      }
    }
    
    .selected-framework-info {
      background: #f0f4ff;
      border-radius: $border-radius-md;
      padding: $spacing-md;
      
      h5 {
        font-size: $font-size-sm;
        font-weight: 600;
        color: $color-primary;
        margin-bottom: $spacing-sm + $spacing-xs;
      }
      
      .framework-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: $spacing-sm + $spacing-xs;
        
        .detail-item {
          background: white;
          padding: $spacing-sm + $spacing-xs;
          border-radius: $border-radius-md - 2px;
          
          strong {
            display: block;
            font-size: $font-size-xs;
            color: $color-primary;
            margin-bottom: $spacing-xs;
          }
          
          p {
            font-size: $font-size-xs;
            color: $color-gray-600;
            line-height: 1.5;
            margin: $spacing-0;
          }
        }
      }
    }
  }
  
  // 개별 씬 로딩 인디케이터 스타일
  .scene-loading-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: $spacing-2xl 20px;
    min-height: 200px;
    
    .loading-spinner {
      width: $spacing-2xl;
      height: $spacing-2xl;
      border: 3px solid #f3f3f3;
      border-top: 3px solid $color-primary;
      border-radius: $border-radius-full;
      animation: spin 1s linear infinite;
      margin-bottom: $spacing-md;
    }
    
    .loading-message {
      font-size: $font-size-sm;
      color: $color-gray-600;
      text-align: center;
      margin-bottom: $spacing-md;
      line-height: 1.5;
    }
    
    .loading-progress {
      width: 100%;
      max-width: 200px;
      height: 6px;
      background: #f0f0f0;
      border-radius: $border-radius-sm - 1px;
      overflow: hidden;
      
      .progress-bar {
        height: 100%;
        background: linear-gradient(135deg, $color-primary, $color-primary-dark);
        transition: width 0.3s ease;
        border-radius: $border-radius-sm - 1px;
      }
    }
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  
  // 콘티 섹션 스타일 개선
  .storyboard-section {
    position: relative;
    
    &.loading {
      pointer-events: none;
      opacity: 0.8;
    }
    
    .storyboard-empty {
      background: $color-background-secondary;
      border: 2px dashed #e0e0e0;
      border-radius: $border-radius-md;
      min-height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      
      .generate-storyboard-btn {
        background: linear-gradient(135deg, $color-primary, $color-primary-dark);
        color: white;
        border: none;
        padding: $spacing-sm + $spacing-xs 24px;
        border-radius: $border-radius-md - 2px;
        font-size: $font-size-sm;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        
        &:hover:not(:disabled) {
          transform: translateY(-2px);
          box-shadow: 0 4px 12px rgba($color-primary, $opacity-25);
        }
        
        &:disabled {
          background: $color-gray-400$color-gray-400;
          cursor: not-allowed;
          transform: none;
        }
      }
    }
    
    .storyboard-content {
      position: relative;
      
      .regenerate-storyboard-btn {
        &:disabled {
          opacity: 0.6;
          cursor: not-allowed;
        }
      }
    }
  }
}