  //         height: $spacing-3xl;
  //         margin-left: $spacing-2xl;
  //       }
  //     }
  //   }
  // }
  #header {
    position: absolute;
    left: $spacing-0;
    top: $spacing-0;
    width: 100%;
    .inner {
      max-width: $breakpoint-xl;
      width: 96%;
      margin: $spacing-0 auto;
      padding: $spacing-lg - $spacing-xs 0 0;
      position: Relative;
      &:before {
        content: '';
        display: block;
        width: 123px;
        height: 172px;
        background: url('../images/Home/new/visual-img02.png') no-repeat;
        background-size: cover;
        position: absolute;
        left: -$spacing-6xl * 1.875;
        top: $spacing-6xl * 1.5 + $spacing-sm;
      }
      .logo {
        img {
          width: $spacing-8xl + $spacing-4xl;
          margin-top: $spacing-xs;
        }
      }
      .etc {
        display: flex;
        justify-content: start;
        align-items: center;
        ul {
          li {
            display: inline-block;
            margin-left: $spacing-md - $spacing-2xs;
            width: $spacing-2xl;
            height: $spacing-2xl;
            border-radius: 100%;
            text-indent: -9$color-gray-500px;
            cursor: pointer;
            &:nth-child(1) {
              background: url('../images/Common/yt_icon02.svg') no-repeat;
              background-size: cover;
              background-position: center;
            }
            &:nth-child(2) {
              background: url('../images/Common/insta_icon02.svg') no-repeat;
              background-size: cover;
              background-position: center;
            }
            a {
              display: block;
            }
          }
        }
        button.submit {
          width: $spacing-6xl;
          height: $spacing-3xl;
          margin-left: $spacing-2xl;
          background: $color-primary;
          color: $color-white;
          border: none;
          border-radius: $border-radius-md;
          font-size: $font-size-base;
          font-weight: 600;
          cursor: pointer;
          transition: $transition-base;
          $color-white-space: nowrap;
          &:hover {
            background: $color-info;
            transform: translateY(-$spacing-2xs);
            box-shadow: $shadow;
          }
        }
      }
    }
  }
  #container {
    .visual {
      background: url('../images/Home/new/visual-bg.png') no-repeat;
      background-size: cover;
      padding: $spacing-6xl + $spacing-5xl + $spacing-xs 0 $spacing-6xl + $spacing-xs;
      .inner {
        display: flex;
        justify-content: center;
        align-items: center;
        max-width: 1300px;
        width: 96%;
        margin: $spacing-0 auto;
        gap: $spacing-6xl + $spacing-xs;
        .txt {
          color: $color-white;
          font-size: $font-size-6xl;
          font-weight: 600;
          line-height: $line-height-tight;
          width: 410px;
          span {
            display: inline-block;
            background: $color-vp-blue-1;
            margin-top: $spacing-sm + $spacing-2xs;
            word-break: keep-all;
          }
          p {
            font-size: $font-size-2xl;
            font-weight: 400;
            color: rgba($color-white, 0.8);
            margin-top: $spacing-lg + $spacing-xs + $spacing-2xs;
            line-height: $line-height-base;
          }
        }
        .img {
          width: calc(100% - 510px);
        }
      }
    }

    .textbox {
      background: $color-white;
      text-align: center;
      padding: $spacing-6xl * 1.5 + $spacing-sm 0;
      img {
        width: $spacing-6xl * 4.375;
      }
      div {
        font-weight: bold;
        line-height: $line-height-base;
        font-size: $spacing-2xl;
        margin-top: $spacing-lg + $spacing-xs + $spacing-2xs;
        word-break: keep-all;
      }
      p {
        margin-top: $spacing-lg + $spacing-xs + $spacing-2xs;
        font-size: $font-size-3xl;
        span {
          font-weight: bold;
          color: $color-primary;
          display: inline-block;
        }
      }
    }

    .function {
      background: url('../images/Home/w_bg.png') no-repeat;
      background-size: cover;
      background-position: center;
      padding: $spacing-6xl * 1.5 + $spacing-sm 0 0;
      .inner {
        max-width: 1300px;
        width: 96%;
        margin: $spacing-0 auto;
        h2 {
          span {
            color: $color-primary;
            font-family: 'psb';
            font-size: $spacing-2xl;
            position: relative;
            &:after {
              content: '*';
              display: block;
              color: $color-primary;
              font-size: $spacing-2xl;
              position: absolute;
              left: -$spacing-lg - $spacing-xs;
              top: -$spacing-lg - $spacing-xs;
              font-family: 'pl';
            }
          }
        }
        .content {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-top: $spacing-3xl + $spacing-2xs;
          gap: $spacing-6xl + $spacing-xs;
          .img {
            width: calc(100% - $spacing-6xl * 5.2);
          }
          .txt {
            width: $spacing-6xl * 4 + $spacing-md;
            div {
              font-size: $spacing-2xl;
              color: $color-black;
              font-weight: 600;
              padding-top: $spacing-4xl - $spacing-xs;
              position: Relative;
              span {
                color: $color-primary;
                font-size: $spacing-lg;
                font-weight: 400;
                display: block;
              }
            }
            p {
              color: $color-black;
              font-size: $font-size-lg;
              margin-top: $spacing-lg - $spacing-xs;
              word-break: keep-all;
            }
            .submit {
              margin-top: $spacing-lg + $spacing-xs + $spacing-2xs;
              width: 130px;
              height: $spacing-3xl + $spacing-2xs;
              color: $color-white;
              background: $color-gray-800;
            }
          }
        }
      }
      &.feedback {
        .inner {
          .content {
            .txt {
              div {
                &:before {
                  content: '';
                  display: block;
                  width: $spacing-3xl + $spacing-2xs;
                  height: $spacing-3xl + $spacing-2xs;
                  background: url('../images/Home/new/feedback-img02.png')
                    no-repeat;
                  background-size: cover;
                  position: absolute;
                  left: $spacing-0;
                  top: $spacing-0;
                }
              }
            }
          }
        }
      }
      &.project {
        .inner {
          .content {
            flex-direction: row-reverse;
            .txt {
              div {
                &:before {
                  content: '';
                  display: block;
                  width: $spacing-3xl + $spacing-2xs;
                  height: $spacing-3xl + $spacing-2xs;
                  background: url('../images/Home/new/project-img02.png')
                    no-repeat;
                  background-size: cover;
                  position: absolute;
                  left: $spacing-0;
                  top: $spacing-0;
                }
              }
            }
          }
        }
      }
      &.comment {
        .inner {
          .content {
            .txt {
              div {
                &:before {
                  content: '';
                  display: block;
                  width: $spacing-3xl + $spacing-2xs;
                  height: $spacing-3xl + $spacing-2xs;
                  background: url('../images/Home/new/comment-img02.png')
                    no-repeat;
                  background-size: cover;
                  position: absolute;
                  left: $spacing-0;
                  top: $spacing-0;
                }
              }
            }
          }
        }
      }
      &.contents {
        padding: $spacing-6xl * 1.5 + $spacing-sm 0;
        .inner {
          .content {
            flex-direction: row-reverse;
            .list {
              width: calc(100% - $spacing-6xl * 5.2);
              ul {
                width: 100%;
                display: grid;
                grid-gap: $spacing-lg - $spacing-xs;
                grid-template-columns: repeat(3, 1fr);
                li {
                  height: 220px;
                  padding: $spacing-md - $spacing-2xs;
                  border-radius: $spacing-lg + $spacing-2xs;
                  position: Relative;
                  overflow: hidden;
                  &:nth-child(1) {
                    background: url('../images/Home/img02.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  &:nth-child(2) {
                    background: url('../images/Home/img03.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  &:nth-child(3) {
                    background: url('../images/Home/img05.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  &:nth-child(4) {
                    background: url('../images/Home/img04.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  &:nth-child(5) {
                    background: url('../images/Home/img06.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  &:nth-child(6) {
                    background: url('../images/Home/img07.png') no-repeat;
                    background-size: cover;
                    background-position: center;
                  }
                  .mask {
                    position: absolute;
                    left: $spacing-0;
                    top: $spacing-0;
                    width: 100%;
                    height: 100%;
                    background: rgba($color-black, 0.6);
                  }
                  .text {
                    color: $color-white;
                    font-size: $font-size-xl;
                    position: relative;
                    z-index: $z-index-base;
                    font-weight: 600;
                  }
                }
              }
            }
            .txt {
              div {
                &:before {
                  content: '';
                  display: block;
                  width: $spacing-3xl + $spacing-2xs;
                  height: $spacing-3xl + $spacing-2xs;
                  /* background: url('../images/Home/new/contents-img.png')
                    no-repeat;
                  background-size: cover; */
                  position: absolute;
                  left: $spacing-0;
                  top: $spacing-0;
                }
              }
            }
          }
        }
      }
    }

    .identity {
      background: $color-gray-100;
      padding: $spacing-6xl * 1.5 + $spacing-sm 0;
      .inner {
        max-width: $breakpoint-xl;
        width: 96%;
        margin: $spacing-0 auto;
        h2 {
          span {
            font-family: 'psb';
            font-size: $spacing-2xl;
            color: $color-black;
            position: relative;
            &:after {
              content: '*';
              display: block;
              color: $color-black;
              font-size: $spacing-2xl;
              position: absolute;
              right: -$spacing-lg - $spacing-xs;
              top: -$spacing-lg - $spacing-xs;
              font-family: 'pl';
            }
          }
        }
        ul {
          margin-top: $spacing-4xl + $spacing-xs + $spacing-2xs;
          display: grid;
          grid-gap: $spacing-lg - $spacing-xs;
          grid-template-columns: repeat(4, 1fr);
          width: 100%;
          li {
            .img {
              width: $spacing-6xl * 2.5;
              height: $spacing-6xl * 2 + $spacing-sm;
              border-radius: $spacing-lg - $spacing-xs;
              margin: $spacing-0 auto;
              box-shadow: $font-size-base $font-size-xs $font-size-base rgba($color-black, 0.2);
              background: $color-vp-blue-3;
              display: flex;
              justify-content: center;
              align-items: center;
              img {
                width: $spacing-6xl + $spacing-lg;
              }
            }
            .txt {
              color: $color-vp-gray-dark;
              font-size: $font-size-2xl;
              font-weight: 600;
              line-height: $line-height-tight;
              margin-top: $spacing-xl;
              text-align: center;
            }
          }
        }
      }
    }

    .background {
      background: url('../images/Home/w_bg.png') no-repeat;
      background-size: cover;
      background-position: center;
      padding: $spacing-6xl * 1.5 + $spacing-sm 0;
      .inner {
        max-width: $breakpoint-xl;
        width: 96%;
        margin: $spacing-0 auto;
        h2 {
          span {
            font-family: 'psb';
            font-size: $spacing-2xl;
            position: relative;
            &:after {
              content: '*';
              display: block;
              color: $color-black;
              font-size: $spacing-2xl;
              position: absolute;
              right: -$spacing-lg - $spacing-xs;
              top: -$spacing-lg - $spacing-xs;
              font-family: 'pl';
            }
          }
        }
        .group {
          justify-content: space-between;
          display: flex;
          margin-top: $spacing-6xl + $spacing-xs;
          .txt_box {
            font-size: $font-size-3xl;
            line-height: $line-height-base;
            word-break: keep-all;
            span {
              display: block;
              font-family: 'psb';
              font-size: $font-size-xl;
              word-break: keep-all;
              margin-bottom: $spacing-sm + $spacing-2xs;
            }
            b {
              font-weight: bold;
              color: $color-primary;
              display: block;
              word-break: keep-all;
              margin-top: $spacing-sm + $spacing-2xs;
            }
          }
          .ex {
            .part {
              .img {
                position: relative;
                width: 110px;
                height: 110px;
                &:before {
                  content: '';
                  display: block;
                  width: 110px;
                  height: 110px;
                  border-radius: 100%;
                  position: absolute;
                  left: $spacing-0;
                  top: $spacing-0;
                  background: $color-primary;
                }
                img {
                  height: 130px;
                  position: absolute;
                  left: 50%;
                  transform: translateX(-50%);
                  top: -$spacing-lg;
                  max-width: initial;
                  &.img01 {
                    height: $spacing-6xl + $spacing-lg;
                  }
                  &.img02 {
                    height: $spacing-6xl + $spacing-lg;
                  }
                }
              }
              .text {
                background: $color-white;
                padding: $spacing-lg + $spacing-xs + $spacing-2xs;
                box-shadow: $spacing-sm $spacing-sm $font-size-xs $color-gray-200;
                margin-top: -$spacing-lg - $spacing-xs;
                width: calc(100% - $spacing-6xl * 1.5625);
                div {
                  span {
                    background: $color-primary;
                    display: inline-block;
                    border-radius: $border-radius-lg - $border-radius-sm / 2;
                    padding: $spacing-xs $spacing-sm;
                    font-size: $font-size-sm;
                    color: $color-white;
                    img {
                      height: $spacing-md - $spacing-2xs;
                      vertical-align: middle;
                      margin: -$spacing-2xs $spacing-xs 0 0;
                    }
                  }
                }
                p {
                  font-size: $font-size-xl;
                  margin-top: $spacing-sm + $spacing-2xs;
                }
              }
              &:nth-child(1) {
                .text {
                  border-radius: $spacing-lg - $spacing-xs $border-radius-xl + $spacing-xs $border-radius-xl + $spacing-xs 0;
                  margin-left: $spacing-2xl;
                }
              }
              &:nth-child(2) {
                .text {
                  border-radius: $spacing-lg - $spacing-xs $border-radius-xl + $spacing-xs 0 $border-radius-xl + $spacing-xs;
                  margin-right: $spacing-2xl;
                }
              }
            }
          }
        }
      }
    }

    .video {
      background: $color-info-dark;
      padding: $spacing-6xl + $spacing-xs 0;
      .inner {
        max-width: $breakpoint-xl;
        width: 96%;
        margin: $spacing-0 auto;
        h2 {
          margin-bottom: $spacing-3xl + $spacing-2xs;
          span {
            font-family: 'psb';
            font-size: $spacing-2xl;
            position: relative;
            color: $color-white;
            display: inline-block;
            &:after {
              content: '*';
              display: block;
              color: $color-white;
              font-size: $spacing-2xl;
              position: absolute;
              left: -$spacing-xs + $spacing-2xs;
              top: -$spacing-lg - $spacing-xs;
              font-family: 'pl';
            }
            br {
              display: none;
            }
          }
        }
        .video-wrap {
          position: relative;
          padding-bottom: 56.25%;
          iframe {
            position: absolute;
            top: $spacing-0;
            left: $spacing-0;
            right: $spacing-0;
            bottom: $spacing-0;
            width: 100%;
            height: 100%;
          }
        }
      }
    }

    .end {
      background: url('../images/Home/new/end-bg.png') no-repeat;
      background-size: cover;
      padding: $spacing-5xl 0 $spacing-xl - $spacing-2xs;
      .inner {
        display: flex;
        justify-content: center;
        align-items: center;
        .txt {
          color: $color-white;
          font-size: $font-size-6xl;
          font-weight: 600;
          line-height: $line-height-tight;
          margin-right: $spacing-6xl + $spacing-xs;
          span {
            display: inline-block;
            background: $color-vp-blue-1;
            margin-top: $spacing-sm + $spacing-2xs;
          }
        }
      }
      .ment {
        color: $color-white;
        font-size: $spacing-lg - $spacing-2xs;
        font-family: 'pr';
        text-align: center;
        margin-top: $spacing-5xl;
        img {
          width: $spacing-lg;
          vertical-align: middle;
          margin: -$spacing-2xs $spacing-sm + $spacing-2xs 0 0;
        }
      }
    }

