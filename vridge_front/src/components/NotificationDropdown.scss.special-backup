@import '../styles/design-tokens';

.notification-dropdown {
  position: relative;
  display: inline-block;

  .notification-button {
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    padding: $spacing-sm;
    border-radius: $border-radius-full;
    color: #6c757d;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;

    &:hover {
      background: rgba($color-primary, 0.1);
      color: $color-primary;
    }

    &.has-unread {
      color: $color-primary;
      
      svg {
        animation: bell-ring 2s ease-in-out infinite;
      }
    }

    .notification-badge {
      position: absolute;
      top: $spacing-0;
      right: $spacing-0;
      background: $color-danger;
      color: white;
      border-radius: $border-radius-lg - 2px;
      padding: 2px 6px;
      font-size: 10px;
      font-weight: 600;
      min-width: $spacing-md + 2px;
      height: $spacing-md + 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid white;
      animation: badge-pulse 2s infinite;
    }
  }

  .notification-dropdown-menu {
    position: absolute;
    top: calc(100% + $spacing-sm);
    right: $spacing-0;
    background: white;
    border-radius: $border-radius-lg;
    box-shadow: 0 10px 40px rgba($color-black, 0.15);
    width: 380px;
    max-height: 500px;
    overflow: hidden;
    z-index: 1$color-black;
    border: 1px solid #e9ecef;

    .notification-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: $spacing-md 20px;
      border-bottom: 1px solid #f1f3f4;
      background: $color-background-secondary;

      h4 {
        margin: $spacing-0;
        font-size: $font-size-base;
        font-weight: 600;
        color: #212529;
      }

      .mark-all-read {
        background: none;
        border: none;
        color: $color-primary;
        font-size: $font-size-sm;
        font-weight: 500;
        cursor: pointer;
        padding: $spacing-xs 8px;
        border-radius: $border-radius-sm;
        transition: background 0.2s ease;

        &:hover {
          background: rgba($color-primary, 0.1);
        }
      }
    }

    .notification-list {
      max-height: 360px;
      overflow-y: auto;

      .notification-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: $spacing-2xl 20px;
        color: #6c757d;

        .loading-spinner {
          width: $spacing-lg;
          height: $spacing-lg;
          border: 2px solid #f3f3f3;
          border-top: 2px solid $color-primary;
          border-radius: $border-radius-full;
          animation: spin 1s linear infinite;
          margin-bottom: $spacing-sm + $spacing-xs;
        }

        span {
          font-size: $font-size-sm;
        }
      }

      .notification-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: $spacing-2xl 20px;
        color: #6c757d;
        text-align: center;

        .empty-icon {
          font-size: 32px;
          margin-bottom: $spacing-sm + $spacing-xs;
          opacity: 0.5;
        }

        p {
          margin: $spacing-0;
          font-size: $font-size-sm;
        }
      }

      .notification-item {
        display: flex;
        align-items: flex-start;
        padding: $spacing-md 20px;
        border-bottom: 1px solid #f1f3f4;
        cursor: pointer;
        transition: background 0.2s ease;
        position: relative;

        &:hover {
          background: $color-background-secondary;
        }

        &.unread {
          background: rgba($color-primary, 0.02);
          border-left: 3px solid $color-primary;
        }

        &:last-child {
          border-bottom: none;
        }

        .notification-icon {
          font-size: $font-size-xl;
          margin-right: $spacing-sm + $spacing-xs;
          margin-top: 2px;
          flex-shrink: 0;
        }

        .notification-content {
          flex: 1;
          min-width: $spacing-0;

          .notification-title {
            font-size: $font-size-sm;
            font-weight: 600;
            color: #212529;
            margin-bottom: $spacing-xs;
            line-height: 1.3;
          }

          .notification-message {
            font-size: 13px;
            color: #6c757d;
            line-height: 1.4;
            margin-bottom: 6px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
          }

          .notification-time {
            font-size: 11px;
            color: #adb5bd;
          }
        }

        .unread-dot {
          width: $spacing-sm;
          height: $spacing-sm;
          background: $color-primary;
          border-radius: $border-radius-full;
          flex-shrink: 0;
          margin-top: $spacing-sm;
          margin-left: $spacing-sm;
        }
      }
    }

    .notification-footer {
      padding: $spacing-sm + $spacing-xs 20px;
      border-top: 1px solid #f1f3f4;
      background: $color-background-secondary;

      .view-all-notifications {
        width: 100%;
        background: none;
        border: none;
        color: $color-primary;
        font-size: $font-size-sm;
        font-weight: 500;
        cursor: pointer;
        padding: $spacing-sm;
        border-radius: $border-radius-md - 2px;
        transition: background 0.2s ease;

        &:hover {
          background: rgba($color-primary, 0.1);
        }
      }
    }
  }
}

@keyframes bell-ring {
  0%, 50%, 100% { transform: rotate(0deg); }
  10%, 30% { transform: rotate(-15deg); }
  20%, 40% { transform: rotate(15deg); }
}

@keyframes badge-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

// 모바일 반응형
@media (max-width: $breakpoint-md) {
  .notification-dropdown {
    .notification-dropdown-menu {
      width: 90vw;
      max-width: 350px;
      right: -20px;
    }
  }
}