@import '../styles/design-tokens';

// 피드백 페이지 버튼 스타일
// Version: 3.0 - 2024-01-11 인라인 스타일 제거
.feedback-button-container {
  display: flex;
  gap: $spacing-sm + $spacing-xs;
  flex-wrap: wrap;
  align-items: center;
  margin-top: $spacing-lg - $spacing-xs;
}

// 기본 버튼 스타일
.feedback-button {
  display: inline-flex;
  align-items: center;
  gap: $spacing-sm;
  padding: $spacing-sm + 2px 20px;
  border: none;
  border-radius: $border-radius-md;
  font-size: $font-size-sm;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  
  svg {
    width: $spacing-md;
    height: $spacing-md;
  }
  
  &:hover {
    transform: translateY(-2px);
  }
  
  &:active {
    transform: translateY(0);
  }
}

// 파란색 버튼 (기본)
.feedback-button-primary {
  @extend .feedback-button;
  background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
  color: white;
  box-shadow: 0 4px 12px rgba($color-primary, $opacity-25);
  
  &:hover {
    box-shadow: 0 6px 20px rgba($color-primary, 0.4);
  }
}

// 빨간색 버튼 (삭제)
.feedback-button-danger {
  @extend .feedback-button;
  background: linear-gradient(135deg, $color-danger 0%, #c82$color-gray-800 100%);
  color: white;
  box-shadow: 0 4px 12px rgba($color-danger, $opacity-25);
  
  &:hover {
    box-shadow: 0 6px 20px rgba($color-danger, 0.4);
  }
}

// 파일 업로드 레이블 스타일
.feedback-upload-label {
  @extend .feedback-button-primary;
  display: inline-flex;
}

// 업로드 영역 스타일
.feedback-upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: $spacing-lg - $spacing-xs;
  padding: $spacing-4xl - $spacing-xs 40px;
  background: linear-gradient(135deg, $color-background-secondary 0%, #f0f4ff 100%);
  border-radius: 20px;
  border: 2px dashed #c8d4ff;
  position: relative;
  overflow: hidden;
  
  .upload-content {
    position: relative;
    z-index: 1;
  }
}

// 비디오 플레이어 컨테이너
.feedback-video-container {
  position: relative;
  width: 100%;
  max-width: 1200px;
  margin: $spacing-0 auto;
  background-color: $color-black;
  border-radius: $border-radius-lg;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba($color-black, 0.15);
}

// 숨겨진 파일 입력
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: $spacing-0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: $spacing-0;
}

// 업로드 가이드 버튼
.upload-guide-button {
  padding: $spacing-md 32px;
  background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
  color: white;
  border: none;
  border-radius: $border-radius-lg - 2px;
  font-size: $font-size-base;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(108, 117, 125, 0.3);
  
  &:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(108, 117, 125, 0.4);
  }
}

// 대형 업로드 버튼
.feedback-upload-button-large {
  display: inline-block;
  padding: $spacing-lg 48px;
  background: linear-gradient(135deg, $color-primary 0%, $color-primary-dark 100%);
  color: white;
  border: none;
  border-radius: $border-radius-xl;
  font-size: $font-size-lg;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 6px 20px rgba($color-primary, 0.3);
  letter-spacing: 0.5px;
  
  &:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba($color-primary, 0.45);
  }
  
  svg {
    width: $spacing-lg;
    height: $spacing-lg;
    margin-right: $spacing-sm + $spacing-xs;
  }
}

// 공유 버튼 스타일
.feedback-button-secondary {
  @extend .feedback-button;
  background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
  color: white;
  box-shadow: 0 4px 12px rgba(108, 117, 125, 0.25);
  
  &:hover {
    box-shadow: 0 6px 20px rgba(108, 117, 125, 0.4);
  }
}

// 업로드 가이드 버튼 스타일
.feedback-button-outline {
  @extend .feedback-button;
  background: white;
  color: $color-primary;
  border: 2px solid $color-primary;
  
  &:hover {
    background: $color-primary;
    color: white;
    box-shadow: 0 4px 12px rgba($color-primary, 0.3);
  }
}

// 프로젝트 정보 토글 버튼
.feedback-button-toggle {
  display: inline-flex;
  align-items: center;
  gap: $spacing-sm;
  padding: $spacing-sm 16px;
  background: $color-background-secondary;
  color: #495057;
  border: 1px solid #dee2e6;
  border-radius: $border-radius-md - 2px;
  font-size: $font-size-sm;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  
  &:hover {
    background: #e9ecef;
    color: #212529;
  }
  
  &:active {
    background: #dee2e6;
  }
}

// 반응형 디자인
@media (max-width: $breakpoint-md) {
  .feedback-button-container {
    justify-content: center;
  }
  
  .feedback-button {
    font-size: 13px;
    padding: $spacing-sm 16px;
  }
  
  .feedback-upload-area {
    padding: $spacing-2xl 20px;
  }
  
  .feedback-upload-button-large {
    padding: $spacing-lg - $spacing-xs 40px;
    font-size: $font-size-base;
  }
}