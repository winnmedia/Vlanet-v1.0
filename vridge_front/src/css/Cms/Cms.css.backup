}
@media (max-width: 768px) {
  .cms_wrap main .content.calendar .filter.flex {
    flex-direction: column;
    align-items: stretch;
  }
}
.cms_wrap main .content.calendar .filter .date {
  font-size: calc($spacing-lg + $spacing-xs);
  font-weight: 700;
  color: #212529;
  display: flex;
  align-items: center;
  calc($spacing-md + $spacing-xs) 20px;
}
.cms_wrap main .content.calendar .filter .date .move {
  display: flex;
  $spacing-sm: 8px;
}
.cms_wrap main .content.calendar .filter .date .move span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc($spacing-xl + $spacing-xs);
  height: calc($spacing-xl + $spacing-xs);
