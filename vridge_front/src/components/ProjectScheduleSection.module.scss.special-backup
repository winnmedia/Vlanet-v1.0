@import '../styles/design-tokens';

// Project Schedule Section Styles
.project-schedule-section {
  margin-top: $spacing-lg + 6px;
  background: $color-white;
  border-radius: 15px;
  padding: 25px;
  box-shadow: 0 2px 10px rgba($color-black, 0.05);
  
  .schedule-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    
    .section-title {
      font-size: $font-size-xl;
      font-weight: 700;
      color: #2d3436;
      display: flex;
      align-items: center;
      gap: $spacing-sm + 2px;
      margin: $spacing-0;
      
      svg {
        color: $color-primary;
      }
    }
    
    .view-controls {
      display: flex;
      gap: $spacing-sm;
      
      .view-btn {
        padding: $spacing-sm 16px;
        border: 1px solid #e9ecef;
        background: $color-white;
        border-radius: $border-radius-md;
        font-size: $font-size-sm;
        color: #6c757d;
        cursor: pointer;
        transition: all 0.2s;
        
        &:hover {
          background: $color-background-secondary;
        }
        
        &.active {
          background: $color-primary;
          color: $color-white;
          border-color: $color-primary;
        }
      }
    }
  }
  
  // 알림 카드 공통 스타일
  .schedule-alert {
    background: $color-background-secondary;
    border-radius: $border-radius-lg;
    padding: $spacing-lg - $spacing-xs;
    margin-bottom: $spacing-lg - $spacing-xs;
    
    .alert-header {
      display: flex;
      align-items: center;
      gap: $spacing-sm;
      margin-bottom: $spacing-md - 1px;
      
      svg {
        width: $spacing-lg - $spacing-xs;
        height: $spacing-lg - $spacing-xs;
      }
      
      .alert-title {
        font-size: $font-size-base;
        font-weight: 600;
      }
    }
    
    &.overdue-alert {
      background: #fff5f5;
      border: 1px solid #ffe0e0;
      
      .alert-header {
        color: $color-danger;
        
        svg {
          stroke: $color-danger;
        }
      }
    }
    
    &.today-alert {
      background: #e7f1ff;
      border: 1px solid #d0e3ff;
      
      .alert-header {
        color: $color-primary;
        
        svg {
          stroke: $color-primary;
        }
      }
    }
  }
  
  // 마감일 목록
  .deadline-list {
    display: flex;
    flex-direction: column;
    gap: $spacing-sm + $spacing-xs;
    
    .deadline-item {
      background: $color-white;
      border-radius: $border-radius-lg - 2px;
      padding: $spacing-md - 1px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      transition: all 0.2s;
      
      &:hover {
        box-shadow: 0 3px 8px rgba($color-black, 0.08);
        transform: translateY(-1px);
      }
      
      &.overdue {
        border: 1px solid #ffe0e0;
      }
      
      &.today {
        border: 1px solid #d0e3ff;
      }
      
      .deadline-info {
        display: flex;
        align-items: center;
        gap: $spacing-sm + $spacing-xs;
        
        .project-indicator {
          width: $spacing-xs;
          height: $spacing-2xl;
          border-radius: $border-radius-sm / 2;
          flex-shrink: 0;
        }
        
        .deadline-details {
          .project-name {
            font-size: 15px;
            font-weight: 600;
            color: #2d3436;
            margin-bottom: $spacing-xs;
          }
          
          .phase-name {
            font-size: 13px;
            color: #6c757d;
          }
        }
      }
      
      .deadline-status {
        flex-shrink: 0;
        
        .overdue-days {
          color: $color-danger;
          font-weight: 600;
          font-size: $font-size-sm;
        }
        
        .deadline-time {
          color: $color-primary;
          font-weight: 600;
          font-size: $font-size-sm;
        }
      }
    }
  }
  
  // 예정된 일정 섹션
  .upcoming-deadlines {
    .deadlines-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: $spacing-lg - $spacing-xs;
      
      h4 {
        font-size: $font-size-base;
        font-weight: 600;
        color: #2d3436;
        margin: $spacing-0;
      }
      
      .deadline-count {
        font-size: $font-size-sm;
        color: #6c757d;
      }
    }
    
    .deadline-timeline {
      .deadline-item {
        display: flex;
        align-items: center;
        gap: $spacing-md - 1px;
        padding: $spacing-md - 1px;
        background: $color-background-secondary;
        border-radius: $border-radius-lg - 2px;
        margin-bottom: $spacing-sm + $spacing-xs;
        cursor: pointer;
        transition: all 0.2s;
        
        &:hover {
          background: #e9ecef;
          transform: translateX(4px);
        }
        
        &.urgent {
          background: #fff9e6;
          border: 1px solid #ffe4b3;
        }
        
        &.tomorrow {
          background: #f0f8ff;
          border: 1px solid #d6e9ff;
        }
        
        .deadline-date {
          background: $color-white;
          border-radius: $border-radius-md;
          padding: $spacing-sm + 2px;
          text-align: center;
          min-width: $spacing-4xl - $spacing-xs;
          border: 1px solid #e9ecef;
          
          .date-day {
            font-size: $font-size-xl;
            font-weight: 700;
            color: #2d3436;
            line-height: 1;
          }
          
          .date-month {
            font-size: $font-size-xs;
            color: #6c757d;
            text-transform: uppercase;
            margin-top: $spacing-xs;
          }
        }
        
        .deadline-info {
          flex: 1;
          display: flex;
          align-items: center;
          gap: $spacing-sm + $spacing-xs;
          
          .project-indicator {
            width: $spacing-xs;
            height: $spacing-2xl;
            border-radius: $border-radius-sm / 2;
            flex-shrink: 0;
          }
          
          .deadline-details {
            .project-name {
              font-size: 15px;
              font-weight: 600;
              color: #2d3436;
              margin-bottom: $spacing-xs;
            }
            
            .phase-name {
              font-size: 13px;
              color: #6c757d;
            }
          }
        }
        
        .deadline-status {
          .status-badge {
            padding: $spacing-xs 12px;
            border-radius: 20px;
            font-size: $font-size-xs;
            font-weight: 600;
            
            &.today {
              background: $color-primary;
              color: $color-white;
            }
            
            &.tomorrow {
              background: $color-info;
              color: $color-white;
            }
            
            &.urgent {
              background: $color-warning;
              color: #856404;
            }
          }
          
          .days-remaining {
            font-size: $font-size-sm;
            font-weight: 600;
            color: #6c757d;
          }
        }
      }
      
      .no-deadlines {
        text-align: center;
        padding: $spacing-4xl - $spacing-xs 20px;
        color: #adb5bd;
        
        svg {
          stroke: #dee2e6;
          margin-bottom: $spacing-md - 1px;
        }
        
        p {
          font-size: $font-size-sm;
          margin: $spacing-0;
        }
      }
    }
    
    .view-all-link {
      text-align: center;
      margin-top: $spacing-lg - $spacing-xs;
      
      a {
        color: $color-primary;
        text-decoration: none;
        font-size: $font-size-sm;
        font-weight: 600;
        
        &:hover {
          text-decoration: underline;
        }
      }
    }
  }
}

// 반응형 디자인
@media (max-width: $breakpoint-md) {
  .project-schedule-section {
    padding: $spacing-lg - $spacing-xs;
    
    .schedule-header {
      flex-direction: column;
      gap: $spacing-md - 1px;
      align-items: flex-start;
      
      .view-controls {
        width: 100%;
        
        .view-btn {
          flex: 1;
        }
      }
    }
    
    .deadline-item {
      .deadline-date {
        min-width: $spacing-3xl + 2px;
        padding: $spacing-sm;
        
        .date-day {
          font-size: $font-size-lg;
        }
      }
    }
  }
}