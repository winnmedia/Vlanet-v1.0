{
  "name": "videoplanet-frontend",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "regions": ["icn1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://videoplanet.up.railway.app",
    "NEXT_PUBLIC_VERSION": "1.0.0"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "https://videoplanet.up.railway.app",
      "NEXT_PUBLIC_VERSION": "1.0.0",
      "NODE_ENV": "production"
    }
  },
  "functions": {
    "pages/api/**.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/home",
      "destination": "/cmshome",
      "permanent": true
    }
  ],
  "github": {
    "enabled": true,
    "autoAlias": ["videoplanet.vercel.app"]
  }
}