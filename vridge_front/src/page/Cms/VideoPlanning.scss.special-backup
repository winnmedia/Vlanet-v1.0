          font-weight: 600;
          color: $color-gray-800;
          margin-bottom: $spacing-sm;
        }

        .story-stage {
          font-size: 13px;
          color: $color-primary;
          background: #f0f4ff;
          padding: $spacing-xs 8px;
          border-radius: $border-radius-sm;
          display: inline-block;
          margin-bottom: $spacing-sm + $spacing-xs;
        }

        .view-detail-btn {
          background: $color-primary;
          color: white;
          border: none;
          padding: 6px 12px;
          border-radius: $border-radius-md - 2px;
          font-size: $font-size-xs;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.2s ease;
          display: inline-flex;
          align-items: center;
          gap: $spacing-xs;
          width: $spacing-5xl;
          height: $spacing-lg + $spacing-xs;
          justify-content: center;

