// VideoPlanet CMS 홈 페이지 통합 스타일
// CmsHomeEnhanced, CmsHomeFix, CmsHomeMinimal 통합

@use '../../tokens' as *;

// ========== CMS 홈 레이아웃 ==========

.cmsHome {
  display: flex;
  min-height: 100vh;
  background: $color-background;
  
  // 메인 콘텐츠 영역
  .mainContent {
    flex: 1;
    padding: $spacing-xl;
    
    @media (max-width: $breakpoint-lg) {
      padding: $spacing-lg;
    }
    
    @media (max-width: $breakpoint-md) {
      padding: $spacing-md;
    }
  }
}

// ========== 헤더 섹션 ==========

.pageHeader {
  margin-bottom: $spacing-xl;
  
  .pageTitle {
    font-size: $font-size-2xl;
    font-weight: 700;
    color: $color-text-primary;
    margin-bottom: $spacing-sm;
    letter-spacing: -0.5px;
  }
  
  .pageSubtitle {
    font-size: $font-size-base;
    color: $color-text-secondary;
    line-height: 1.5;
  }
}

// ========== 프로젝트 리스트 섹션 ==========

.projectsSection {
  background: $color-white;
  border-radius: $radius-lg;
  padding: $spacing-xl;
  box-shadow: $shadow-default;
  margin-bottom: $spacing-xl;
}

.sectionHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: $spacing-lg;
  padding-bottom: $spacing-md;
  border-bottom: 1px solid $color-border-light;
  
  @media (max-width: $breakpoint-sm) {
    flex-direction: column;
    gap: $spacing-md;
    align-items: stretch;
  }
  
  .sectionTitle {
    font-size: $font-size-lg;
    font-weight: 600;
    color: $color-text-primary;
    margin: 0;
  }
}

// ========== 필터 버튼 ==========

.filterButtons {
  display: flex;
  gap: $spacing-xs;
  
  @media (max-width: $breakpoint-sm) {
    width: 100%;
    justify-content: stretch;
  }
  
  .filterButton {
    padding: $spacing-sm $spacing-md;
    background: $color-white;
    color: $color-text-secondary;
    border: 1px solid $color-border-light;
    border-radius: $radius-md;
    font-size: $font-size-sm;
    font-weight: 500;
    cursor: pointer;
    transition: all $transition-fast;
    white-space: nowrap;
    
    @media (max-width: $breakpoint-sm) {
      flex: 1;
      text-align: center;
    }
    
    &:hover {
      background: $color-gray-50;
      border-color: $color-gray-300;
    }
    
    &.active {
      background: $color-gray-900;
      color: $color-white;
      border-color: $color-gray-900;
      
      &:hover {
        background: $color-gray-800;
        border-color: $color-gray-800;
      }
    }
    
    .count {
      display: inline-block;
      margin-left: $spacing-xs;
      padding: 2px 6px;
      background: rgba(0, 0, 0, 0.1);
      border-radius: $radius-full;
      font-size: $font-size-xs;
      min-width: 20px;
      text-align: center;
    }
    
    &.active .count {
      background: rgba(255, 255, 255, 0.2);
    }
  }
}

// ========== 프로젝트 그리드 ==========

.projectGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: $spacing-lg;
  
  @media (max-width: $breakpoint-md) {
    grid-template-columns: 1fr;
    gap: $spacing-md;
  }
}

// ========== 프로젝트 카드 ==========

.projectCard {
  background: $color-white;
  border: 1px solid $color-border-light;
  border-radius: $radius-lg;
  padding: $spacing-lg;
  cursor: pointer;
  transition: all $transition-fast;
  position: relative;
  
  &:hover {
    border-color: $color-primary;
    transform: translateY(-2px);
    box-shadow: $shadow-hover;
  }
  
  &.expanded {
    box-shadow: $shadow-lg;
  }
}

.projectHeader {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: $spacing-md;
  gap: $spacing-sm;
  
  .projectTitleRow {
    flex: 1;
    min-width: 0;
  }
  
  .projectTitle {
    font-size: $font-size-lg;
    font-weight: 600;
    color: $color-text-primary;
    margin: 0 0 $spacing-xs 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    
    &:hover {
      color: $color-primary;
    }
  }
  
  .projectMeta {
    display: flex;
    align-items: center;
    gap: $spacing-md;
    font-size: $font-size-sm;
    color: $color-text-secondary;
    
    .updateTime {
      display: flex;
      align-items: center;
      gap: $spacing-xs;
      
      svg {
        width: 14px;
        height: 14px;
        opacity: 0.6;
      }
    }
  }
  
  .toggleButton {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: $color-gray-100;
    border: 2px solid $color-border-light;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all $transition-fast;
    padding: 0;
    
    &:hover {
      background: $color-gray-200;
      border-color: $color-gray-300;
      transform: rotate(180deg);
    }
    
    svg {
      width: 16px;
      height: 16px;
      color: $color-text-secondary;
      transition: transform $transition-fast;
    }
    
    &.expanded svg {
      transform: rotate(180deg);
    }
  }
}

.projectStatus {
  display: inline-block;
  padding: $spacing-xs $spacing-sm;
  border-radius: $radius-full;
  font-size: $font-size-xs;
  font-weight: 500;
  
  &.active {
    background: $color-success-light;
    color: $color-success;
  }
  
  &.delayed {
    background: $color-warning-light;
    color: $color-warning;
  }
  
  &.completed {
    background: $color-info-light;
    color: $color-info;
  }
}

.projectInfo {
  margin-top: $spacing-md;
  
  .infoRow {
    display: flex;
    align-items: center;
    gap: $spacing-sm;
    margin-bottom: $spacing-sm;
    font-size: $font-size-sm;
    color: $color-text-secondary;
    
    svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      opacity: 0.6;
    }
    
    span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
}

// 프로젝트 확장 정보
.projectDetails {
  max-height: 0;
  overflow: hidden;
  transition: max-height $transition-slow ease-out;
  
  &.expanded {
    max-height: 500px;
    transition: max-height $transition-slow ease-in;
  }
}

.detailsContent {
  padding-top: $spacing-md;
  border-top: 1px solid $color-border-light;
  margin-top: $spacing-md;
  
  .detailSection {
    margin-bottom: $spacing-md;
    
    &:last-child {
      margin-bottom: 0;
    }
    
    .detailLabel {
      font-size: $font-size-xs;
      font-weight: 600;
      color: $color-text-muted;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: $spacing-xs;
    }
    
    .detailValue {
      font-size: $font-size-sm;
      color: $color-text-secondary;
      line-height: 1.5;
    }
  }
  
  .membersList {
    display: flex;
    flex-wrap: wrap;
    gap: $spacing-xs;
    
    .memberItem {
      display: flex;
      align-items: center;
      gap: $spacing-xs;
      padding: $spacing-xs $spacing-sm;
      background: $color-gray-100;
      border-radius: $radius-full;
      font-size: $font-size-xs;
      
      .memberAvatar {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: $color-primary;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 600;
      }
      
      .memberName {
        color: $color-text-secondary;
      }
      
      .memberRole {
        color: $color-text-muted;
        font-size: 10px;
        padding: 1px 4px;
        background: $color-white;
        border-radius: $radius-xs;
      }
    }
  }
}

// ========== 빈 상태 ==========

.emptyState {
  text-align: center;
  padding: $spacing-3xl $spacing-lg;
  
  .emptyIcon {
    width: 80px;
    height: 80px;
    margin: 0 auto $spacing-lg;
    opacity: 0.3;
  }
  
  .emptyTitle {
    font-size: $font-size-lg;
    color: $color-text-secondary;
    margin-bottom: $spacing-sm;
  }
  
  .emptyText {
    color: $color-text-muted;
    margin-bottom: $spacing-lg;
  }
  
  .createButton {
    display: inline-flex;
    align-items: center;
    gap: $spacing-xs;
    padding: $spacing-sm $spacing-lg;
    background: linear-gradient(135deg, $color-primary 0%, $color-primary-hover 100%);
    color: white;
    border: none;
    border-radius: $radius-md;
    font-size: $font-size-base;
    font-weight: 600;
    cursor: pointer;
    transition: all $transition-button;
    
    &:hover {
      transform: translateY(-2px);
      box-shadow: $shadow-button-hover;
    }
    
    svg {
      width: 20px;
      height: 20px;
    }
  }
}

// ========== 로딩 상태 ==========

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400px;
  color: $color-text-muted;
  font-size: $font-size-base;
}

// ========== 프로젝트 생성 섹션 ==========

.createProjectSection {
  background: linear-gradient(135deg, #f8f9ff 0%, #f1f3ff 100%);
  border: 2px dashed $color-primary-light;
  border-radius: $radius-lg;
  padding: $spacing-2xl;
  text-align: center;
  margin-bottom: $spacing-xl;
  transition: all $transition-fast;
  cursor: pointer;
  
  &:hover {
    border-style: solid;
    background: linear-gradient(135deg, #f1f3ff 0%, #e8ebff 100%);
    transform: translateY(-2px);
    box-shadow: $shadow-hover;
  }
  
  .createIcon {
    width: 60px;
    height: 60px;
    margin: 0 auto $spacing-lg;
    background: linear-gradient(135deg, $color-primary 0%, $color-primary-hover 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 24px;
    box-shadow: $shadow-button;
  }
  
  h2 {
    font-size: $font-size-lg;
    margin-bottom: $spacing-sm;
    color: $color-text-primary;
  }
  
  p {
    color: $color-text-secondary;
    margin-bottom: $spacing-lg;
  }
}