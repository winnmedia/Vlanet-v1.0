      .last {
        background: url('../images/Home/bg07.png'),
          url('../images/Home/bg08.png');
        background-size: 400px, cover;
        background-position: left 0 bottom 0, 0px 0px;
        background-repeat: no-repeat;
        height: 540px;
        position: relative;
        padding: $spacing-3xl + 2px 10px 0;
        div {
          position: initial;
          top: initial;
          right: initial;
          font-size: $font-size-3xl;
          font-weight: bold;
          text-align: center;
          color: $color-white;
          line-height: 1.3;
          span {
            display: block;
            color: #0059db;
            text-align: center;
          }
        }
        p {
          position: initial;
          bottom: initial;
          right: initial;
          color: $color-white;
          font-size: $font-size-sm;
          line-height: 1.7;
          margin-top: $spacing-lg + 6px;
          text-align: center;
        }
      }
    }
    #footer {
      background: #1a1a1a;
      padding: $spacing-3xl + 2px 20px;
      .inner {
        max-width: 1200px;
        margin: $spacing-0 auto;
        display: block;
        > div {
          .logo {
            color: #0632f5;
            font-size: 22px;
            font-weight: bold;
            margin-top: $spacing-0;
          }
          ul {
            margin-top: $spacing-lg + 6px;
            li {
              color: $color-white;
              margin-top: 6px;
              font-size: 13px;
            }
          }
          div {
            margin-top: $spacing-lg + 6px;
            span {
              display: inline-block;
              background: $color-white;
              padding: $spacing-xs 8px;
              margin-right: $spacing-sm + 2px;
              border-radius: $border-radius-lg - 2px;
              font-size: $font-size-sm;
            }
          }
        }
        > ul {
          margin-top: $spacing-lg + 6px;
          li {
            display: inline-block;
            margin-left: $spacing-0;
            margin-right: $spacing-sm + 2px;
            width: $spacing-2xl;
            height: $spacing-2xl;
            border-radius: 100%;
            text-indent: -9$color-gray-500px;
            cursor: pointer;
            &:nth-child(1) {
              background: $color-white url('../images/Common/yt_icon.svg') no-repeat;
              background-size: 22px;
              background-position: center;
            }
            &:nth-child(2) {
              background: $color-white url('../images/Common/insta_icon.svg') no-repeat;
              background-size: 20px;
              background-position: center;
            }
          }
        }
      }
    }
  }
  
  // 반응형 스타일
  @media (min-width: 769px) and (max-width: $breakpoint-lg) {
    #header {
      .inner {
        .etc {
          button.submit {
            display: block !important;
          }
        }
      }
    }
  }
  
  @media (max-width: $breakpoint-md) {
    #header {
      .inner {
        padding: $spacing-md - 1px 20px;
        
        .logo {
          img {
            width: 100px;
          }
        }
        
        .etc {
          display: flex !important;
          align-items: center;
          
          ul {
            li {
              width: 35px;
              height: 35px;
              margin-left: $spacing-sm + 2px;
            }
          }
          
          button.submit {
            display: block !important;
            width: 70px;
            height: $spacing-2xl;
            margin-left: $spacing-md - 1px;
            font-size: $font-size-sm;
            flex-shrink: 0;
          }
        }
      }
    }
  }
  
  @media (max-width: 480px) {
    #header {
      .inner {
        .etc {
          ul {
            display: none; // 작은 화면에서는 SNS 아이콘 숨김
          }
          
          button.submit {
            display: block !important;
            margin-left: $spacing-0;
          }
        }
      }
    }
  }
}
