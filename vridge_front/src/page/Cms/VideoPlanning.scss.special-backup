          font-size: $font-size-lg;
          font-weight: 600;
          color: #1a1a1a;
          margin: $spacing-0;
          display: flex;
          align-items: center;
          gap: $spacing-sm;

          &::before {
            content: '';
            width: 6px;
            height: 6px;
            background: $color-primary;
            border-radius: $border-radius-full;
          }
        }

        .toggle-detail-btn {
          background: #f0f4ff;
          color: $color-primary;
          border: none;
          padding: $spacing-xs 8px;
          border-radius: $border-radius-sm;
          font-size: $font-size-xs;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.2s ease;
          display: flex;
          align-items: center;
          gap: 2px;
          width: $spacing-4xl - $spacing-xs;
          height: $spacing-lg;
          justify-content: center;

          &:hover {
            background: #e0ebff;
          }

          &:active {
            transform: scale(0.95);
          }
